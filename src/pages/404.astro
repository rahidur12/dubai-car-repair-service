---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Page Not Found | Dubai Car Repair Service";
const pageDescription = "The page you are looking for cannot be found. Return to the Dubai Car Repair Service homepage or contact our team directly.";

const phoneDisplay = "+971 56 612 1423";
const phoneHref = "tel:+971566121423";
const waHref = "https://api.whatsapp.com/send?phone=971566121423";
---

<BaseLayout
    title={pageTitle}
    description={pageDescription}
    noindex={true}
>
    <main class="notfound-page">
        <div class="notfound-container">
            <span class="notfound-code">404</span>
            <h1 class="notfound-title">Page Not Found</h1>
            <p class="notfound-lead">
                The page you are looking for may have been moved, renamed, or is temporarily unavailable. 
            </p>

            <div class="notfound-actions">
                <a href="/" class="notfound-btn notfound-btn--primary">Return to Homepage</a>
                <a href={phoneHref} class="notfound-btn notfound-btn--secondary">Call {phoneDisplay}</a>
            </div>

            <div class="notfound-links">
                <p>Popular Services:</p>
                <ul>
                    <li><a href="/car-battery-replacement-dubai">Battery Replacement</a></li>
                    <li><a href="/car-ac-repair-dubai">AC Repair</a></li>
                    <li><a href="/tyre-replacement-dubai">Tyre Change</a></li>
                    <li><a href="/engine-oil-change-dubai">Oil Change</a></li>
                    <li><a href="/mobile-car-repair-dubai">Mobile Mechanic</a></li>
                </ul>
            </div>
        </div>
    </main>
</BaseLayout>

<style>
    .notfound-page {
        --ink: #10201F;
        --brass: #C1802E;
        --white: #FFFFFF;
        --paper-light: #F4F1EA;
        background: var(--paper-light);
        min-height: 60vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 4rem 1.5rem;
        text-align: center;
        font-family: "Inter", sans-serif;
    }

    .notfound-container {
        max-width: 600px;
        margin: 0 auto;
        background: var(--white);
        padding: 3rem 2rem;
        border-radius: 8px;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
        border: 1px solid rgba(16, 32, 31, 0.1);
    }

    .notfound-code {
        display: inline-block;
        font-family: "IBM Plex Mono", monospace;
        font-size: 3.5rem;
        font-weight: 700;
        color: var(--brass);
        line-height: 1;
        margin-bottom: 0.5rem;
    }

    .notfound-title {
        font-family: "Fraunces", Georgia, serif;
        font-size: 2rem;
        color: var(--ink);
        margin: 0 0 1rem;
    }

    .notfound-lead {
        color: #4A5B5A;
        font-size: 1rem;
        line-height: 1.6;
        margin-bottom: 2rem;
    }

    .notfound-actions {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
        margin-bottom: 2.5rem;
    }

    .notfound-btn {
        padding: 0.75rem 1.5rem;
        border-radius: 4px;
        font-weight: 600;
        text-decoration: none;
        font-size: 0.95rem;
        transition: all 0.2s;
    }

    .notfound-btn--primary {
        background: var(--ink);
        color: #FBF9F4;
    }

    .notfound-btn--primary:hover {
        background: var(--brass);
        color: var(--ink);
    }

    .notfound-btn--secondary {
        background: var(--brass);
        color: var(--ink);
    }

    .notfound-btn--secondary:hover {
        background: #D89438;
    }

    .notfound-links {
        border-top: 1px solid rgba(16, 32, 31, 0.1);
        padding-top: 1.5rem;
    }

    .notfound-links p {
        font-size: 0.85rem;
        text-transform: uppercase;
        font-family: "IBM Plex Mono", monospace;
        color: #6C7E7D;
        margin-bottom: 0.75rem;
    }

    .notfound-links ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1rem;
        justify-content: center;
    }

    .notfound-links a {
        color: var(--ink);
        font-size: 0.9rem;
        text-decoration: underline;
    }

    .notfound-links a:hover {
        color: var(--brass);
    }
</style>

