const phoneDisplay = "+971 56 612 1423";
const phoneHref = "tel:+971566121423";
const waHref = "https://api.whatsapp.com/send?phone=971566121423";
---

<BaseLayout title={pageTitle} description={pageDescription}>

<!-- Page-level JSON-LD (LocalBusiness + FAQ) -->
<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<div class="dcrs">

    <!-- 1. Hero ------------------------------------------------------------->
    <section class="dcrs-hero">
        <div class="dcrs-hero__bg" style="background-image:url('/src/assets/images/hero1.webp')"></div>
        <div class="dcrs-hero__scrim"></div>
        <div class="dcrs-container dcrs-hero__inner">
            <div class="dcrs-hero__copy">
                <p class="dcrs-hero__kicker">222 Al Satwa Road · Independent Auto Workshop · Est. 2012</p>
                <h1 class="dcrs-hero__title">
                    Dubai Car Repair Service — Fast, Honest & Complete Vehicle Repairs
                </h1>
                <p class="dcrs-hero__lead">
                    Dubai's most-searched car repair service, trusted by 8,500+ drivers. Our Al Satwa workshop handles everything from a quick oil change to a full engine overhaul. Need help now? Call or WhatsApp — we're open 7 AM to 10 PM, every day.
                </p>

                <div class="dcrs-hero__actions">
                    <a href={phoneHref} class="dcrs-btn dcrs-btn--solid">
                        <Fragment set:html={icons.phone} /> Call {phoneDisplay}
                    </a>
                    <a href={waHref} class="dcrs-btn dcrs-btn--outline">
                        <Fragment set:html={icons.chat} /> WhatsApp us
                    </a>
                    <a href="#services" class="dcrs-btn dcrs-btn--ghost">See all services</a>
                </div>
            </div>

            <div class="dcrs-plate" aria-hidden="true">
                <div class="dcrs-plate__tab">DXB</div>
                <div class="dcrs-plate__body">
                    <span class="dcrs-plate__row dcrs-plate__row--big">12+ YRS</span>
                    <span class="dcrs-plate__row">8,500+ VEHICLES</span>
                    <span class="dcrs-plate__row">4.8 ★ GOOGLE RATING</span>
                    <span class="dcrs-plate__row">SAT–FRI · 7AM–10PM</span>
                </div>
            </div>
        </div>
    </section>

    <!-- 2. Value propositions ---------------------------------------------->
    <section class="dcrs-section dcrs-section--paper">
        <div class="dcrs-container">
            <ul class="dcrs-features">
                {features.map((item) => (
                    <li class={`dcrs-features__item ${item.highlighted ? 'is-highlighted' : ''}`}>
                        <span class="dcrs-icon"><Fragment set:html={icons[item.icon]} /></span>
                        <h2 class="dcrs-features__title">{item.title}</h2>
                        <p class="dcrs-features__desc">{item.description}</p>
                    </li>
                ))}
            </ul>
        </div>
    </section>

    <!-- 3. Services grid --------------------------------------------------->
    <section class="dcrs-section dcrs-section--tint" id="services">
        <div class="dcrs-container">
            <div class="dcrs-heading">
                <h2 class="dcrs-heading__title">Complete car repair & vehicle maintenance services in Dubai</h2>
                <p class="dcrs-heading__sub">From routine servicing to advanced mechanical overhauls — our mechanics cover every make and model. Prices from AED 50. Written estimate before we start.</p>
            </div>

            <div class="dcrs-services">
                {services.map((service) => (
                    <article class="dcrs-ticket">
                        <div class="dcrs-ticket__media">
                            <img src={service.image} alt={service.alt} loading="lazy" width="480" height="320" />
                        </div>
                        <div class="dcrs-ticket__body">
                            <span class="dcrs-icon dcrs-icon--sm"><Fragment set:html={icons[service.icon]} /></span>
                            <h3 class="dcrs-ticket__title">{service.title}</h3>
                            <ul class="dcrs-ticket__list">
                                <li><Fragment set:html={icons.check} />{service.bullet1}</li>
                                <li><Fragment set:html={icons.check} />{service.bullet2}</li>
                                <li><Fragment set:html={icons.check} />{service.bullet3}</li>
                            </ul>
                            <a href={service.link} class="dcrs-ticket__link">View service details</a>
                            <a href={waHref} class="dcrs-btn dcrs-btn--block">
                                <Fragment set:html={icons.chat} /> Book on WhatsApp
                            </a>
                        </div>
                    </article>
                ))}
            </div>

            <!-- Additional services row -->
            <div class="dcrs-more-services">
                <h3 class="dcrs-more-services__title">More services we offer</h3>
                <ul class="dcrs-more-services__list">
                    <li><a href="/mobile-car-repair-dubai">Mobile car repair Dubai</a> — mechanic comes to you</li>
                    <li><a href="/roadside-assistance-dubai">Roadside assistance Dubai</a> — 24-hr emergency help</li>
                    <li><a href="/car-maintenance-dubai">Car service Dubai</a> — periodic scheduled maintenance</li>
                    <li><a href="/car-repair-al-satwa">Car repair Satwa</a> — serving Al Satwa & nearby areas</li>
                    <li><a href="/car-repair-sheikh-zayed-road">Car repair Sheikh Zayed Road</a> — fast mobile response on SZR</li>
                </ul>
            </div>
        </div>
    </section>

    <!-- 4. Trust / spec sheet ---------------------------------------------->
    <section class="dcrs-section dcrs-section--ink">
        <div class="dcrs-container">
            <div class="dcrs-heading dcrs-heading--light">
                <h2 class="dcrs-heading__title">Why Dubai drivers trust our car mechanical service</h2>
                <p class="dcrs-heading__sub dcrs-heading__sub--light">Honest pricing, trained technicians, and fast turnaround — this is what 12 years of repeat business looks like.</p>
            </div>
            <div class="dcrs-spec">
                {trustPoints.map((point) => (
                    <div class="dcrs-spec__item">
                        <span class="dcrs-icon dcrs-icon--brass"><Fragment set:html={icons[point.icon]} /></span>
                        <h3 class="dcrs-spec__title">{point.title}</h3>
                        <p class="dcrs-spec__desc">{point.description}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- 5. About ---------------------------------------------------------->
    <section class="dcrs-section dcrs-section--paper">
        <div class="dcrs-container dcrs-about">
