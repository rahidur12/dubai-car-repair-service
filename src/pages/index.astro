<script is:inline>
    const homeForm = document.getElementById('home-booking-form');
    if (homeForm) {
        homeForm.addEventListener('submit', async function(e) {
            e.preventDefault();
            const btn = document.getElementById('home-form-btn');
            const status = document.getElementById('home-form-status');
            const originalText = btn.textContent;
            
            btn.disabled = true;
            btn.textContent = 'Sending request...';
            if (status) status.style.display = 'none';

            const formData = new FormData(homeForm);
            const data = Object.fromEntries(formData.entries());

            try {
                const res = await fetch('https://formsubmit.co/ajax/coklateboy7@gmail.com', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify(data)
                });

                if (res.ok) {
                    homeForm.reset();
                    if (status) {
                        status.style.display = 'block';
                        status.style.background = '#d4edda';
                        status.style.color = '#155724';
                        status.style.border = '1px solid #c3e6cb';
                        status.textContent = '✓ Thank you! Your callback request has been received. Our technician will call you shortly.';
                    }
                    btn.textContent = '✓ Request Sent';
                } else {
                    homeForm.submit();
                }
            } catch (err) {
                homeForm.submit();
            } finally {
                setTimeout(() => {
                    btn.disabled = false;
                    btn.textContent = originalText;
                }, 5000);
            }
        });
    }
</script>

