---
import BaseLayout from '../layouts/BaseLayout.astro';
import aboutImg from '../assets/images/ab1.webp';

// ---------------------------------------------------------------------------
// SEO
// ---------------------------------------------------------------------------

const pageTitle = "Dubai Car Repair Service | Expert Car Repair in Dubai";
const pageDescription = "Need car repair in Dubai? Call us at 222 Al Satwa Road. Oil change, tyres, AC, engine, battery & mobile mechanic. Open 7 days, 7 AM–10 PM. Call or WhatsApp now.";

// ---------------------------------------------------------------------------
// Schema — LocalBusiness + FAQPage
// ---------------------------------------------------------------------------

const schema = [
  {
    "@context": "https://schema.org",
    "@type": ["AutoRepair", "LocalBusiness"],
    "@id": "https://dubaicarrepairservice.com/#localbusiness",
    "name": "Dubai Car Repair Service",
    "alternateName": ["Dubai Car Repair", "Dubai Auto Repair Workshop"],
    "url": "https://dubaicarrepairservice.com/",
    "telephone": "+971566121423",
    "email": "contact@dubaicarrepairservice.com",
    "image": "https://dubaicarrepairservice.com/img/logo.webp",
    "logo": {
      "@type": "ImageObject",
      "url": "https://dubaicarrepairservice.com/img/logo.webp"
    },
    "description": "Dubai Car Repair Service is a professional auto repair workshop in Al Satwa, Dubai offering engine repair, AC service, diagnostics, battery replacement, oil change and mobile car repair across Dubai.",
    "priceRange": "AED 50 – AED 2,500",
    "currenciesAccepted": "AED",
    "paymentAccepted": ["Cash", "Credit Card", "Debit Card"],
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "222 Al Satwa Rd - Al Satwa",
      "addressLocality": "Dubai",
      "addressRegion": "Dubai",
      "postalCode": "00000",
      "addressCountry": "AE"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 25.23121,
      "longitude": 55.27718
    },
    "openingHoursSpecification": [{
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
      "opens": "07:00",
      "closes": "22:00"
    }],
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Car Repair Services Dubai",
      "itemListElement": [
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Car Oil Change Dubai", "url": "https://dubaicarrepairservice.com/engine-oil-change-dubai" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Tyre Change Dubai", "url": "https://dubaicarrepairservice.com/tyre-replacement-dubai" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Car AC Repair Dubai", "url": "https://dubaicarrepairservice.com/car-ac-repair-dubai" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Car Battery Replacement Dubai", "url": "https://dubaicarrepairservice.com/car-battery-replacement-dubai" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Car Engine Repair Dubai", "url": "https://dubaicarrepairservice.com/car-engine-service-dubai" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Car Inspection Dubai", "url": "https://dubaicarrepairservice.com/car-inspection-dubai" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Mobile Car Repair Dubai", "url": "https://dubaicarrepairservice.com/mobile-car-repair-dubai" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Roadside Assistance Dubai", "url": "https://dubaicarrepairservice.com/roadside-assistance-dubai" } }
      ]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What car repair services do you offer in Dubai?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We offer engine oil change, tyre replacement, car AC repair, battery replacement, engine diagnostics and repair, full car inspection, mobile car repair, roadside assistance, and complete car maintenance across Dubai."
        }
      },
      {
        "@type": "Question",
        "name": "Do you offer mobile car repair in Dubai?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Our mobile mechanics come to your location anywhere in Dubai — home, office, or roadside — for oil changes, battery replacement, tyre fitting, and more."
        }
      },
      {
        "@type": "Question",
        "name": "How much does a car service cost in Dubai?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Prices range from AED 50 for a basic oil top-up to AED 2,500+ for major engine work. We give you a written, upfront estimate before any work begins — no hidden charges."
        }
      },
      {
        "@type": "Question",
        "name": "Are you open on weekends and public holidays?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. We are open Saturday through Friday, including public holidays, from 7 AM to 10 PM."
        }
      },
      {
        "@type": "Question",
        "name": "Where is your workshop located in Dubai?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Our garage is at 222 Al Satwa Road, Al Satwa, Dubai — minutes from Sheikh Zayed Road, Jumeirah, DIFC, and Downtown Dubai."
        }
      }
    ]
  }
];

// ---------------------------------------------------------------------------
// Content
// ---------------------------------------------------------------------------

const features = [
    {
        icon: "certificate",
        title: "Genuine & OEM-approved parts",
        description: "Every repair uses manufacturer-approved components, certified fluids, and high-grade filters suited for UAE operating conditions. We preserve vehicle safety and factory performance with zero substandard substitutes."
    },
    {
        icon: "tools",
        title: "8 specialist mechanics, 12+ years experience",
        description: "Serving Dubai drivers continuously since 2012. Our experienced technicians handle precision engine diagnostics, electrical repairs, and transmission servicing with over 8,500 vehicles maintained.",
        highlighted: true
    },
    {
        icon: "wrench",
        title: "OBD-II computer diagnostics & dedicated bays",
        description: "Specialized computerized scanners, hydraulic service lifts, and dedicated electrical testing gear isolate fault codes rapidly. Accurate diagnostics prevent unnecessary parts replacement."
    }
];

const services = [
    {
        title: "Car Inspection Dubai",
        image: "/src/assets/images/service1.webp",
        alt: "Mechanic performing a 50-point car inspection check at Dubai Car Repair Service",
        link: "/car-inspection-dubai",
        icon: "search",
        bullet1: "Comprehensive 50+ point vehicle health & safety check",
        bullet2: "Computerized OBD-II scan, braking system & battery check",
        bullet3: "Detailed inspection report for pre-purchase or RTA readiness"
    },
    {
        title: "Engine Repair & Service Dubai",
        image: "/src/assets/images/service2.webp",
        alt: "Technician diagnosing car engine fault codes at Dubai Car Repair Service workshop",
        link: "/car-engine-service-dubai",
        icon: "engine",
        bullet1: "Check engine light diagnostics & sensor troubleshooting",
        bullet2: "Timing chain, head gasket, cooling & fuel system repairs",
        bullet3: "Mechanical rebuilds using manufacturer-approved parts"
    },
    {
        title: "Tyre Replacement & Alignment Dubai",
        image: "/src/assets/images/service3.webp",
        alt: "Tyre fitting and computerized wheel alignment in progress at Dubai Car Repair Service",
        link: "/tyre-replacement-dubai",
        icon: "tyre",
        bullet1: "Supply & fitting for international tyre brands",
        bullet2: "Computerised high-speed wheel balancing & rotation",
        bullet3: "3D laser wheel alignment for even tread wear & stability"
    },
    {
        title: "Engine Oil & Filter Change Dubai",
        image: "/src/assets/images/service4.webp",
        alt: "Fully synthetic engine oil change and filter replacement at Dubai Car Repair Service",
        link: "/engine-oil-change-dubai",
        icon: "drop",
        bullet1: "Fully synthetic manufacturer-spec oils for UAE heat",
        bullet2: "OEM oil filter and engine air filter replacement",
        bullet3: "Complimentary fluid top-ups & safety visual inspection"
    },
    {
        title: "Car Battery Replacement Dubai",
        image: "/src/assets/images/service5.webp",
        alt: "Digital car battery load test and replacement at Dubai Car Repair Service",
        link: "/car-battery-replacement-dubai",
        icon: "bolt",
        bullet1: "Digital battery load testing & charging system analysis",
        bullet2: "Heat-resistant batteries with manufacturer warranty",
        bullet3: "Workshop fitting or rapid on-site mobile delivery across Dubai"
    },
    {
        title: "Car AC Repair & Gas Refill Dubai",
        image: "/src/assets/images/service6.webp",
        alt: "Car AC refrigerant refill and compressor repair at Dubai Car Repair Service",
        link: "/car-ac-repair-dubai",
        icon: "snowflake",
        bullet1: "Electronic refrigerant leak detection & pressure test",
        bullet2: "R134a/R1234yf gas recharge & compressor repairs",
        bullet3: "Evaporator, condenser, and cabin filter servicing"
    }
];

const trustPoints = [
    {
        icon: "mapPin",
        title: "Centrally located at 222 Al Satwa Road",
        description: "Situated minutes from Sheikh Zayed Road, Jumeirah, Downtown Dubai, and Business Bay. Easy drop-off with customer parking, plus mobile service dispatch across Dubai."
    },
    {
        icon: "shield",
        title: "12+ years of independent workshop experience",
        description: "Operating continuously since 2012 with over 8,500 vehicles serviced. Our 4.8 Google rating is built on repeat private and commercial drivers."
    },
    {
        icon: "car",
        title: "Multi-brand mechanical & electrical expertise",
        description: "Specialized tools and diagnostics for Japanese, European, and American marques including Toyota, Nissan, BMW, Mercedes-Benz, Ford, and Land Rover."
    },
    {
        icon: "invoice",
        title: "Clear, upfront written estimates",
        description: "You receive a clear scope of work and price confirmation before repair begins. Zero hidden charges, no unapproved labor, and no unnecessary upsells."
    },
    {
        icon: "bolt",
        title: "Same-day completion for routine maintenance",
        description: "Scheduled servicing, brake pads, battery installations, and oil changes are completed efficiently to minimize your vehicle downtime."
    },
    {
        icon: "clock",
        title: "Open 7 days a week, 7 AM to 10 PM",
        description: "Automotive troubles do not follow a set schedule. We are open Saturday through Friday, including weekends and public holidays, for emergency and routine visits."
    }
];

const areas = [
    'Al Satwa', 'Jumeirah', 'Bur Dubai', 'Karama',
    'Al Mankhool', "Za'abeel", 'DIFC', 'Downtown Dubai',
    'Business Bay', 'Al Quoz', 'Al Barsha', 'Dubai Marina',
    'JVC', 'Mirdif', 'Al Nahda', 'Al Jaddaf',
    'Oud Metha', 'Al Wasl', 'Al Safa', 'Sheikh Zayed Road'
];

const badges = [
    '8 specialist mechanics with multi-brand diagnostic tooling',
    'Upfront written estimates with zero hidden charges',
    'Workmanship warranty on completed repairs [CONFIRM: warranty duration if specified]'
];

const stats = [
    { value: "12+", label: "Years experience" },
    { value: "08", label: "Specialist mechanics" },
    { value: "8,500+", label: "Vehicles serviced" },
    { value: "4.8", label: "Google customer rating" }
];

const faqs = [
    {
        q: "What car repair services do you offer in Dubai?",
        a: "We cover everything from routine oil changes and tyre fitting to engine diagnostics, car AC repair, battery replacement, full car inspection, and emergency roadside assistance. We also send mobile mechanics anywhere in Dubai."
    },
    {
        q: "Do you offer mobile car repair in Dubai?",
        a: "Yes. Our mobile mechanics come to your home, office, or roadside location for oil changes, battery swaps, tyre fitting, and minor repairs — no need to visit the workshop."
    },
    {
        q: "How much does a car service cost in Dubai?",
        a: "Prices range from around AED 50 for a fluid top-up to AED 2,500+ for major engine work. You always get a written estimate before we start — no surprises, no hidden charges."
    },
    {
        q: "Are you open on weekends and public holidays?",
        a: "Yes. We are open Saturday through Friday, 7 AM to 10 PM, including all public holidays."
    },
    {
        q: "Where is your workshop in Dubai?",
        a: "Our garage is at 222 Al Satwa Road, Al Satwa — a few minutes from Sheikh Zayed Road, Jumeirah, DIFC, and Downtown Dubai."
    }
];

// ---------------------------------------------------------------------------
// Icons — minimal line set, drawn for this brief (no icon-font dependency)
// ---------------------------------------------------------------------------

const icons: Record<string, string> = {
    certificate: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8.5" r="5.5"/><path d="M8.8 13.2 7.5 21l4.5-2.2 4.5 2.2-1.3-7.8"/></svg>`,
    tools: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 6.5 18 3l3 3-3.5 3.5"/><path d="M17 4 13 8"/><path d="M3 21l7-7"/><path d="M8.5 9.5 3 4l2-2 5.5 5.5"/><path d="M12.5 13.5 21 22"/></svg>`,
    wrench: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a4 4 0 0 1-5.4 5.4L4 17l3 3 5.3-5.3a4 4 0 0 1 5.4-5.4L21 6l-3-3-3.3 3.3Z"/></svg>`,
    search: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m20 20-4.7-4.7"/></svg>`,
    engine: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3.2"/><path d="M12 2.5v2.4M12 19.1v2.4M21.5 12h-2.4M4.9 12H2.5M18.2 5.8l-1.7 1.7M7.5 16.5l-1.7 1.7M18.2 18.2l-1.7-1.7M7.5 7.5 5.8 5.8"/></svg>`,
    tyre: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="3"/><path d="M12 3.5v2.3M12 18.2v2.3M20.5 12h-2.3M5.8 12H3.5M18 6l-1.6 1.6M7.6 16.4 6 18M18 18l-1.6-1.6M7.6 7.6 6 6"/></svg>`,
    drop: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3s6 7.2 6 11.5a6 6 0 0 1-12 0C6 10.2 12 3 12 3Z"/></svg>`,
    bolt: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4.5 13.5h6L10 22l8.5-11.5h-6L13 2Z"/></svg>`,
    snowflake: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5v19M3.8 6.75l16.4 10.5M20.2 6.75 3.8 17.25"/><path d="m9 5 3-2.5L15 5M9 19l3 2.5L15 19M6 9.3 2.7 8.4l-.4-3.4M18 9.3l3.3-.9.4-3.4M6 14.7l-3.3.9-.4 3.4M18 14.7l3.3.9.4 3.4"/></svg>`,
    mapPin: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21.5s7-6.6 7-12A7 7 0 0 0 5 9.5c0 5.4 7 12 7 12Z"/><circle cx="12" cy="9.5" r="2.4"/></svg>`,
    shield: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5 20 6v6c0 5-3.4 8.4-8 9.5-4.6-1.1-8-4.5-8-9.5V6l8-3.5Z"/><path d="m8.7 12 2.3 2.3 4.3-4.6"/></svg>`,
    car: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 16V11.5L6.3 6.8a2 2 0 0 1 1.8-1.1h7.8a2 2 0 0 1 1.8 1.1L20 11.5V16"/><path d="M4 16v2.3a.9.9 0 0 0 .9.9h1.4a.9.9 0 0 0 .9-.9V16M20 16v2.3a.9.9 0 0 1-.9.9h-1.4a.9.9 0 0 1-.9-.9V16M4 16h16M7.5 11h9"/></svg>`,
    invoice: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 2.5h8l3 3v15.5a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5V3a.5.5 0 0 1 .5-.5Z"/><path d="M9 9h6M9 12.5h6M9 16h3.5"/></svg>`,
    clock: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg>`,
    check: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7"/></svg>`,
    phone: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5.5 3.5h3l1.5 4-2 1.5a12 12 0 0 0 6.5 6.5l1.5-2 4 1.5v3a1.5 1.5 0 0 1-1.6 1.5A17 17 0 0 1 4 5.1a1.5 1.5 0 0 1 1.5-1.6Z"/></svg>`,
    chat: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12a8 8 0 1 1 3.3 6.4L4 20l1.4-3.6A7.9 7.9 0 0 1 4 12Z"/><path d="M9 11.5c.3 2 2 3.7 4 4"/></svg>`,
    faq: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9.5"/><path d="M9.5 9a2.5 2.5 0 0 1 5 .8c0 1.7-2.5 2.5-2.5 4"/><circle cx="12" cy="17" r=".5" fill="currentColor"/></svg>`
