---
import BaseLayout from '../layouts/BaseLayout.astro';
import aboutImage1 from '../assets/images/ab1.webp';
import aboutImage2 from '../assets/images/about 2.webp';

// ---------------------------------------------------------------------------
// Page Metadata & Settings (Strict SEO Requirements)
// Title <= 60 chars | Description <= 155 chars | Primary: [brand name] car repair company dubai
// ---------------------------------------------------------------------------
const pageTitle = "About Us | Dubai Car Repair Service Company in Dubai";
const pageDescription = "Learn about Dubai Car Repair Service, a leading car repair company in Dubai offering trusted auto workshop & mobile mechanic services since 2012.";

const phoneDisplay = "+971 56 612 1423";
const phoneHref = "tel:+971566121423";
const waHref = "https://api.whatsapp.com/send?phone=971566121423";

// ---------------------------------------------------------------------------
// Icons
// ---------------------------------------------------------------------------
const icons: Record<string, string> = {
    mapPin: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21.5s7-6.6 7-12A7 7 0 0 0 5 9.5c0 5.4 7 12 7 12Z"/><circle cx="12" cy="9.5" r="2.4"/></svg>`,
    certificate: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8.5" r="5.5"/><path d="M8.8 13.2 7.5 21l4.5-2.2 4.5 2.2-1.3-7.8"/></svg>`,
    car: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 16V11.5L6.3 6.8a2 2 0 0 1 1.8-1.1h7.8a2 2 0 0 1 1.8 1.1L20 11.5V16"/><path d="M4 16v2.3a.9.9 0 0 0 .9.9h1.4a.9.9 0 0 0 .9-.9V16M20 16v2.3a.9.9 0 0 1-.9.9h-1.4a.9.9 0 0 1-.9-.9V16M4 16h16M7.5 11h9"/></svg>`,
    invoice: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 2.5h8l3 3v15.5a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5V3a.5.5 0 0 1 .5-.5Z"/><path d="M9 9h6M9 12.5h6M9 16h3.5"/></svg>`,
    bolt: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4.5 13.5h6L10 22l8.5-11.5h-6L13 2Z"/></svg>`,
    star: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`,
    shield: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5 20 6v6c0 5-3.4 8.4-8 9.5-4.6-1.1-8-4.5-8-9.5V6l8-3.5Z"/><path d="m8.7 12 2.3 2.3 4.3-4.6"/></svg>`,
    award: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>`,
    clock: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg>`,
    check: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7"/></svg>`,
    phone: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5.5 3.5h3l1.5 4-2 1.5a12 12 0 0 0 6.5 6.5l1.5-2 4 1.5v3a1.5 1.5 0 0 1-1.6 1.5A17 17 0 0 1 4 5.1a1.5 1.5 0 0 1 1.5-1.6Z"/></svg>`,
    chat: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12a8 8 0 1 1 3.3 6.4L4 20l1.4-3.6A7.9 7.9 0 0 1 4 12Z"/><path d="M9 11.5c.3 2 2 3.7 4 4"/></svg>`,
    arrowRight: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>`,
    chevronDown: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>`,
    search: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m20 20-4.7-4.7"/></svg>`,
    engine: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3.2"/><path d="M12 2.5v2.4M12 19.1v2.4M21.5 12h-2.4M4.9 12H2.5M18.2 5.8l-1.7 1.7M7.5 16.5l-1.7 1.7M18.2 18.2l-1.7-1.7M7.5 7.5 5.8 5.8"/></svg>`,
    tools: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 6.5 18 3l3 3-3.5 3.5"/><path d="M17 4 13 8"/><path d="M3 21l7-7"/><path d="M8.5 9.5 3 4l2-2 5.5 5.5"/><path d="M12.5 13.5 21 22"/></svg>`,
    drop: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3s6 7.2 6 11.5a6 6 0 0 1-12 0C6 10.2 12 3 12 3Z"/></svg>`,
    snowflake: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5v19M3.8 6.75l16.4 10.5M20.2 6.75 3.8 17.25"/><path d="m9 5 3-2.5L15 5M9 19l3 2.5L15 19M6 9.3 2.7 8.4l-.4-3.4M18 9.3l3.3-.9.4-3.4M6 14.7l-3.3.9-.4 3.4M18 14.7l3.3.9.4 3.4"/></svg>`,
    disc: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/></svg>`,
    truck: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>`,
};

// ---------------------------------------------------------------------------
// Section Data
// ---------------------------------------------------------------------------
const values = [
    {
        icon: "shield",
        title: "Accurate Diagnostics & Upfront Pricing",
        text: "Vehicles undergo computerized inspection before work begins. We provide itemized written estimates with zero unapproved charges."
    },
    {
        icon: "award",
        title: "Manufacturer-Approved Parts & Fluids",
        text: "Extreme UAE summer heat demands genuine parts and certified fluids with proper thermal ratings, ensuring lasting engine safety."
    },
    {
        icon: "clock",
        title: "Same-Day Service & Daily Availability",
        text: "Routine maintenance, oil, brakes, and batteries are completed same-day. Open daily 7:00 AM to 10:00 PM for easy vehicle drop-off."
    }
];

const reasons = [
    {
        icon: "mapPin",
        title: "Central Workshop at 222 Al Satwa Road",
        text: "Conveniently located minutes from Sheikh Zayed Road, Jumeirah, Downtown Dubai, and DIFC with dedicated customer parking bays."
    },
    {
        icon: "certificate",
        title: "8 Specialist Mechanics with 12+ Years Experience",
        text: "Certified mechanics experienced in powertrain overhauls, electronics, cooling systems, and computerized OBD-II scanning."
    },
    {
        icon: "car",
        title: "Multi-Brand Mechanical Capability",
        text: "Comprehensive diagnostic and repair capability for Toyota, Nissan, BMW, Mercedes-Benz, Ford, Land Rover, and Korean models."
    },
    {
        icon: "invoice",
        title: "Itemized Written Quotations",
        text: "Full cost clarity before work commences. The price agreed upon is what appears on your final invoice, with zero surprise extras."
    },
    {
        icon: "bolt",
        title: "Efficient Turnaround Times",
        text: "Routine servicing, battery testing, and brake replacements completed rapidly to keep downtime to an absolute minimum."
    },
    {
        icon: "star",
        title: "Over 8,500 Satisfied Motorists",
        text: "Twelve years of trusted service delivering high customer satisfaction and dependable automotive engineering across Dubai."
    }
];

const teamPoints = [
    "Dealer-grade OBD-II scanning to read trouble codes and live engine sensor telemetry",
    "Specialized technical training covering Japanese, European, American, and Korean vehicles",
    "Practical experience with Toyota Land Cruiser, Nissan Patrol, BMW, Mercedes, and Ford",
    "Extensive understanding of Gulf thermal demands on radiators, batteries, and engine oils",
    "Thorough multi-point inspection protocols before any part replacement is recommended",
    "Clear communication explaining repair recommendations in plain, understandable language"
];

const brands = [
    { name: "Toyota", origin: "Japanese" },
    { name: "Nissan", origin: "Japanese" },
    { name: "Honda", origin: "Japanese" },
    { name: "Mitsubishi", origin: "Japanese" },
    { name: "Lexus", origin: "Japanese" },
    { name: "BMW", origin: "European" },
    { name: "Mercedes-Benz", origin: "European" },
    { name: "Audi", origin: "European" },
    { name: "Volkswagen", origin: "European" },
    { name: "Porsche", origin: "European" },
    { name: "Kia", origin: "Korean" },
    { name: "Hyundai", origin: "Korean" },
    { name: "Ford", origin: "American" },
    { name: "Chevrolet", origin: "American" },
    { name: "Jeep", origin: "American" },
    { name: "Land Rover", origin: "British" }
];

const reviews = [
    {
        name: "Vivek Kumar Gautam",
        area: "Al Barsha",
        text: "Top-notch service! My car battery was replaced in no time. The team was professional, quick, and the price matched the quote exactly."
    },
    {
        name: "Mohammad Ashek",
        area: "Business Bay",
        text: "Efficient and reliable! They handled my car engine service professionally with a full breakdown before starting."
    },
    {
        name: "Muhammad Isa",
        area: "Karama",
        text: "Great experience. Called them for car AC repair and they fixed the cooling problem fast. Will use them again."
    }
];

const faqs = [
    {
        q: "Where is Dubai Car Repair Service located?",
        a: "Our central workshop is located at 222 Al Satwa Road, Al Satwa, Dubai, conveniently accessible from Sheikh Zayed Road, Jumeirah, and Downtown Dubai."
    },
    {
        q: "What are your operating hours?",
        a: "We are open seven days a week from 7:00 AM to 10:00 PM, including weekends and public holidays. Drive-ins are welcome daily."
    },
    {
        q: "Do you service all vehicle makes and models?",
        a: "Yes, our mechanics service Japanese, European, American, and Korean passenger cars, 4x4 SUVs, and light commercial vehicles."
    },
    {
        q: "What is your pricing policy for car repairs?",
        a: "We provide upfront, itemized written quotes before beginning any mechanical or electrical repair, ensuring zero hidden costs."
    },
    {
        q: "Do you offer on-site mobile mechanic assistance?",
        a: "Yes, our mobile vans provide rapid roadside assistance, dead battery replacement, and emergency tyre changes across Dubai."
    }
];

// ---------------------------------------------------------------------------
// Schema for AboutPage, LocalBusiness & FAQPage
// ---------------------------------------------------------------------------
const pageSchema = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": ["AutoRepair", "LocalBusiness", "AboutPage"],
            "@id": "https://dubaicarrepairservice.com/about#webpage",
            "name": "About Dubai Car Repair Service Company in Dubai",
            "url": "https://dubaicarrepairservice.com/about",
            "telephone": "+971566121423",
            "image": "https://dubaicarrepairservice.com/img/logo.webp",
            "priceRange": "AED 80 - AED 2,500",
            "currenciesAccepted": "AED",
            "paymentAccepted": ["Cash", "Credit Card", "Debit Card"],
            "address": {
                "@type": "PostalAddress",
                "streetAddress": "222 Al Satwa Rd - Al Satwa",
                "addressLocality": "Dubai",
                "addressRegion": "Dubai",
                "postalCode": "00000",
                "addressCountry": "AE"
            },
            "openingHoursSpecification": [{
                "@type": "OpeningHoursSpecification",
                "dayOfWeek": ["Saturday", "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
                "opens": "07:00",
                "closes": "22:00"
            }],
            "description": "Learn about Dubai Car Repair Service, an independent car repair company in Dubai delivering honest auto workshop and mobile mechanic repairs since 2012."
        },
        {
            "@type": "BreadcrumbList",
            "@id": "https://dubaicarrepairservice.com/about#breadcrumb",
            "itemListElement": [
                {
                    "@type": "ListItem",
                    "position": 1,
                    "name": "Home",
                    "item": "https://dubaicarrepairservice.com/"
                },
                {
                    "@type": "ListItem",
                    "position": 2,
                    "name": "About Us",
                    "item": "https://dubaicarrepairservice.com/about"
                }
            ]
        },
        {
            "@type": "FAQPage",
            "@id": "https://dubaicarrepairservice.com/about#faq",
            "mainEntity": faqs.map(faq => ({
                "@type": "Question",
                "name": faq.q,
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": faq.a
                }
            }))
        }
    ]
};
---

<BaseLayout
    title={pageTitle}
    description={pageDescription}
>
    <!-- Structured JSON-LD Schema Graph -->
    <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

    <main class="dcrs-about-page">

        <!-- HERO BANNER ----------------------------------------------------->
        <header class="dcrs-hero-banner">
            <div class="dcrs-hero-banner__scrim"></div>
            <div class="dcrs-container dcrs-hero-banner__inner">
                <nav class="dcrs-breadcrumb" aria-label="Breadcrumb">
                    <ol>
                        <li><a href="/">Home</a></li>
                        <li aria-current="page">About Us</li>
                    </ol>
                </nav>
                <span class="dcrs-badge">Trusted Since 2012 · Al Satwa, Dubai</span>
                <h1 class="dcrs-hero-banner__title">
                    Dubai Car Repair Service — Leading Car Repair Company in Dubai
                </h1>
                <p class="dcrs-hero-banner__lead">
                    As an independent car repair company in Dubai established in 2012, Dubai Car Repair Service provides honest computer diagnostics, precision mechanical overhauls, and prompt mobile mechanic support for motorists across the UAE.
                </p>
                <div class="dcrs-hero-banner__actions">
                    <a href={phoneHref} class="dcrs-btn dcrs-btn--solid">
                        <Fragment set:html={icons.phone} /> Call {phoneDisplay}
                    </a>
                    <a href={waHref} target="_blank" rel="noopener noreferrer" class="dcrs-btn dcrs-btn--outline">
                        <Fragment set:html={icons.chat} /> WhatsApp Us
                    </a>
                </div>
            </div>
        </header>

        <!-- SECTION 1: OUR STORY / WHO WE ARE ------------------------------->
        <section class="dcrs-section dcrs-section--paper" id="our-story">
            <div class="dcrs-container">
                <div class="dcrs-grid-2col dcrs-grid-2col--align-center">
                    
                    <div class="dcrs-story-media">
                        <div class="dcrs-story-media__frame">
                            <img
                                src={aboutImage1.src}
                                alt="Technicians working at Dubai Car Repair Service company in Dubai workshop"
                                loading="eager"
                                width="600"
                                height="400"
                            />
                            <div class="dcrs-plate dcrs-story-badge" aria-hidden="true">
                                <div class="dcrs-plate__tab">DXB</div>
                                <div class="dcrs-plate__body">
                                    <span class="dcrs-plate__row dcrs-plate__row--big">12</span>
                                    <span class="dcrs-plate__row">YEARS SERVING</span>
                                    <span class="dcrs-plate__row">DUBAI DRIVERS</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="dcrs-story-content">
                        <div class="dcrs-kicker">Our Heritage</div>
                        <h2 class="dcrs-heading__title">
                            An Independent Car Repair Company Dubai Drivers Rely On
                        </h2>
                        <p class="dcrs-lead-text">
                            At <a href="/" class="dcrs-inline-link">dubai car repair service</a>, our mission since 2012 has been clear: deliver dealership-grade mechanical craftsmanship and honest transparent pricing without aggressive upselling or hidden markups.
                        </p>
                        <p class="dcrs-body-text">
                            From our central workshop at 222 Al Satwa Road, our licensed garage has grown into a premier automotive care destination staffed by 8 specialist mechanics. We understand the demanding operating conditions that Dubai's extreme summer heat imposes on vehicle engines, air conditioning compressors, and electrical batteries.
                        </p>
                        <p class="dcrs-body-text">
                            Whether you need routine <a href="/car-maintenance-dubai" class="dcrs-inline-link">car service dubai</a> maintenance or urgent on-demand assistance through our <a href="/mobile-car-repair-dubai" class="dcrs-inline-link">mobile car repair dubai</a> fleet, our technicians apply rigorous diagnostic standards to ensure lasting reliability on every journey.
                        </p>

                        <div class="dcrs-action-row">
                            <a href="/contact" class="dcrs-btn dcrs-btn--solid">
                                <Fragment set:html={icons.phone} /> Contact Us
                            </a>
                            <a href={phoneHref} class="dcrs-btn dcrs-btn--outline-ink">
                                Speak to a Mechanic <Fragment set:html={icons.arrowRight} />
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- SECTION 2: OUR MISSION & VALUES ---------------------------------->
        <section class="dcrs-section dcrs-section--tint" id="mission-values">
            <div class="dcrs-container">
                <div class="dcrs-heading dcrs-heading--center">
                    <div class="dcrs-kicker">Operating Standards</div>
                    <h2 class="dcrs-heading__title">Core Principles That Guide Our Company</h2>
                    <p class="dcrs-heading__sub">
                        Every vehicle inspection, scheduled maintenance, and major mechanical rebuild adheres to three strict standards.
                    </p>
                </div>

                <div class="dcrs-values-grid">
                    {values.map((v) => (
                        <div class="dcrs-value-card">
                            <span class="dcrs-value-card__icon">
                                <Fragment set:html={icons[v.icon]} />
                            </span>
                            <h3 class="dcrs-value-card__title">{v.title}</h3>
                            <p class="dcrs-value-card__text">{v.text}</p>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- SECTION 3: WHY CHOOSE US ----------------------------------------->
        <section class="dcrs-section dcrs-section--paper" id="why-choose-us">
            <div class="dcrs-container">
                <div class="dcrs-heading dcrs-heading--center">
                    <div class="dcrs-kicker">Why Choose Us</div>
                    <h2 class="dcrs-heading__title">Why Dubai Motorists Trust Our Auto Repair Garage</h2>
                    <p class="dcrs-heading__sub">
                        Practical mechanical competence, dealer-standard diagnostic tools, and transparent customer care.
                    </p>
                </div>

                <div class="dcrs-reasons-grid">
                    {reasons.map((r) => (
                        <div class="dcrs-reason-card">
                            <span class="dcrs-reason-card__icon">
                                <Fragment set:html={icons[r.icon]} />
                            </span>
                            <div>
                                <h3 class="dcrs-reason-card__title">{r.title}</h3>
                                <p class="dcrs-reason-card__text">{r.text}</p>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- SECTION 4: CALL TO ACTION BANNER --------------------------------->
        <section class="dcrs-cta-banner">
            <div class="dcrs-container">
                <div class="dcrs-cta-banner__inner">
                    <div class="dcrs-cta-banner__copy">
                        <span class="dcrs-cta-banner__badge">Book Your Service</span>
                        <h2 class="dcrs-cta-banner__title">
                            Need Professional Car Servicing or Diagnostic Inspection?
                        </h2>
                        <p class="dcrs-cta-banner__sub">
                            Visit our Al Satwa workshop or <a href="/contact" class="dcrs-cta-inline-link">contact us</a> for prompt mobile mechanic dispatch anywhere in Dubai.
                        </p>
                    </div>
                    <div class="dcrs-cta-banner__actions">
                        <a href={phoneHref} class="dcrs-btn dcrs-btn--solid">
                            <Fragment set:html={icons.phone} /> Call {phoneDisplay}
                        </a>
                        <a href={waHref} target="_blank" rel="noopener noreferrer" class="dcrs-btn dcrs-btn--wa">
                            <Fragment set:html={icons.chat} /> WhatsApp Us
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION 5: OUR TEAM / CERTIFIED MECHANICS ------------------------>
        <section class="dcrs-section dcrs-section--paper" id="our-team">
            <div class="dcrs-container">
                <div class="dcrs-heading dcrs-heading--center">
                    <div class="dcrs-kicker">Technical Excellence</div>
                    <h2 class="dcrs-heading__title">8 Specialist Mechanics Dedicated to Vehicle Safety</h2>
                    <p class="dcrs-heading__sub">
                        Our mechanics bring years of hands-on experience across Japanese, European, American, and Korean vehicle platforms.
                    </p>
                </div>

                <div class="dcrs-grid-2col dcrs-grid-2col--align-center">
                    <div class="dcrs-team-media">
                        <img
                            src={aboutImage2.src}
                            alt="Certified mechanics conducting diagnostics and auto repairs in Dubai workshop"
                            loading="lazy"
                            width="640"
                            height="450"
                        />
                    </div>

                    <div class="dcrs-team-content">
                        <h3 class="dcrs-team-content__title">Our Repair Methodology</h3>
                        <ul class="dcrs-checklist">
                            {teamPoints.map((point) => (
                                <li>
                                    <span class="dcrs-icon dcrs-icon--xs"><Fragment set:html={icons.check} /></span>
                                    <span>{point}</span>
                                </li>
                            ))}
                        </ul>

                        <div class="dcrs-action-row">
                            <a href={phoneHref} class="dcrs-btn dcrs-btn--solid">
                                <Fragment set:html={icons.phone} /> Call {phoneDisplay}
                            </a>
                            <a href="/contact" class="dcrs-btn dcrs-btn--outline-ink">
                                Visit Workshop
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION 6: CAR BRANDS WE SERVICE --------------------------------->
        <section class="dcrs-section dcrs-section--tint" id="brands-serviced">
            <div class="dcrs-container">
                <div class="dcrs-heading dcrs-heading--center">
                    <div class="dcrs-kicker">Multi-Brand Fleet</div>
                    <h2 class="dcrs-heading__title">Vehicle Makes Regularly Repaired</h2>
                    <p class="dcrs-heading__sub">
                        Dedicated diagnostic equipment and technical specifications for all major automotive badges across the UAE.
                    </p>
                </div>

                <div class="dcrs-brands-grid">
                    {brands.map((brand) => (
                        <div class="dcrs-brand-badge">
                            <strong class="dcrs-brand-badge__name">{brand.name}</strong>
                            <span class="dcrs-brand-badge__origin">{brand.origin}</span>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- SECTION 7: CUSTOMER TESTIMONIALS --------------------------------->
        <section class="dcrs-section dcrs-section--paper" id="reviews">
            <div class="dcrs-container">
                <div class="dcrs-heading dcrs-heading--center">
                    <div class="dcrs-kicker">Customer Reviews</div>
                    <h2 class="dcrs-heading__title">Verified Feedback from Dubai Drivers</h2>
                    <div class="dcrs-rating-summary">
                        <span class="dcrs-stars">★★★★★</span>
