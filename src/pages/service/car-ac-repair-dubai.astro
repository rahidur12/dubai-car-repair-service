// ---------------------------------------------------------------------------
// Section Data
// ---------------------------------------------------------------------------
const faults = [
    {
        icon: "drop",
        title: "Refrigerant Leak",
        desc: "Heat cycling dries out rubber O-rings, hose crimps, and aluminium line connections. We locate leaks using UV fluorescent dye and electronic detectors before recharging so the refrigerant does not escape again.",
        cost: "AED 150–350*"
    },
    {
        icon: "cog",
        title: "Compressor Wear or Failure",
        desc: "Continuous high-load operation in Dubai summer traffic causes internal piston wear, bearing noise, or electromagnetic clutch failure. Symptoms include warm air at idle and metallic rattling sounds.",
        cost: "AED 600–1,800*"
    },
    {
        icon: "filter",
        title: "Clogged Cabin Air Filter",
        desc: "Sand and airborne dust restrict airflow across the evaporator core, making the blower fan feel weak and reducing cabin cooling even when the refrigeration cycle is functioning normally.",
        cost: "AED 80–150*"
    },
    {
        icon: "wind",
        title: "Blocked or Damaged Condenser",
        desc: "Positioned ahead of the radiator, the condenser releases heat from compressed refrigerant. Bent cooling fins or road debris build-up prevent proper heat exchange, resulting in warm air from vents.",
        cost: "AED 100–200*"
    },
    {
        icon: "sliders",
        title: "Expansion Valve Restriction",
        desc: "A stuck or restricted expansion valve disrupts refrigerant metering into the evaporator, causing erratic vent temperatures, evaporator core icing, or loss of cooling under acceleration.",
        cost: "AED 250–500*"
    },
    {
        icon: "bolt",
        title: "Electrical & Sensor Faults",
        desc: "Defective high/low pressure switches, failed compressor relays, damaged wiring harnesses, or climate control sensor errors can prevent the compressor clutch from engaging.",
        cost: "AED 100–400*"
    }
];

const serviceSteps = [
    { num: "1", title: "Pressure & Temperature Assessment", desc: "We connect digital manifold gauges to monitor high-side and low-side pressures while checking dashboard vent temperatures against ambient conditions." },
    { num: "2", title: "Electronic & UV Leak Detection", desc: "If pressures indicate low refrigerant, we use electronic sniffer probes and UV dye to inspect hose connections, the condenser, compressor shaft seals, and valves." },
    { num: "3", title: "Transparent Quote Approval", desc: "We explain the cause of cooling loss and provide an itemized quote for necessary parts and labour before beginning repairs [CONFIRM: exact car AC repair prices]." },
    { num: "4", title: "Vacuum & Moisture Evacuation", desc: "We run a deep vacuum pump through the sealed circuit to boil off moisture and remove air, preventing acidic sludge buildup and internal icing." },
    { num: "5", title: "Precision Refrigerant Recharge", desc: "We recharge the system by weight according to manufacturer specifications, adding compatible compressor lubricant (PAG or POE) to protect internal components." },
    { num: "6", title: "Cooling Performance Verification", desc: "We test the vehicle under load to verify stable vent temperatures between 4°C and 8°C in Dubai ambient conditions before handover." }
];

const pricingRows = [
    { service: "AC Gas Refill (R134a)", price: "AED 100 – 180", includes: "Evacuation, gas by weight & pressure check" },
    { service: "AC Gas Refill (R1234yf)", price: "AED 200 – 350", includes: "Dedicated R1234yf recovery, recharge & test" },
    { service: "Comprehensive AC Service", price: "AED 250 – 450", includes: "Gas recharge, leak check, condenser rinse & vent test" },
    { service: "AC Compressor Replacement", price: "AED 600 – 1,800", includes: "Compressor unit, installation & fresh gas recharge" },
    { service: "AC Condenser Replacement", price: "AED 400 – 900", includes: "Condenser unit, fitment, vacuum & recharge" },
    { service: "Expansion Valve Replacement", price: "AED 250 – 500", includes: "Component replacement & system pressure retest" },
    { service: "Cabin Air Filter Replacement", price: "AED 80 – 150", includes: "OEM-spec filter supply & installation" },
    { service: "AC Diagnostic & Leak Inspection", price: "AED 50 – 100", includes: "Pressure test, manifold gauge scan & leak report [CONFIRM: whether diagnostic fee is waived with repair]" }
];

const reasons = [
    {
        icon: "search",
        title: "Accurate Diagnosis First",
        desc: "We check operating pressures and inspect for physical leaks before recommending any repair. We do not upsell an expensive compressor replacement when a seal or relay solves the problem."
    },
    {
        icon: "snowflake",
        title: "Vehicle-Compatible Refrigerants",
        desc: "We verify your car's exact refrigerant specification (R134a or R1234yf) and charge by precise weight in grams rather than rough pressure approximations to protect your compressor."
    },
    {
        icon: "tools",
        title: "Dedicated Workshop Equipment",
        desc: "Our workshop at 222 Al Satwa Road is equipped with vacuum recovery stations, manifold gauges, and electronic leak detectors suited for delicate AC system servicing [CONFIRM: mobile AC repair availability and coverage]."
    },
    {
        icon: "shield",
        title: "Quality Replacement Parts",
        desc: "We source OEM-grade compressors, condensers, expansion valves, and filter driers built to withstand prolonged Dubai summer thermal loads [CONFIRM: AC parts warranty terms]."
    },
    {
        icon: "mapPin",
        title: "Centrally Located in Al Satwa",
        desc: "Conveniently situated on 222 Al Satwa Road, our workshop provides direct drive-in access for motorists from Jumeirah, Downtown Dubai, DIFC, Bur Dubai, and Karama."
    },
    {
        icon: "calendar",
        title: "Pre-Summer Cooling Checks",
        desc: "We provide seasonal cooling system inspections to catch minor refrigerant loss or condenser debris buildup before high summer temperatures arrive."
    }
];

const faqs = [
    {
        q: "Why is my car AC blowing warm air in Dubai?",
        a: "The most common causes are low refrigerant from an undetected leak, a failing compressor clutch, a blocked condenser, or an electrical pressure switch fault. In extreme Dubai heat, even a minor drop in refrigerant volume causes the evaporator to warm up rapidly. A pressure gauge test and electronic leak check are necessary to isolate the cause."
    },
    {
        q: "Can I simply refill AC gas without fixing a leak?",
        a: "Topping up refrigerant without repairing an active leak is a temporary fix. Refrigerant will escape again within days or weeks, allowing moisture and air into the lines which damages the compressor. We locate and repair leak points before refilling to ensure cooling performance lasts."
    },
    {
        q: "How often should I have my car AC serviced in Dubai?",
        a: "We recommend an annual AC system inspection, ideally in March or April before peak summer temperatures. Annual servicing includes checking system pressures, inspecting the cabin air filter, cleaning debris from the condenser, and verifying vent temperature output."
    },
    {
        q: "What is the difference between R134a and R1234yf refrigerant?",
        a: "R134a is the standard refrigerant for most vehicles built before 2017, while R1234yf is an environmentally friendly formulation required in newer models. They require different service fittings, specific compressor oils, and separate recovery equipment. They must never be mixed."
    },
    {
        q: "How much does a car AC compressor repair or replacement cost in Dubai?",
        a: "AC compressor replacement costs depend on whether the unit requires an electromagnetic clutch repair or a full compressor assembly replacement, as well as vehicle make and part availability. European vehicles generally cost more than Japanese or Korean models due to part pricing."
    },
    {
        q: "Do you provide mobile car AC repair in Dubai?",
        a: "While basic symptom checks can be performed on-site, comprehensive leak repairs, deep vacuum evacuation, and compressor replacements require dedicated recovery stations at our Al Satwa workshop [CONFIRM: mobile AC repair availability and coverage]."
    }
];

const relatedServices = [
    { icon: "tools", name: "Annual Car Maintenance Dubai", desc: "Comprehensive scheduled service packages for UAE driving", href: "/car-maintenance-dubai" },
    { icon: "car", name: "Mobile Car Repair Dubai", desc: "On-site diagnostic, battery & AC gas refill support", href: "/mobile-car-repair-dubai" },
