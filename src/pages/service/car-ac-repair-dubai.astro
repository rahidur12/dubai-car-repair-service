                            </div>
                            <div class="dcrs-gas-card">
                                <div class="dcrs-gas-card__header">
                                    <h3 class="dcrs-gas-card__title">Evaporator Core &amp; Expansion Valve</h3>
                                </div>
                                <p class="dcrs-gas-card__desc">
                                    Deep in-cabin leak diagnosis, evaporator coil replacement, thermal expansion valve (TXV) recalibration, and cabin odor sanitization.
                                </p>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>

