        icon: "car",
        title: "Experienced Automotive Team",
        desc: "Established in 2012, our team of 8 skilled mechanics has serviced more than 8,500 vehicles across Dubai, earning a 4.8-star Google rating for honest, dependable repair work."
    },
    {
        icon: "calendar",
        title: "Seasonal Cooling Check-ups",
        desc: "We offer pre-summer cooling inspections to check system pressures, evaluate condenser condition, and detect minor refrigerant loss before peak summer heat."
    }
];

const faqs = [
    {
        q: "Why is my car AC blowing warm air in Dubai?",
        a: "Car air conditioning can blow warm air for several reasons, including low refrigerant caused by a leak, a failing compressor or clutch, a blocked condenser, an electrical relay fault, or a clogged cabin air filter. Because multiple issues cause similar symptoms, technicians connect manifold gauges and perform a leak check to determine the exact fault before recommending repairs."
    },
    {
        q: "Can I simply refill AC gas without fixing a leak?",
        a: "Refilling refrigerant without repairing an active leak is only a temporary fix. Refrigerant will escape again over days or weeks, and operating a leaking system allows air and moisture to enter, which can damage the compressor and internal lubricants. We recommend locating and repairing the leak before recharging the system."
    },
    {
        q: "How often should I have my car AC serviced in Dubai?",
        a: "Given Dubai's extreme summer heat, we recommend having your car's AC system checked once a year, preferably in spring before peak temperatures arrive. An annual inspection includes checking operating pressures, inspecting the cabin filter, checking condenser fins for debris, and verifying overall cooling performance."
    },
    {
        q: "What is the difference between R134a and R1234yf refrigerant?",
        a: "R134a and R1234yf are different chemical refrigerants engineered for specific AC systems. R134a is found in many older and select modern vehicles, while R1234yf is used in many newer vehicles to comply with lower environmental emissions standards. They require different service fittings, recovery machines, and compatible oils, and they must never be mixed."
    },
    {
        q: "How much does a car AC compressor repair or replacement cost in Dubai?",
        a: "AC compressor replacement costs typically range from AED 600 to AED 1,800 depending on vehicle make, model, engine size, and whether an OEM or aftermarket unit is selected. European and luxury vehicles generally have higher component costs than Japanese or Korean models. We provide a clear, itemized quote after inspecting the vehicle."
    },
    {
        q: "Do you provide mobile car AC repair in Dubai?",
        a: "We offer mobile assistance across Dubai for initial AC diagnostics and basic refrigerant top-ups where site conditions allow. However, extensive repairs involving component replacement, system flushing, or deep vacuum evacuation are best performed at our Al Satwa workshop, where dedicated recovery equipment is installed."
    }
];

const relatedServices = [
    { icon: "tools", name: "Annual Car Maintenance Dubai", desc: "Comprehensive scheduled service packages for UAE driving", href: "/car-maintenance-dubai" },
    { icon: "car", name: "Mobile Car Repair Dubai", desc: "On-site diagnostic, battery & basic AC support", href: "/mobile-car-repair-dubai" },
    { icon: "search", name: "Full Car Check Up", desc: "Pre-purchase, electrical, and cooling system inspections", href: "/car-inspection-dubai" },
