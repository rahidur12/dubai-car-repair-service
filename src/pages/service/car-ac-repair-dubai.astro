// ---------------------------------------------------------------------------
// Section Data
// ---------------------------------------------------------------------------
const faults = [
    {
        icon: "snowflake",
        title: "Warm Air from Dashboard Vents",
        desc: "The AC blows ambient or warm air rather than chilled air. This can result from low refrigerant due to a leak, a failing compressor clutch, an electrical switch fault, or a blocked condenser. A diagnostic pressure check identifies the actual cause before replacing parts."
    },
    {
        icon: "wind",
        title: "Weak Airflow from Vents",
        desc: "The blower motor is running, but air volume from the vents feels weak. Common causes include a cabin air filter clogged with desert dust, an obstructed blower motor, or evaporator icing blocking the airflow path."
    },
    {
        icon: "cog",
        title: "Unusual Noises When AC Is Switched On",
        desc: "Rattling, squeaking, or grinding noises when engaging the air conditioning can indicate a slipping serpentine drive belt, a worn compressor clutch pulley, or internal mechanical wear. A physical inspection prevents belt snap or compressor failure."
    },
    {
        icon: "filter",
        title: "Musty or Stale Cabin Odours",
        desc: "A damp or stale smell upon switching on the AC typically indicates bacterial or mould growth on the moist evaporator core surface or an aged cabin air filter. Replacing the filter and cleaning the housing helps restore fresh cabin air."
    },
    {
        icon: "sliders",
        title: "Intermittent Cooling in Traffic",
        desc: "The AC cools while cruising on the highway but blows warm when idling in slow Dubai traffic. This often points to weak condenser cooling fan operation, road debris restricting the condenser fins, or an expansion valve struggling under low-speed loads."
    },
    {
        icon: "drop",
        title: "Water Accumulation in Passenger Footwell",
        desc: "Puddles or dampness inside the cabin usually mean the evaporator condensation drain hose is clogged with dust or algae, causing trapped water to overflow into the passenger floor instead of draining beneath the car."
    }
];

const serviceSteps = [
    {
        num: "1",
        title: "Pressure & Temperature Assessment",
        desc: "We connect digital manifold gauges to monitor high-side and low-side pressures while checking dashboard vent temperatures against ambient conditions."
    },
    {
        num: "2",
        title: "Electronic & UV Leak Detection",
        desc: "If pressures indicate low refrigerant, technicians use electronic leak detectors and UV fluorescent dye to inspect hose connections, condenser fins, compressor seals, and service valves."
    },
    {
        num: "3",
        title: "Transparent Quote Approval",
        desc: "We explain the diagnostic findings and provide an itemized quote for necessary repairs, parts, and refrigerant recharge before any work begins."
    },
    {
        num: "4",
        title: "Vacuum & Moisture Evacuation",
        desc: "We connect a specialized vacuum station to evacuate air and moisture from the sealed circuit, ensuring the system is clean and dry before recharging."
    },
    {
        num: "5",
        title: "Precision Refrigerant Recharge",
        desc: "We recharge the system by weight according to manufacturer specifications (R134a or R1234yf) and add the correct compatible compressor lubricant (such as PAG or POE oil specified for your vehicle)."
    },
    {
        num: "6",
        title: "Cooling Performance Verification",
        desc: "We test the vehicle under operating load to evaluate vent temperature and cooling performance against manufacturer specifications and Dubai ambient temperatures before handover."
    }
];

