const reasons = [
    {
        icon: "search",
        title: "Accurate Diagnostics First",
        desc: "We test operating pressures and inspect for physical leaks before recommending any repair. We focus on identifying the actual root cause rather than replacing parts unnecessarily."
    },
    {
        icon: "snowflake",
        title: "Vehicle-Specified Refrigerants",
        desc: "We confirm your vehicle's factory refrigerant specification (R134a or R1234yf) and charge by precise weight according to manufacturer specifications to protect your compressor."
    },
    {
        icon: "tools",
        title: "Dedicated Al Satwa Workshop",
        desc: "Conveniently located at 222 Al Satwa Road, our garage is equipped with recovery and evacuation stations, manifold gauges, and electronic leak detectors for reliable AC servicing."
    },
    {
        icon: "shield",
        title: "Quality Replacement Parts",
        desc: "We supply OEM-specification compressors, condensers, expansion valves, and cabin filters suited to withstand Dubai's extreme summer temperatures, backed by available parts warranties."
    },
