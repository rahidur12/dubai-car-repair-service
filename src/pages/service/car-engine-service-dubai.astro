        list-style: none;
        padding: 0;
        margin: 0 0 1rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        font-family: var(--font-mono, monospace);
        font-size: 0.82rem;
        color: rgba(251, 249, 244, 0.65);
    }

    .dcrs-breadcrumb li + li::before {
        content: "/";
        margin-right: 0.5rem;
        color: rgba(251, 249, 244, 0.4);
    }

    .dcrs-breadcrumb a {
        color: rgba(251, 249, 244, 0.75);
        text-decoration: none;
    }

    .dcrs-breadcrumb a:hover {
        color: var(--brass);
    }

    .dcrs-badge {
        display: inline-block;
        font-family: var(--font-mono, monospace);
        font-size: 0.78rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--brass);
        font-weight: 600;
        margin-bottom: 0.6rem;
    }

    .dcrs-hero-banner__title {
        font-family: var(--font-display, serif);
        font-size: clamp(1.5rem, 5.5vw, 2.9rem);
        line-height: 1.2;
        letter-spacing: -0.01em;
        margin: 0 0 1rem;
        color: var(--white);
        word-break: break-word;
        overflow-wrap: break-word;
    }

    .dcrs-hero-banner__lead {
        font-size: clamp(0.92rem, 2.6vw, 1.15rem);
        line-height: 1.65;
        color: rgba(251, 249, 244, 0.85);
        word-break: break-word;
        overflow-wrap: break-word;
        margin: 0 0 2rem;
    }

    .dcrs-hero-banner__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.85rem;
        width: 100%;
        box-sizing: border-box;
    }

    @media (max-width: 480px) {
        .dcrs-hero-banner__actions {
            flex-direction: column;
            align-items: stretch;
        }
        .dcrs-hero-banner__actions .dcrs-btn {
            width: 100%;
        }
