</BaseLayout>

<style>
    /* Scoped styling preserving template design tokens */
    :root {
        --ink: #10201F;
        --ink-soft: #1B302E;
        --paper: #E8E4D8;
        --paper-alt: #DFDACB;
        --white: #FBF9F4;
        --brass: #D48E33;
        --brass-deep: #9C6423;
        --steel: #354D4B;
        --rule-on-paper: rgba(16, 32, 31, 0.15);
        --rule-on-ink: rgba(251, 249, 244, 0.16);
    }

    .dcrs-service-page {
        padding-bottom: 0;
        width: 100%;
        max-width: 100%;
        overflow-x: clip;
        box-sizing: border-box;
    }

    @media (min-width: 768px) {
        .dcrs-service-page {
            padding-bottom: 0;
        }
    }

    /* Hide floating WhatsApp button on mobile when sticky bar is active */
    @media (max-width: 767.98px) {
        :global(.float) {
            display: none !important;
        }
    }

    .dcrs-container {
        width: 100%;
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 1.25rem;
        box-sizing: border-box;
    }

    @media (max-width: 480px) {
        .dcrs-container {
            padding: 0 0.85rem;
        }
    }

    /* Kicker & Typography */
    .dcrs-kicker {
        display: inline-block;
        font-family: var(--font-mono, monospace);
        font-size: 0.76rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--brass-deep);
        font-weight: 600;
        margin-bottom: 0.5rem;
        max-width: 100%;
        white-space: normal;
        word-break: break-word;
        box-sizing: border-box;
    }

    .dcrs-heading {
        margin-bottom: 2.5rem;
    }

    .dcrs-heading--center {
        text-align: center;
        max-width: 680px;
        margin-left: auto;
        margin-right: auto;
    }

    .dcrs-heading__title {
        font-family: var(--font-display, serif);
        font-size: clamp(1.65rem, 4.2vw, 2.35rem);
        line-height: 1.2;
        color: var(--ink);
        margin: 0 0 0.6rem;
    }

    .dcrs-heading__sub {
        color: var(--steel);
        font-size: 0.98rem;
        line-height: 1.6;
        margin: 0;
    }

    .dcrs-lead-text {
        font-size: 1.05rem;
        line-height: 1.7;
        color: var(--ink);
        margin: 0 0 1.2rem;
    }

    .dcrs-body-text {
        font-size: 0.96rem;
        line-height: 1.75;
        color: var(--steel);
        margin: 0 0 1.2rem;
    }

    .dcrs-inline-link {
        color: var(--brass-deep);
        font-weight: 600;
        text-decoration: underline;
        text-underline-offset: 3px;
    }

    /* Section Wrappers */
    .dcrs-section {
        padding: clamp(3rem, 6.5vw, 5rem) 0;
    }
    .dcrs-section--paper { background: var(--paper); }
    .dcrs-section--tint { background: var(--paper-alt); }

    /* Buttons */
    .dcrs-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        font-family: var(--font-body, sans-serif);
        font-weight: 600;
        font-size: 0.95rem;
        padding: 0.85rem 1.4rem;
        border-radius: 4px;
        border: 1px solid transparent;
        text-decoration: none;
        line-height: 1;
        cursor: pointer;
        transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
        min-height: 48px;
    }

    .dcrs-btn :global(svg) {
        width: 18px;
        height: 18px;
        flex-shrink: 0;
    }

    .dcrs-btn--solid {
        background: var(--brass);
        color: var(--ink);
    }
    .dcrs-btn--solid:hover {
        background: var(--brass-deep);
        color: #fff;
    }

    .dcrs-btn--outline-ink {
        background: transparent;
        color: var(--ink);
        border-color: var(--ink);
    }
    .dcrs-btn--outline-ink:hover {
        background: var(--ink);
        color: var(--white);
    }

    .dcrs-btn--wa {
        background: #25d366;
        color: #fff;
    }
    .dcrs-btn--wa:hover {
        background: #1ebc59;
    }

    .dcrs-action-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.85rem;
        margin-top: 1.75rem;
    }

    /* 1. Hero Banner */
    .dcrs-hero-banner {
        position: relative;
        background-color: var(--ink);
        color: var(--white);
        padding: clamp(3.5rem, 8vw, 5.5rem) 0;
        overflow: hidden;
        min-height: 500px;
        display: flex;
        align-items: center;
        box-sizing: border-box;
