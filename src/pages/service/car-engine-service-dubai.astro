    description={pageDescription}
>
    <!-- Structured JSON-LD Schema Graph -->
    <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

    <main class="dcrs-service-page">

        <!-- 1. HERO BANNER --------------------------------------------------->
        <header class="dcrs-hero-banner">
            <div class="dcrs-hero-banner__scrim"></div>
            <div class="dcrs-container dcrs-hero-banner__inner">
                <nav class="dcrs-breadcrumb" aria-label="Breadcrumb">
                    <ol>
                        <li><a href="/">Home</a></li>
                        <li><a href="/#service">Services</a></li>
                        <li aria-current="page">Car Engine Service Dubai</li>
                    </ol>
                </nav>
                <span class="dcrs-badge">Al Satwa, Dubai · Petrol, Diesel &amp; Hybrid · All Makes &amp; Models</span>
                <h1 class="dcrs-hero-banner__title">
                    Car Engine Repair Dubai - Diagnostics, Rebuilds &amp; Overhauls
                </h1>
                <p class="dcrs-hero-banner__lead">
                    Looking for certified car engine repair in Dubai? From check engine light diagnostics and timing chain fixes to complete engine overhauls, our master mechanics at 222 Al Satwa Road handle all petrol, hybrid, and diesel engines. Diagnostics from AED 100. Open daily 7 AM to 10 PM.
                </p>
                <div class="dcrs-hero-banner__actions">
                    <a href={phoneHref} class="dcrs-btn dcrs-btn--solid">
                        <Fragment set:html={icons.phone} /> Call {phoneDisplay}
                    </a>
                    <a href={waHref} target="_blank" rel="noopener noreferrer" class="dcrs-btn dcrs-btn--wa">
                        <Fragment set:html={icons.chat} /> WhatsApp Us
                    </a>
                </div>
            </div>
        </header>

        <!-- 2. INTRO SECTION ------------------------------------------------->
        <section class="dcrs-section dcrs-section--paper" id="service-overview">
            <div class="dcrs-container">
                <div class="dcrs-grid-2col dcrs-grid-2col--align-center">
                    
                    <div class="dcrs-intro-content">
                        <div class="dcrs-kicker">Service Overview</div>
                        <h2 class="dcrs-heading__title">
                            Car Engine Repair Dubai - Diagnostics, Mechanical Care &amp; Overhauls
                        </h2>
                        <p class="dcrs-lead-text">
                            Operating an internal combustion or diesel engine in Dubai subjects mechanical assemblies, rubber seals, and cooling circuits to sustained extreme temperatures. When ambient heat regularly exceeds 45°C, engine oil breaks down faster, cooling system pressures run near maximum thresholds, and rubber gaskets lose elasticity. At <a href="/" class="dcrs-inline-link">Dubai Car Repair Service</a>, we deliver specialized petrol and diesel engine care tailored to UAE conditions. If you notice unusual noises or warning lights, <a href="/contact" class="dcrs-inline-link">contact us</a> for a prompt consultation.
                        </p>
                        <p class="dcrs-body-text">
                            Every mechanical evaluation begins with an advanced OBD-II computer scan before disassembling any parts. Before scheduling a major overhaul, routine preventive maintenance such as a timely <a href="/engine-oil-change-dubai" class="dcrs-inline-link">engine oil change in Dubai</a> and disciplined <a href="/car-maintenance-dubai" class="dcrs-inline-link">car servicing in Dubai</a> can protect internal bearings from catastrophic thermal wear.
                        </p>
                        <p class="dcrs-body-text">
                            If your car suddenly overheats or stalls on the road, our rapid <a href="/roadside-assistance-dubai" class="dcrs-inline-link">car breakdown service in Dubai</a> provides immediate towing to our 222 Al Satwa Road garage. For minor on-site sensor replacements and diagnostic checks, our <a href="/mobile-car-repair-dubai" class="dcrs-inline-link">mobile car mechanic in Dubai</a> is on standby. And if you are purchasing a pre-owned vehicle, booking a comprehensive <a href="/car-inspection-dubai" class="dcrs-inline-link">vehicle inspection in Dubai</a> helps you uncover hidden engine trouble before signing.
                        </p>

                        <div class="dcrs-action-row">
                            <a href={phoneHref} class="dcrs-btn dcrs-btn--solid">
                                <Fragment set:html={icons.phone} /> Call Mechanic
                            </a>
                            <a href="/contact" class="dcrs-btn dcrs-btn--outline-ink">
                                Book Engine Diagnostic <Fragment set:html={icons.arrowRight} />
                            </a>
                        </div>
                    </div>

                    <div class="dcrs-intro-media">
                        <div class="dcrs-intro-media__frame">
                            <img
                                src={service2Image.src}
                                alt="Technician performing car engine repair in Dubai with diagnostic scanner at Al Satwa garage"
                                loading="eager"
                                width="600"
                                height="400"
                            />
                            <div class="dcrs-plate dcrs-price-badge" aria-hidden="true">
                                <div class="dcrs-plate__tab">AED</div>
                                <div class="dcrs-plate__body">
                                    <span class="dcrs-plate__row dcrs-plate__row--big">150+</span>
                                    <span class="dcrs-plate__row">ENGINE SERVICE FROM</span>
                                    <span class="dcrs-plate__row">FULL OBD-II SCAN</span>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- 3. ENGINE SERVICE TYPES ------------------------------------------>
        <section class="dcrs-section dcrs-section--tint" id="services-list">
            <div class="dcrs-container">
                <div class="dcrs-heading dcrs-heading--center">
                    <div class="dcrs-kicker">Engine Services</div>
                    <h2 class="dcrs-heading__title">
                        Engine Services We Provide in Dubai
                    </h2>
                    <p class="dcrs-heading__sub">
                        From routine preventative tune-ups to major internal mechanical overhauls -every repair is guided by accurate diagnostic data.
                    </p>
                </div>

                <div class="dcrs-services-grid">
                    {engineServices.map((s) => (
                        <div class="dcrs-service-card">
                            <div class="dcrs-service-card__head">
                                <span class="dcrs-service-card__icon">
                                    <Fragment set:html={icons[s.icon]} />
                                </span>
                                <div>
                                    <h3 class="dcrs-service-card__title">{s.title}</h3>
                                    <span class="dcrs-service-card__price">{s.price}</span>
                                </div>
                            </div>
                            <p class="dcrs-service-card__desc">{s.desc}</p>
                            <div class="dcrs-service-card__tags">
                                {s.tags.map((tag) => (
                                    <span class="dcrs-tag">{tag}</span>
                                ))}
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- 4. WARNING SIGNS & DIAGNOSTIC PROCESS ---------------------------->
        <section class="dcrs-section dcrs-section--paper" id="process">
            <div class="dcrs-container">
                <div class="dcrs-grid-2col">

                    <!-- Left: Warning Signs -->
                    <div class="dcrs-warnings-block">
                        <div class="dcrs-kicker">Warning Signs</div>
                        <h2 class="dcrs-heading__title">
                            Engine Warning Signs Dubai Drivers Should Never Ignore
                        </h2>
                        
                        <div class="dcrs-warning-items">
                            {warningSigns.map((w) => (
                                <div class="dcrs-warning-item">
                                    <span class="dcrs-warning-item__icon">
                                        <Fragment set:html={icons[w.icon]} />
                                    </span>
                                    <div>
                                        <h3 class="dcrs-warning-item__title">{w.title}</h3>
                                        <p class="dcrs-warning-item__desc">{w.desc}</p>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>

                    <!-- Right: Diagnostic Process -->
                    <div class="dcrs-process-block">
                        <div class="dcrs-kicker">Our Diagnostic Process</div>
                        <h2 class="dcrs-heading__title">
                            How We Diagnose Engine Problems in Dubai
                        </h2>

                        <div class="dcrs-process-list">
                            {diagnosticSteps.map((step) => (
                                <div class="dcrs-process-item">
                                    <div class="dcrs-process-item__num">{step.num}</div>
                                    <div class="dcrs-process-item__body">
                                        <h4>{step.title}</h4>
                                        <p>{step.desc}</p>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- 5. VEHICLES & PRICING -------------------------------------------->
        <section class="dcrs-section dcrs-section--tint" id="pricing">
            <div class="dcrs-container">
                <div class="dcrs-grid-2col">

                    <!-- Left: Engines We Service -->
                    <div class="dcrs-engines-block">
                        <div class="dcrs-kicker">Engines We Service</div>
                        <h2 class="dcrs-heading__title">
                            All Engine Types &amp; Vehicle Brands in Dubai
                        </h2>

                        <div class="dcrs-engines-list">
                            {engineTypes.map((e) => (
                                <div class="dcrs-engine-item">
                                    <span class="dcrs-engine-item__icon"><Fragment set:html={icons.check} /></span>
                                    <div>
                                        <h3 class="dcrs-engine-item__name">{e.name}</h3>
                                        <p class="dcrs-engine-item__desc">{e.desc}</p>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>

                    <!-- Right: Pricing Table -->
                    <div class="dcrs-pricing-block">
                        <div class="dcrs-kicker">Pricing Guide</div>
                        <h2 class="dcrs-heading__title">
                            Engine Service Prices in Dubai
                        </h2>

                        <div class="dcrs-table-wrapper">
                            <table class="dcrs-pricing-table">
                                <thead>
                                    <tr>
                                        <th>Service</th>
                                        <th>Price Range (AED)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {pricingRows.map((r) => (
                                        <tr>
                                            <td class="dcrs-table-service">{r.service}</td>
                                            <td class="dcrs-table-price">{r.price}</td>
                                        </tr>
                                    ))}
                                </tbody>
                            </table>
                        </div>

                        <p class="dcrs-pricing-disclaimer">
                            <Fragment set:html={icons.info} /> Baseline prices shown are estimates covering labour; parts pricing varies according to vehicle make, model, and engine capacity. [CONFIRM: exact engine service pricing and diagnostic fees]. An itemised quotation is confirmed before any repair work begins.
                        </p>
                    </div>

                </div>
            </div>
        </section>

        <!-- 6. WHY CHOOSE US ------------------------------------------------->
        <section class="dcrs-section dcrs-section--paper" id="why-choose-us">
            <div class="dcrs-container">
                <div class="dcrs-heading dcrs-heading--center">
                    <div class="dcrs-kicker">Why Choose Us</div>
                    <h2 class="dcrs-heading__title">Why Dubai Drivers Choose Us for Engine Repairs &amp; Overhauls</h2>
                </div>

                <div class="dcrs-reasons-grid">
                    {reasons.map((r) => (
                        <div class="dcrs-reason-card">
                            <span class="dcrs-reason-card__icon">
                                <Fragment set:html={icons[r.icon]} />
                            </span>
                            <div>
                                <h3 class="dcrs-reason-card__title">{r.title}</h3>
                                <p class="dcrs-reason-card__text">{r.desc}</p>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- 7. FREQUENTLY ASKED QUESTIONS (FAQ) ------------------------------->
        <section class="dcrs-section dcrs-section--tint" id="faq">
            <div class="dcrs-container">
                <div class="dcrs-heading dcrs-heading--center">
                    <div class="dcrs-kicker">FAQ</div>
                    <h2 class="dcrs-heading__title">Car Engine Service Dubai -Common Questions</h2>
                </div>

                <div class="dcrs-faq-accordion">
                    {faqs.map((faq, i) => (
                        <details class="dcrs-faq-item" open={i === 0}>
                            <summary class="dcrs-faq-item__question">
                                <span>{faq.q}</span>
                                <span class="dcrs-faq-item__toggle">
                                    <Fragment set:html={icons.chevronDown} />
                                </span>
                            </summary>
                            <div class="dcrs-faq-item__answer">
                                <p>{faq.a}</p>
                            </div>
                        </details>
                    ))}
                </div>
            </div>
        </section>

        <!-- 8. RELATED SERVICES ---------------------------------------------->
        <section class="dcrs-section dcrs-section--paper" id="related-services">
            <div class="dcrs-container">
                <div class="dcrs-heading dcrs-heading--center">
                    <div class="dcrs-kicker">More Services</div>
                    <h2 class="dcrs-heading__title">Related Services</h2>
                </div>

                <div class="dcrs-related-grid">
                    {relatedServices.map((r) => (
                        <a href={r.href} class="dcrs-related-card">
                            <span class="dcrs-related-card__icon">
                                <Fragment set:html={icons[r.icon]} />
                            </span>
                            <h3 class="dcrs-related-card__title">{r.name}</h3>
                            <p class="dcrs-related-card__desc">{r.desc}</p>
                        </a>
                    ))}
                </div>
            </div>
        </section>

        <!-- 9. CTA BANNER ---------------------------------------------------->
        <section class="dcrs-cta-banner">
            <div class="dcrs-container">
                <div class="dcrs-cta-banner__inner">
                    <div class="dcrs-cta-banner__copy">
                        <span class="dcrs-cta-banner__badge">Al Satwa Workshop</span>
                        <h2 class="dcrs-cta-banner__title">
                            Book Your Car Engine Repair in Dubai Today
                        </h2>
                        <p class="dcrs-cta-banner__sub">
                            Open 7AM–10PM daily · 222 Al Satwa Rd, Dubai · Computer diagnostics, timing belts &amp; complete engine overhauls. <a href="/contact" class="dcrs-cta-inline-link">Contact us online</a> to schedule a diagnostic.
                        </p>
                    </div>
                    <div class="dcrs-cta-banner__actions">
                        <a href={phoneHref} class="dcrs-btn dcrs-btn--solid">
                            <Fragment set:html={icons.phone} /> Call {phoneDisplay}
                        </a>
                        <a href={waHref} target="_blank" rel="noopener noreferrer" class="dcrs-btn dcrs-btn--wa">
                            <Fragment set:html={icons.chat} /> WhatsApp
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- 10. BOTTOM STICKY MOBILE BAR ------------------------------------->
        <div class="dcrs-stickybar">
            <a href={phoneHref} class="dcrs-btn dcrs-btn--solid dcrs-stickybar__btn">
                <Fragment set:html={icons.phone} /> Call Now
            </a>
            <a href={waHref} target="_blank" rel="noopener noreferrer" class="dcrs-btn dcrs-btn--solid dcrs-stickybar__btn dcrs-stickybar__btn--wa">
                <Fragment set:html={icons.chat} /> WhatsApp
            </a>
        </div>

    </main>
</BaseLayout>

<style>
    /* Scoped styling preserving template design tokens */
    :root {
        --ink: #10201F;
        --ink-soft: #1B302E;
        --paper: #E8E4D8;
        --paper-alt: #DFDACB;
        --white: #FBF9F4;
        --brass: #D48E33;
        --brass-deep: #9C6423;
        --steel: #354D4B;
        --rule-on-paper: rgba(16, 32, 31, 0.15);
        --rule-on-ink: rgba(251, 249, 244, 0.16);
    }

    .dcrs-service-page {
        padding-bottom: 0;
        width: 100%;
        max-width: 100%;
        overflow-x: clip;
        box-sizing: border-box;
    }

    @media (min-width: 768px) {
        .dcrs-service-page {
            padding-bottom: 0;
        }
    }

    /* Hide floating WhatsApp button on mobile when sticky bar is active */
    @media (max-width: 767.98px) {
        :global(.float) {
            display: none !important;
        }
    }

    .dcrs-container {
        width: 100%;
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 1.25rem;
        box-sizing: border-box;
    }

    @media (max-width: 480px) {
        .dcrs-container {
            padding: 0 0.85rem;
        }
    }

    /* Kicker & Typography */
    .dcrs-kicker {
        display: inline-block;
        font-family: var(--font-mono, monospace);
        font-size: 0.76rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--brass-deep);
        font-weight: 600;
        margin-bottom: 0.5rem;
        max-width: 100%;
        white-space: normal;
        word-break: break-word;
        box-sizing: border-box;
    }

    .dcrs-heading {
        margin-bottom: 2.5rem;
    }

    .dcrs-heading--center {
        text-align: center;
        max-width: 680px;
        margin-left: auto;
        margin-right: auto;
    }

    .dcrs-heading__title {
        font-family: var(--font-display, serif);
        font-size: clamp(1.65rem, 4.2vw, 2.35rem);
        line-height: 1.2;
        color: var(--ink);
        margin: 0 0 0.6rem;
    }

    .dcrs-heading__sub {
        color: var(--steel);
        font-size: 0.98rem;
        line-height: 1.6;
        margin: 0;
    }

    .dcrs-lead-text {
        font-size: 1.05rem;
        line-height: 1.7;
        color: var(--ink);
        margin: 0 0 1.2rem;
    }

    .dcrs-body-text {
        font-size: 0.96rem;
        line-height: 1.75;
        color: var(--steel);
        margin: 0 0 1.2rem;
    }

    .dcrs-inline-link {
        color: var(--brass-deep);
        font-weight: 600;
        text-decoration: underline;
        text-underline-offset: 3px;
    }

    /* Section Wrappers */
    .dcrs-section {
        padding: clamp(3rem, 6.5vw, 5rem) 0;
    }
    .dcrs-section--paper { background: var(--paper); }
    .dcrs-section--tint { background: var(--paper-alt); }

    /* Buttons */
    .dcrs-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        font-family: var(--font-body, sans-serif);
        font-weight: 600;
        font-size: 0.95rem;
        padding: 0.85rem 1.4rem;
        border-radius: 4px;
        border: 1px solid transparent;
        text-decoration: none;
        line-height: 1;
        cursor: pointer;
        transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
        min-height: 48px;
    }

    .dcrs-btn :global(svg) {
        width: 18px;
        height: 18px;
        flex-shrink: 0;
    }

    .dcrs-btn--solid {
        background: var(--brass);
        color: var(--ink);
    }
    .dcrs-btn--solid:hover {
        background: var(--brass-deep);
        color: #fff;
    }

    .dcrs-btn--outline-ink {
        background: transparent;
        color: var(--ink);
        border-color: var(--ink);
    }
    .dcrs-btn--outline-ink:hover {
        background: var(--ink);
        color: var(--white);
    }

    .dcrs-btn--wa {
        background: #25d366;
        color: #fff;
    }
    .dcrs-btn--wa:hover {
        background: #1ebc59;
    }

    .dcrs-action-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.85rem;
        margin-top: 1.75rem;
    }

    /* 1. Hero Banner */
    .dcrs-hero-banner {
        position: relative;
        background-color: var(--ink);
        color: var(--white);
        padding: clamp(3.5rem, 8vw, 5.5rem) 0;
        overflow: hidden;
        min-height: 500px;
        display: flex;
        align-items: center;
        box-sizing: border-box;
    }

    @media (max-width: 767.98px) {
        .dcrs-hero-banner {
            min-height: auto;
            padding: clamp(3rem, 7vw, 4rem) 0;
        }
    }

    .dcrs-hero-banner .dcrs-container {
        width: 100%;
    }

    .dcrs-hero-banner__scrim {
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 80% 20%, rgba(193, 128, 46, 0.15), transparent 50%);
        pointer-events: none;
    }

    .dcrs-hero-banner__inner {
        position: relative;
        z-index: 1;
        max-width: 820px;
    }

    .dcrs-breadcrumb ol {
        list-style: none;
        padding: 0;
        margin: 0 0 1rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        font-family: var(--font-mono, monospace);
        font-size: 0.82rem;
        color: rgba(251, 249, 244, 0.65);
    }

    .dcrs-breadcrumb li + li::before {
        content: "/";
        margin-right: 0.5rem;
        color: rgba(251, 249, 244, 0.4);
    }

    .dcrs-breadcrumb a {
        color: rgba(251, 249, 244, 0.75);
        text-decoration: none;
    }

    .dcrs-breadcrumb a:hover {
        color: var(--brass);
    }

    .dcrs-badge {
        display: inline-block;
        font-family: var(--font-mono, monospace);
        font-size: 0.78rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--brass);
        font-weight: 600;
        margin-bottom: 0.6rem;
    }

    .dcrs-hero-banner__title {
        font-family: var(--font-display, serif);
        font-size: clamp(1.5rem, 5.5vw, 2.9rem);
        line-height: 1.2;
        letter-spacing: -0.01em;
        margin: 0 0 1rem;
        color: var(--white);
        word-break: break-word;
        overflow-wrap: break-word;
    }

    .dcrs-hero-banner__lead {
        font-size: clamp(0.92rem, 2.6vw, 1.15rem);
        line-height: 1.65;
        color: rgba(251, 249, 244, 0.85);
        word-break: break-word;
        overflow-wrap: break-word;
        margin: 0 0 2rem;
    }

    .dcrs-hero-banner__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.85rem;
        width: 100%;
        box-sizing: border-box;
    }

    @media (max-width: 480px) {
        .dcrs-hero-banner__actions {
            flex-direction: column;
            align-items: stretch;
        }
        .dcrs-hero-banner__actions .dcrs-btn {
            width: 100%;
        }
    }

    /* 2. Grid Layouts */
    .dcrs-grid-2col {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 2.5rem;
        width: 100%;
    }

    .dcrs-grid-2col > * {
        min-width: 0;
        max-width: 100%;
    }

    @media (min-width: 992px) {
        .dcrs-grid-2col {
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
            gap: 3.5rem;
        }
    }

    .dcrs-grid-2col--align-center {
        align-items: center;
    }

    /* Media Frame & Price Badge */
    .dcrs-intro-media__frame {
        position: relative;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid var(--rule-on-paper);
        box-shadow: 0 8px 24px rgba(16, 32, 31, 0.08);
    }

    .dcrs-intro-media__frame img {
        width: 100%;
        height: auto;
        display: block;
        object-fit: cover;
        aspect-ratio: 4 / 3;
    }

    .dcrs-plate {
        display: flex;
        background: var(--white);
        color: var(--ink);
        border-radius: 6px;
        overflow: hidden;
        box-shadow: 0 12px 28px rgba(16, 32, 31, 0.16);
    }

    .dcrs-price-badge {
        position: absolute;
        bottom: 1.25rem;
        right: 1.25rem;
        z-index: 2;
    }

    .dcrs-plate__tab {
        background: var(--brass);
        color: var(--ink);
        font-family: var(--font-mono, monospace);
        font-weight: 700;
        font-size: 0.72rem;
        writing-mode: vertical-rl;
        text-orientation: mixed;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0.5rem 0.4rem;
        letter-spacing: 0.05em;
    }

    .dcrs-plate__body {
        padding: 0.75rem 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        font-family: var(--font-mono, monospace);
    }

    .dcrs-plate__row {
        font-size: 0.72rem;
        letter-spacing: 0.02em;
