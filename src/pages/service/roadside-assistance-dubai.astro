const emergencyServices = [
    {
        icon: "battery",
        title: "Battery Jump Start & Replacement",
        desc: "Rapid response for dead batteries caused by extreme Dubai heat or prolonged accessory drain. We use voltage-regulated booster packs to prevent voltage spikes to vehicle electronics. We perform on-site digital conductance load testing, and if the battery is depleted beyond recovery, we carry and install compatible AGM, EFB, or flooded batteries on the spot.",
