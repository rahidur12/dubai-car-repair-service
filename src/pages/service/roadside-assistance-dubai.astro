<BaseLayout
    title={pageTitle}
    description={pageDescription}
>
    <!-- Structured JSON-LD Schema Graph -->
    <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

    <main class="dcrs-service-page">

        <!-- 1. HERO / OPENING ------------------------------------------------>
        <header class="dcrs-hero-banner">
            <div class="dcrs-hero-banner__scrim"></div>
            <div class="dcrs-container dcrs-hero-banner__inner">
                <nav class="dcrs-breadcrumb" aria-label="Breadcrumb">
                    <ol>
                        <li><a href="/">Home</a></li>
                        <li><a href="/#service">Services</a></li>
                        <li aria-current="page">Roadside Assistance Dubai</li>
                    </ol>
                </nav>
                <span class="dcrs-badge">Emergency Service · 30-Min Response · All Areas</span>
                <h1 class="dcrs-hero-banner__title">
                    Roadside Assistance Dubai - 30-Min Emergency Breakdown Help
                </h1>
                <p class="dcrs-hero-banner__lead">
                    Experiencing a roadside breakdown, dead battery, or sudden tyre failure on Dubai motorways can pose severe safety risks under extreme ambient heat. Our roadside assistance in Dubai provides professional emergency mechanical triage, high-output battery jump starts, mobile tyre replacements, emergency fuel delivery, and flatbed recovery coordination. Operating from our central Al Satwa workshop, our emergency response mechanics reach key highways and urban districts with fast and affordable pricing.
                </p>
                <div class="dcrs-hero-banner__actions">
                    <a href={phoneHref} class="dcrs-btn dcrs-btn--solid">
                        <Fragment set:html={icons.phone} /> Call Now - {phoneDisplay}
                    </a>
                    <a href={waHref} target="_blank" rel="noopener noreferrer" class="dcrs-btn dcrs-btn--wa">
                        <Fragment set:html={icons.chat} /> WhatsApp Emergency
                    </a>
                </div>
            </div>
        </header>

        <!-- 2. SERVICE OVERVIEW ---------------------------------------------->
        <section class="dcrs-section dcrs-section--paper" id="service-overview">
            <div class="dcrs-container">
                <div class="dcrs-grid-2col dcrs-grid-2col--align-center">
                    <div class="dcrs-intro-content">
                        <div class="dcrs-kicker">Service Overview</div>
                        <h2 class="dcrs-heading__title">
                            Roadside Assistance Dubai - Rapid Mechanical Triage &amp; Emergency Recovery
                        </h2>
                        <p class="dcrs-lead-text">
                            Automotive breakdowns on major UAE transport corridors such as Sheikh Zayed Road, Al Khail Road, and Mohammed Bin Zayed Road demand rapid, disciplined response. High surface road temperatures accelerate rubber blowout risks, alternator diode failure, and engine coolant loss. When your vehicle becomes disabled in a live traffic lane, hard shoulder, or underground parking facility, our primary objective is to restore vehicle mobility safely on-site or transport it securely to our garage.
                        </p>
                        <p class="dcrs-body-text">
                            Dispatched from 222 Al Satwa Road, our emergency roadside technicians arrive in fully equipped support vehicles carrying industrial 12V/24V jump-start power packs, digital conductance testers, heavy-duty jacks, and air compressors. Our priority is resolving issues on the spot—whether installing an on-site <a href="/car-battery-replacement-dubai" class="dcrs-inline-link">replacement car battery</a>, fitting your spare wheel, or delivering emergency fuel. If your vehicle has experienced mechanical overheating or internal component seizure, we can coordinate secure flatbed transport to our workshop for comprehensive <a href="/car-engine-service-dubai" class="dcrs-inline-link">engine repairs</a>.
                        </p>
                        <p class="dcrs-body-text">
                            We operate seven days a week, from 7:00 AM to 10:00 PM, covering all major Dubai residential and commercial districts. Every dispatch is backed by transparent pricing agreed upon before the technician is mobilized, eliminating predatory roadside markups. For general service inquiries or to schedule non-emergency mobile maintenance, contact our <a href="/contact" class="dcrs-inline-link">central dispatch desk</a>.
                        </p>

                        <div class="dcrs-action-row">
                            <a href={phoneHref} class="dcrs-btn dcrs-btn--solid">
                                <Fragment set:html={icons.phone} /> Call Dispatch
                            </a>
                            <a href={waHref} target="_blank" rel="noopener noreferrer" class="dcrs-btn dcrs-btn--wa">
                                <Fragment set:html={icons.chat} /> Share Live Location
                            </a>
                        </div>
                    </div>

                    <div class="dcrs-intro-visual">
                        <div class="dcrs-photo-card">
                            <img
                                src={service10Image.src}
                                alt="Emergency roadside assistance technician in Dubai connecting heavy-duty booster cables"
                                width="600"
                                height="400"
                                loading="eager"
                                class="dcrs-photo-card__img"
                            />
                            <div class="dcrs-photo-badge">
                                <div class="dcrs-photo-badge__value">AED 60+</div>
                                <div class="dcrs-photo-badge__label">Jump Start From</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 3. PRICING AND COST FACTORS -------------------------------------->
        <section class="dcrs-section dcrs-section--tint" id="pricing">
            <div class="dcrs-container">
                <div class="dcrs-heading dcrs-heading--center">
                    <div class="dcrs-kicker">Fast and Affordable Pricing</div>
                    <h2 class="dcrs-heading__title">Roadside Assistance Pricing &amp; Emergency Rates</h2>
                    <p class="dcrs-heading__sub">
                        Transparent pricing confirmed before dispatch. No surge pricing, hidden roadside fees, or unexpected call-out penalties.
                    </p>
                </div>

                <div class="dcrs-services-grid">
                    {emergencyServices.map((s) => (
                        <div class="dcrs-service-item-card">
                            <div class="dcrs-service-item-card__head">
                                <span class="dcrs-service-item-card__icon">
                                    <Fragment set:html={icons[s.icon]} />
                                </span>
                                <div>
                                    <h3 class="dcrs-service-item-card__title">{s.title}</h3>
                                    <span class="dcrs-service-item-card__price">{s.price}</span>
                                </div>
                            </div>
                            <p class="dcrs-service-item-card__desc">{s.desc}</p>
                            <span class="dcrs-service-item-card__time">Target Response: {s.eta}</span>
                        </div>
                    ))}
                </div>

                <p class="dcrs-pricing-disclaimer">
                    <Fragment set:html={icons.info} /> Rates cover daytime emergency dispatch across central Dubai (Al Satwa, Jumeirah, Business Bay, DIFC, SZR). Towing rates reflect transport within Dubai municipality limits. Fuel delivery is charged for fuel cost at standard ENOC pump rates plus delivery fee.
                </p>
            </div>
        </section>

        <!-- 4. SERVICE PROCESS ----------------------------------------------->
        <section class="dcrs-section dcrs-section--paper" id="process">
            <div class="dcrs-container">
                <div class="dcrs-heading dcrs-heading--center">
                    <div class="dcrs-kicker">Emergency Workflow</div>
                    <h2 class="dcrs-heading__title">Our Emergency Breakdown &amp; Triage Protocol</h2>
                    <p class="dcrs-heading__sub">
                        A structured safety workflow designed to protect passengers, secure the vehicle, and restore mobility quickly.
                    </p>
                </div>

                <div class="dcrs-steps-grid">
                    <div class="dcrs-step-card">
                        <span class="dcrs-step-card__num">1</span>
                        <h3 class="dcrs-step-card__title">Safety First &amp; Pin Sharing</h3>
                        <p class="dcrs-step-card__desc">Move vehicle to hard shoulder or safe parking, activate hazard flashers, and share your live WhatsApp GPS pin with our dispatch team.</p>
                    </div>
                    <div class="dcrs-step-card">
                        <span class="dcrs-step-card__num">2</span>
                        <h3 class="dcrs-step-card__title">Technician Mobilization &amp; ETA</h3>
                        <p class="dcrs-step-card__desc">Our nearest response van is mobilized immediately with exact arrival estimates communicated directly via phone or WhatsApp.</p>
                    </div>
                    <div class="dcrs-step-card">
                        <span class="dcrs-step-card__num">3</span>
                        <h3 class="dcrs-step-card__title">On-Site Triage &amp; Repair</h3>
                        <p class="dcrs-step-card__desc">Our mechanic conducts safety cone setup, performs digital diagnostics, and carries out immediate repair (jump start, tyre, fuel).</p>
                    </div>
                    <div class="dcrs-step-card">
                        <span class="dcrs-step-card__num">4</span>
                        <h3 class="dcrs-step-card__title">Verification or Flatbed Recovery</h3>
                        <p class="dcrs-step-card__desc">We verify alternator charging and starting reliability, or coordinate direct flatbed recovery to our 222 Al Satwa Road workshop.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- 5. TYPES, PARTS, PRODUCTS AND BRANDS ----------------------------->
        <section class="dcrs-section dcrs-section--tint" id="services-covered">
            <div class="dcrs-container">
                <div class="dcrs-heading dcrs-heading--center">
                    <div class="dcrs-kicker">Capabilities &amp; Equipment</div>
                    <h2 class="dcrs-heading__title">Roadside Services &amp; Equipment We Carry</h2>
                    <p class="dcrs-heading__sub">
                        Our roadside vans carry heavy-duty industrial equipment capable of servicing all vehicle makes and powertrains.
                    </p>
                </div>

                <div class="dcrs-breakdown-details-grid">
                    <div class="dcrs-breakdown-card">
                        <h3 class="dcrs-breakdown-card__title">Heavy-Duty Booster Power Packs</h3>
                        <p class="dcrs-breakdown-card__desc">Multi-volt surge-protected jump starters suitable for high-compression V8 petrol, diesel, and sensitive hybrid computer architectures.</p>
                    </div>
                    <div class="dcrs-breakdown-card">
                        <h3 class="dcrs-breakdown-card__title">Pneumatic Jacks &amp; Torque Wrenches</h3>
                        <p class="dcrs-breakdown-card__desc">Low-clearance hydraulic jacks and precision torque tools for safe tyre changes on luxury sedans, sports cars, and heavy 4x4 SUVs.</p>
                    </div>
                    <div class="dcrs-breakdown-card">
                        <h3 class="dcrs-breakdown-card__title">Handheld OBD-II Diagnostic Scanners</h3>
                        <p class="dcrs-breakdown-card__desc">Instant readout of immobilizer, transmission, ignition, and fuel pressure codes to identify why an engine shut off unexpectedly.</p>
                    </div>
                    <div class="dcrs-breakdown-card">
                        <h3 class="dcrs-breakdown-card__title">Dedicated Flatbed Recovery Units</h3>
                        <p class="dcrs-breakdown-card__desc">Safe winch-equipped recovery carriers for vehicles with locked transmissions, broken steering racks, or severe collision damage.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- 6. SIGNS YOU NEED THIS SERVICE ----------------------------------->
        <section class="dcrs-section dcrs-section--paper" id="breakdown-hotspots">
            <div class="dcrs-container">
                <div class="dcrs-heading dcrs-heading--center">
                    <div class="dcrs-kicker">Hotspots &amp; Safety Steps</div>
                    <h2 class="dcrs-heading__title">Dubai Breakdown Hotspots &amp; Immediate Safety</h2>
                    <p class="dcrs-heading__sub">
                        High-traffic corridors where our rescue vehicles maintain active patrol and rapid dispatch readiness.
                    </p>
                </div>

                <div class="dcrs-grid-2col">
                    <div class="dcrs-hotspots-card">
                        <h3 class="dcrs-hotspots-card__title">Frequent Highway Breakdown Points</h3>
                        <div class="dcrs-hotspots-list">
                            {breakdownHotspots.map((h) => (
                                <div class="dcrs-hotspot-item">
                                    <div class="dcrs-hotspot-item__header">
                                        <h4 class="dcrs-hotspot-item__name">{h.name}</h4>
                                        <span class="dcrs-hotspot-item__time">{h.time}</span>
                                    </div>
                                    <p class="dcrs-hotspot-item__desc">{h.desc}</p>
                                </div>
                            ))}
                        </div>
                    </div>

                    <div class="dcrs-safety-card">
                        <h3 class="dcrs-safety-card__title">3 Immediate Actions When Stranded</h3>
                        <div class="dcrs-safety-steps">
                            {immediateSteps.map((st) => (
                                <div class="dcrs-safety-step-item">
                                    <span class="dcrs-safety-step-num">Step {st.num}</span>
                                    <div>
                                        <h4 class="dcrs-safety-step-title">{st.title}</h4>
                                        <p class="dcrs-safety-step-desc">{st.desc}</p>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 7. WHY CHOOSE DUBAI CAR REPAIR SERVICE? -------------------------->
        <section class="dcrs-section dcrs-section--tint" id="why-choose-us">
            <div class="dcrs-container">
                <div class="dcrs-heading dcrs-heading--center">
                    <div class="dcrs-kicker">Why Choose Us</div>
                    <h2 class="dcrs-heading__title">Why Dubai Drivers Trust Our Roadside Team</h2>
                    <p class="dcrs-heading__sub">12+ years of independent workshop experience, qualified mechanics, and fast and affordable pricing.</p>
                </div>

                <div class="dcrs-reasons-grid">
                    {whyChooseUs.map((r) => (
                        <div class="dcrs-reason-card">
                            <span class="dcrs-reason-card__icon">
                                <Fragment set:html={icons[r.icon]} />
                            </span>
                            <div>
                                <h3 class="dcrs-reason-card__title">{r.title}</h3>
                                <p class="dcrs-reason-card__text">{r.desc}</p>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- 8. FREQUENTLY ASKED QUESTIONS (FAQ) ----------------------------->
        <section class="dcrs-section dcrs-section--paper" id="faq">
            <div class="dcrs-container">
                <div class="dcrs-heading dcrs-heading--center">
                    <div class="dcrs-kicker">FAQ</div>
                    <h2 class="dcrs-heading__title">Roadside Assistance Dubai - Frequently Asked Questions</h2>
                </div>

                <div class="dcrs-faq-accordion">
                    {faqs.map((faq, i) => (
                        <details class="dcrs-faq-item" open={i === 0}>
                            <summary class="dcrs-faq-item__question">
                                <span>{faq.q}</span>
                                <span class="dcrs-faq-item__toggle">
                                    <Fragment set:html={icons.chevronDown} />
                                </span>
                            </summary>
                            <div class="dcrs-faq-item__answer">
                                <p>{faq.a}</p>
                            </div>
                        </details>
                    ))}
                </div>
            </div>
        </section>

        <!-- 9. RELATED SERVICES ---------------------------------------------->
        <section class="dcrs-section dcrs-section--tint" id="related-services">
            <div class="dcrs-container">
                <div class="dcrs-heading dcrs-heading--center">
                    <div class="dcrs-kicker">More Services</div>
                    <h2 class="dcrs-heading__title">Related Services You May Need</h2>
                </div>

                <div class="dcrs-related-grid">
                    {relatedServices.map((r) => (
                        <a href={r.href} class="dcrs-related-card">
                            <span class="dcrs-related-card__icon">
                                <Fragment set:html={icons[r.icon]} />
                            </span>
                            <h3 class="dcrs-related-card__title">{r.name}</h3>
                            <p class="dcrs-related-card__desc">{r.desc}</p>
                        </a>
                    ))}
                </div>
            </div>
        </section>

        <!-- 10. FINAL CTA ---------------------------------------------------->
        <section class="dcrs-cta-banner">
            <div class="dcrs-container">
                <div class="dcrs-cta-banner__inner">
                    <div class="dcrs-cta-banner__copy">
                        <span class="dcrs-cta-banner__badge">Emergency Assistance Ready</span>
                        <h2 class="dcrs-cta-banner__title">
                            Broken Down in Dubai? Call Our Emergency Team Now
                        </h2>
                        <p class="dcrs-cta-banner__sub">
                            Fast and affordable pricing with jump starts from AED 60. Open daily 7:00 AM – 10:00 PM. Call or share your WhatsApp location pin for immediate dispatch.
                        </p>
                    </div>
                    <div class="dcrs-cta-banner__actions">
                        <a href={phoneHref} class="dcrs-btn dcrs-btn--solid">
                            <Fragment set:html={icons.phone} /> Call {phoneDisplay}
                        </a>
                        <a href={waHref} target="_blank" rel="noopener noreferrer" class="dcrs-btn dcrs-btn--wa">
                            <Fragment set:html={icons.chat} /> WhatsApp Location
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- 11. BOTTOM STICKY MOBILE BAR ------------------------------------>
        <div class="dcrs-stickybar">
            <a href={phoneHref} class="dcrs-btn dcrs-btn--solid dcrs-stickybar__btn">
                <Fragment set:html={icons.phone} /> Call Now
            </a>
            <a href={waHref} target="_blank" rel="noopener noreferrer" class="dcrs-btn dcrs-btn--solid dcrs-stickybar__btn dcrs-stickybar__btn--wa">
                <Fragment set:html={icons.chat} /> WhatsApp
            </a>
        </div>

    </main>
</BaseLayout>

<style>
    :root {
        --ink: #10201F;
        --ink-soft: #1B302E;
        --paper: #E8E4D8;
        --paper-alt: #DFDACB;
        --white: #FBF9F4;
        --brass: #D48E33;
        --brass-deep: #9C6423;
        --steel: #354D4B;
        --rule-on-paper: rgba(16, 32, 31, 0.15);
        --rule-on-ink: rgba(251, 249, 244, 0.16);
    }

    .dcrs-service-page {
        padding-bottom: 0;
        width: 100%;
        max-width: 100%;
        overflow-x: clip;
        box-sizing: border-box;
    }

    @media (min-width: 768px) {
        .dcrs-service-page {
            padding-bottom: 0;
        }
    }

    /* Hide floating WhatsApp button on mobile when sticky bar is active */
    @media (max-width: 767.98px) {
        :global(.float) {
            display: none !important;
        }
    }

    .dcrs-container {
        width: 100%;
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 1.25rem;
        box-sizing: border-box;
    }

    @media (max-width: 480px) {
        .dcrs-container {
            padding: 0 0.85rem;
        }
    }

    /* Kicker & Typography */
    .dcrs-kicker {
        display: inline-block;
        font-family: var(--font-mono, monospace);
        font-size: 0.76rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--brass-deep);
        font-weight: 600;
        margin-bottom: 0.5rem;
        max-width: 100%;
        white-space: normal;
        word-break: break-word;
        box-sizing: border-box;
    }

    .dcrs-heading {
        margin-bottom: 2.5rem;
    }

    .dcrs-heading--center {
        text-align: center;
        max-width: 680px;
        margin-left: auto;
        margin-right: auto;
    }

    .dcrs-heading__title {
        font-family: var(--font-display, serif);
        font-size: clamp(1.65rem, 4.2vw, 2.35rem);
        line-height: 1.2;
        color: var(--ink);
        margin: 0 0 0.6rem;
        word-break: break-word;
        overflow-wrap: break-word;
    }

    .dcrs-heading__sub {
        color: var(--steel);
        font-size: 0.98rem;
        line-height: 1.6;
        margin: 0;
        word-break: break-word;
        overflow-wrap: break-word;
    }

    .dcrs-lead-text {
        font-size: 1.05rem;
        line-height: 1.7;
        color: var(--ink);
        margin: 0 0 1.2rem;
        word-break: break-word;
        overflow-wrap: break-word;
    }

    .dcrs-body-text {
        font-size: 0.96rem;
        line-height: 1.75;
        color: var(--steel);
        margin: 0 0 1.2rem;
        word-break: break-word;
        overflow-wrap: break-word;
    }

    .dcrs-inline-link {
        color: var(--brass-deep);
        font-weight: 600;
        text-decoration: underline;
        text-underline-offset: 3px;
    }

    /* Section Wrappers */
    .dcrs-section {
        padding: clamp(3rem, 6.5vw, 5rem) 0;
        box-sizing: border-box;
    }
    .dcrs-section--paper { background: var(--paper); }
    .dcrs-section--tint { background: var(--paper-alt); }

    /* Buttons */
    .dcrs-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        font-family: var(--font-body, sans-serif);
        font-weight: 600;
        font-size: 0.95rem;
        padding: 0.85rem 1.4rem;
        border-radius: 4px;
        border: 1px solid transparent;
        text-decoration: none;
        line-height: 1;
        cursor: pointer;
        transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
        min-height: 48px;
        box-sizing: border-box;
    }

    .dcrs-btn :global(svg) {
        width: 18px;
        height: 18px;
        flex-shrink: 0;
    }

    .dcrs-btn--solid {
        background: var(--brass);
        color: var(--ink);
    }
    .dcrs-btn--solid:hover {
        background: var(--brass-deep);
        color: #fff;
    }

    .dcrs-btn--emergency {
        background: #dc3545;
        color: #fff;
        border-color: #dc3545;
    }
    .dcrs-btn--emergency:hover {
        background: #bb2d3b;
        color: #fff;
    }

    .dcrs-btn--wa {
        background: #25d366;
        color: #fff;
    }
    .dcrs-btn--wa:hover {
        background: #1ebc59;
    }

    .dcrs-action-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.85rem;
        margin-top: 1.75rem;
    }

    /* 1. Hero Banner */
    .dcrs-hero-banner {
        position: relative;
        background-color: var(--ink);
        color: var(--white);
        padding: clamp(3.5rem, 8vw, 5.5rem) 0;
        overflow: hidden;
        min-height: 500px;
        display: flex;
        align-items: center;
        box-sizing: border-box;
    }

    @media (max-width: 767.98px) {
        .dcrs-hero-banner {
            min-height: auto;
            padding: clamp(3rem, 7vw, 4rem) 0;
        }
    }

    .dcrs-hero-banner .dcrs-container {
        width: 100%;
    }

    .dcrs-hero-banner__scrim {
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 80% 20%, rgba(193, 128, 46, 0.15), transparent 50%);
        pointer-events: none;
    }

    .dcrs-hero-banner__inner {
        position: relative;
        z-index: 1;
        max-width: 820px;
    }

    .dcrs-breadcrumb ol {
        list-style: none;
        padding: 0;
        margin: 0 0 1rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        font-family: var(--font-mono, monospace);
        font-size: 0.82rem;
        color: rgba(251, 249, 244, 0.65);
    }

    .dcrs-breadcrumb li + li::before {
        content: "/";
        margin-right: 0.5rem;
        color: rgba(251, 249, 244, 0.4);
    }

    .dcrs-breadcrumb a {
        color: rgba(251, 249, 244, 0.75);
        text-decoration: none;
    }

    .dcrs-breadcrumb a:hover {
        color: var(--brass);
    }

    .dcrs-badge {
        display: inline-block;
        font-family: var(--font-mono, monospace);
        font-size: 0.78rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--brass);
        font-weight: 600;
        margin-bottom: 0.6rem;
    }

    .dcrs-hero-banner__title {
        font-family: var(--font-display, serif);
        font-size: clamp(1.5rem, 5.5vw, 2.9rem);
        line-height: 1.2;
        letter-spacing: -0.01em;
        margin: 0 0 1rem;
        color: var(--white);
        word-break: break-word;
        overflow-wrap: break-word;
    }

    .dcrs-hero-banner__lead {
        font-size: clamp(0.92rem, 2.6vw, 1.15rem);
        line-height: 1.65;
        color: rgba(251, 249, 244, 0.85);
        word-break: break-word;
        overflow-wrap: break-word;
        margin: 0 0 2rem;
    }

    .dcrs-hero-banner__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.85rem;
        width: 100%;
        box-sizing: border-box;
    }

    @media (max-width: 480px) {
        .dcrs-hero-banner__actions {
            flex-direction: column;
            align-items: stretch;
        }
        .dcrs-hero-banner__actions .dcrs-btn {
            width: 100%;
        }
    }

    /* 2. Emergency Bar */
    .dcrs-emergency-bar {
        background: #FFF3CD;
        border-top: 3px solid #FFC107;
        border-bottom: 3px solid #FFC107;
        padding: 1.5rem 0;
        box-sizing: border-box;
    }

    .dcrs-emergency-bar__inner {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.25rem;
        align-items: center;
    }

    @media (min-width: 768px) {
        .dcrs-emergency-bar__inner {
            grid-template-columns: auto 1fr auto;
            gap: 1.75rem;
        }
    }

    .dcrs-emergency-bar__icon {
        color: #856404;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .dcrs-emergency-bar__icon :global(svg) {
        width: 42px;
        height: 42px;
