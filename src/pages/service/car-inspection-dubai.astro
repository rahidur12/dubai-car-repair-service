        margin: 0 0 1rem;
        color: var(--white);
        word-break: break-word;
        overflow-wrap: break-word;
    }

    .dcrs-hero-banner__lead {
        font-size: clamp(0.92rem, 2.6vw, 1.15rem);
        line-height: 1.65;
        color: rgba(251, 249, 244, 0.85);
        word-break: break-word;
        overflow-wrap: break-word;
        margin: 0 0 2rem;
    }

    .dcrs-hero-banner__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.85rem;
        width: 100%;
        box-sizing: border-box;
    }

    @media (max-width: 480px) {
        .dcrs-hero-banner__actions {
            flex-direction: column;
            align-items: stretch;
        }
        .dcrs-hero-banner__actions .dcrs-btn {
            width: 100%;
        }
    }

    /* 2. Grid Layouts */
    .dcrs-grid-2col {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 2.5rem;
        width: 100%;
    }

    .dcrs-grid-2col > * {
        min-width: 0;
        max-width: 100%;
    }

    @media (min-width: 992px) {
        .dcrs-grid-2col {
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
            gap: 3.5rem;
        }
    }

    .dcrs-grid-2col--align-center {
        align-items: center;
    }

    .align-start {
        align-items: start;
    }

    /* Media Frame & Price Badge */
    .dcrs-intro-media__frame {
        position: relative;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid var(--rule-on-paper);
        box-shadow: 0 8px 24px rgba(16, 32, 31, 0.08);
    }

    .dcrs-intro-media__frame img {
        width: 100%;
        height: auto;
        display: block;
        object-fit: cover;
        aspect-ratio: 4 / 3;
    }

    .dcrs-plate {
        display: flex;
        background: var(--white);
        color: var(--ink);
        border-radius: 6px;
        overflow: hidden;
        box-shadow: 0 12px 28px rgba(16, 32, 31, 0.16);
    }

    .dcrs-price-badge {
        position: absolute;
        bottom: 1.25rem;
        right: 1.25rem;
        z-index: 2;
    }

    .dcrs-plate__tab {
        background: var(--brass);
        color: var(--ink);
        font-family: var(--font-mono, monospace);
        font-weight: 700;
        font-size: 0.72rem;
        writing-mode: vertical-rl;
        text-orientation: mixed;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0.5rem 0.4rem;
        letter-spacing: 0.05em;
    }

    .dcrs-plate__body {
        padding: 0.75rem 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        font-family: var(--font-mono, monospace);
    }

    .dcrs-plate__row {
        font-size: 0.72rem;
        letter-spacing: 0.02em;
        color: var(--ink-soft);
        font-weight: 600;
    }

    .dcrs-plate__row--big {
        font-size: 1.45rem;
        font-weight: 700;
        color: var(--ink);
        line-height: 1;
    }

    /* 3. Types of Inspection Grid */
    .dcrs-types-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
    }

    @media (min-width: 992px) {
        .dcrs-types-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    .dcrs-type-card {
        background: var(--white);
        border: 1px solid var(--rule-on-paper);
        border-radius: 8px;
        padding: 1.75rem;
        display: flex;
        flex-direction: column;
    }

    .dcrs-type-card__head {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        margin-bottom: 1rem;
    }

    .dcrs-type-card__icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        background: var(--brass);
        color: var(--ink);
        border-radius: 50%;
        flex-shrink: 0;
    }

    .dcrs-type-card__icon :global(svg) {
        width: 24px;
        height: 24px;
    }

    .dcrs-type-card__title {
        font-family: var(--font-display, serif);
        font-size: 1.15rem;
        color: var(--ink);
        margin: 0 0 0.25rem;
    }

    .dcrs-badge-tag,
    .dcrs-type-card__price {
        display: inline-block;
        font-family: var(--font-mono, monospace);
        font-size: 0.72rem;
        background: var(--ink);
        color: var(--white);
        padding: 0.2rem 0.55rem;
        border-radius: 4px;
        font-weight: 600;
        letter-spacing: 0.02em;
    }

    .dcrs-type-card__desc {
        font-size: 0.88rem;
        color: var(--steel);
        line-height: 1.65;
        margin: 0 0 1.25rem;
    }

    .dcrs-type-card__list,
    .dcrs-type-card__bullets {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
        margin-top: auto;
    }

    .dcrs-type-card__list li,
    .dcrs-type-card__bullets li {
        display: flex;
        align-items: flex-start;
        gap: 0.65rem;
        font-size: 0.84rem;
        color: var(--ink-soft);
        line-height: 1.5;
    }

    .dcrs-icon-check {
        color: var(--brass-deep);
        background: rgba(197, 160, 89, 0.15);
        border: 1px solid rgba(197, 160, 89, 0.3);
        border-radius: 50%;
        width: 18px;
        height: 18px;
        flex-shrink: 0;
        margin-top: 0.1rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .dcrs-icon-check :global(svg) {
        width: 10px;
        height: 10px;
        stroke-width: 2.5;
    }

    /* 4. 50-Point Checklist */
    .dcrs-report-card {
        background: var(--ink);
        color: var(--white);
        padding: 1.5rem;
        border-radius: 8px;
        margin-top: 1.5rem;
    }

    .dcrs-report-card__title {
        font-family: var(--font-display, serif);
        font-size: 1.1rem;
        margin: 0 0 0.85rem;
        color: var(--white);
    }

    .dcrs-report-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .dcrs-report-list li {
        display: flex;
        align-items: flex-start;
        gap: 0.55rem;
        font-size: 0.86rem;
        color: rgba(251, 249, 244, 0.88);
        line-height: 1.5;
    }

    .dcrs-report-list :global(svg) {
        width: 14px;
        height: 14px;
        color: var(--brass);
        flex-shrink: 0;
        margin-top: 0.2rem;
    }

    .dcrs-checklist-accordion {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .dcrs-check-item {
        background: var(--white);
        border: 1px solid var(--rule-on-paper);
        border-radius: 6px;
        overflow: hidden;
    }

    .dcrs-check-item[open] {
        border-color: var(--brass);
    }

    .dcrs-check-item__head {
        list-style: none;
        padding: 1.15rem 1.25rem;
        font-family: var(--font-display, serif);
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--ink);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .dcrs-check-item__head::-webkit-details-marker {
        display: none;
    }

    .dcrs-check-item__title {
        display: flex;
        align-items: center;
        gap: 0.65rem;
    }

    .dcrs-check-item__icon {
        color: var(--brass-deep);
        display: inline-flex;
    }

    .dcrs-check-item__icon :global(svg) {
        width: 18px;
        height: 18px;
    }

    .dcrs-check-item__toggle {
        color: var(--brass-deep);
        display: inline-flex;
        transition: transform 0.2s ease;
    }

    .dcrs-check-item__toggle :global(svg) {
        width: 18px;
        height: 18px;
    }

    .dcrs-check-item[open] .dcrs-check-item__toggle {
        transform: rotate(180deg);
    }

    .dcrs-check-item__body {
        padding: 0 1.25rem 1.25rem;
        border-top: 1px solid var(--rule-on-paper);
    }

    .dcrs-points-grid {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-top: 0.85rem;
    }

    .dcrs-point-line {
        display: flex;
        align-items: flex-start;
        gap: 0.55rem;
        font-size: 0.85rem;
        color: var(--ink-soft);
        line-height: 1.5;
        padding-bottom: 0.4rem;
        border-bottom: 1px dashed rgba(16, 32, 31, 0.1);
    }

    .dcrs-point-line:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    /* 5. RTA & Pricing */
    .dcrs-fails-list {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        margin: 1.25rem 0 1.5rem;
    }

    .dcrs-fail-item {
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
        font-size: 0.88rem;
        color: var(--ink-soft);
    }

    .dcrs-fail-item__icon {
        color: #dc2626;
        display: inline-flex;
        flex-shrink: 0;
        margin-top: 0.15rem;
    }

    .dcrs-fail-item__icon :global(svg) {
        width: 16px;
        height: 16px;
    }

    .dcrs-pricing-card {
        background: var(--white);
        border: 1px solid var(--rule-on-paper);
        border-radius: 8px;
        padding: clamp(1.5rem, 3.5vw, 2.25rem);
    }

    .dcrs-pricing-card__title {
        font-family: var(--font-display, serif);
        font-size: 1.35rem;
        margin: 0 0 1.25rem;
        color: var(--ink);
    }

    .dcrs-table-wrapper {
        border: 1px solid var(--rule-on-paper);
        border-radius: 6px;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        width: 100%;
    }

    .dcrs-pricing-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
        font-size: 0.92rem;
    }

    .dcrs-pricing-table thead {
        background: var(--ink);
        color: var(--white);
    }

    .dcrs-pricing-table th {
        padding: 0.9rem 1.15rem;
        font-family: var(--font-mono, monospace);
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 600;
    }

    .dcrs-pricing-table td {
        padding: 0.85rem 1.15rem;
        border-bottom: 1px solid var(--rule-on-paper);
        color: var(--ink-soft);
    }

    .dcrs-pricing-table tr:last-child td {
        border-bottom: none;
    }

    .dcrs-table-service {
        font-weight: 600;
        color: var(--ink);
    }

    .dcrs-table-price {
        font-family: var(--font-mono, monospace);
        font-weight: 600;
        color: var(--brass-deep);
        word-break: normal;
        overflow-wrap: break-word;
    }

    .dcrs-table-duration {
        font-size: 0.85rem;
        color: var(--steel);
    }

    .dcrs-pricing-disclaimer {
        font-size: 0.8rem;
        color: var(--steel);
        display: flex;
        align-items: center;
        gap: 0.4rem;
        line-height: 1.5;
        margin-top: 0.85rem;
    }

    .dcrs-pricing-disclaimer :global(svg) {
        width: 14px;
        height: 14px;
        color: var(--brass-deep);
        flex-shrink: 0;
    }

    /* 6. Why Choose Us */
    .dcrs-reasons-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.25rem;
    }

    @media (min-width: 640px) {
        .dcrs-reasons-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (min-width: 1024px) {
        .dcrs-reasons-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    .dcrs-reason-card {
        background: var(--white);
        border: 1px solid var(--rule-on-paper);
        border-radius: 6px;
        padding: 1.5rem;
        display: flex;
        gap: 1rem;
        align-items: flex-start;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .dcrs-reason-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(16, 32, 31, 0.06);
    }

    .dcrs-reason-card__icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        background: var(--brass);
        color: var(--ink);
        border-radius: 50%;
        flex-shrink: 0;
        margin-top: 0.15rem;
    }

    .dcrs-reason-card__icon :global(svg) {
        width: 20px;
        height: 20px;
    }

    .dcrs-reason-card__title {
        font-family: var(--font-display, serif);
        font-size: 1.12rem;
        color: var(--ink);
        margin: 0 0 0.45rem;
    }

    .dcrs-reason-card__text {
        font-size: 0.88rem;
        color: var(--steel);
        line-height: 1.65;
        margin: 0;
    }

    /* 7. FAQ Accordion */
    .dcrs-faq-accordion {
        max-width: 860px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .dcrs-faq-item {
        background: var(--white);
        border: 1px solid var(--rule-on-paper);
        border-radius: 6px;
        overflow: hidden;
        transition: border-color 0.15s ease;
    }

    .dcrs-faq-item[open] {
        border-color: var(--brass);
    }

    .dcrs-faq-item__question {
        list-style: none;
        padding: 1.15rem 1.35rem;
        font-family: var(--font-display, serif);
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--ink);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .dcrs-faq-item__question::-webkit-details-marker {
        display: none;
    }

    .dcrs-faq-item__toggle {
        display: inline-flex;
        color: var(--brass-deep);
        transition: transform 0.2s ease;
        flex-shrink: 0;
    }

    .dcrs-faq-item__toggle :global(svg) {
        width: 18px;
        height: 18px;
    }

    .dcrs-faq-item[open] .dcrs-faq-item__toggle {
        transform: rotate(180deg);
    }

    .dcrs-faq-item__answer {
        padding: 0 1.35rem 1.25rem;
        border-top: 1px solid var(--rule-on-paper);
    }

    .dcrs-faq-item__answer p {
        margin: 0.85rem 0 0;
        font-size: 0.93rem;
        line-height: 1.7;
        color: var(--steel);
    }

    /* 8. Related Services */
    .dcrs-related-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
    }

    @media (min-width: 640px) {
        .dcrs-related-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (min-width: 1024px) {
        .dcrs-related-grid {
            grid-template-columns: repeat(4, 1fr);
        }
    }

    .dcrs-related-card {
        background: var(--white);
        border: 1px solid var(--rule-on-paper);
        border-radius: 6px;
        padding: 1.5rem 1.25rem;
        text-align: center;
        text-decoration: none;
        display: flex;
        flex-direction: column;
        align-items: center;
        transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
    }

    .dcrs-related-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 18px rgba(16, 32, 31, 0.08);
        border-color: var(--brass);
    }

    .dcrs-related-card__icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        background: var(--paper);
        color: var(--brass-deep);
        border-radius: 50%;
        margin-bottom: 0.85rem;
    }

    .dcrs-related-card__icon :global(svg) {
        width: 22px;
        height: 22px;
    }

    .dcrs-related-card__title {
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--ink);
        margin: 0 0 0.35rem;
    }

    .dcrs-related-card__desc {
        font-size: 0.8rem;
        color: var(--steel);
        line-height: 1.45;
        margin: 0;
    }

    /* 9. CTA Banner */
    .dcrs-cta-banner {
        background: var(--ink);
        color: var(--white);
        padding: clamp(3rem, 6vw, 4.5rem) 0;
    }

    .dcrs-cta-banner__inner {
        display: flex;
        flex-direction: column;
        gap: 1.75rem;
    }

    @media (min-width: 992px) {
        .dcrs-cta-banner__inner {
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
        }
    }

    .dcrs-cta-banner__badge {
        display: inline-block;
        font-family: var(--font-mono, monospace);
        font-size: 0.75rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--brass);
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    .dcrs-cta-banner__title {
        font-family: var(--font-display, serif);
        font-size: clamp(1.6rem, 3.8vw, 2.2rem);
        color: var(--white);
        margin: 0 0 0.5rem;
        line-height: 1.25;
    }

    .dcrs-cta-banner__sub {
        color: rgba(251, 249, 244, 0.75);
        font-size: 0.98rem;
        margin: 0;
    }

    .dcrs-cta-banner__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.85rem;
        flex-shrink: 0;
    }

    /* 10. Sticky Mobile Bar */
    .dcrs-stickybar {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        display: flex;
        gap: 0.5rem;
        padding: 0.6rem 0.75rem;
        background: var(--ink);
        border-top: 1px solid var(--rule-on-ink);
        z-index: 99;
    }

    @media (min-width: 768px) {
        .dcrs-stickybar {
            display: none;
        }
    }

    .dcrs-stickybar__btn {
        flex: 1;
        min-height: 44px;
        font-size: 0.88rem;
        padding: 0.6rem;
    }

    .dcrs-stickybar__btn--wa {
        background: #25d366;
        color: #fff;
    }
    /* Mobile price badge scaling */
    @media (max-width: 480px) {
        .dcrs-price-badge {
            bottom: 0.75rem;
            right: 0.75rem;
            max-width: 175px;
        }
        .dcrs-price-badge .dcrs-plate__tab {
            font-size: 0.65rem;
            padding: 0.4rem 0.35rem;
        }
        .dcrs-price-badge .dcrs-plate__row--big {
            font-size: 1.15rem;
        }
        .dcrs-price-badge .dcrs-plate__row {
            font-size: 0.68rem;
        }
    }
    /* marker: dcrs-price-badge-responsive */

    /* Responsive pricing table font size & compact padding */
    @media (max-width: 768px) {
        .dcrs-pricing-table th {
            padding: 0.75rem 0.85rem;
            font-size: 0.78rem;
        }
        .dcrs-pricing-table td {
            padding: 0.75rem 0.85rem;
            font-size: 0.84rem;
        }
        .dcrs-table-price {
            font-size: 0.82rem;
        }
    }
    @media (max-width: 480px) {
        .dcrs-pricing-table {
            font-size: 0.78rem;
        }
        .dcrs-pricing-table th {
            padding: 0.55rem 0.45rem;
            font-size: 0.68rem;
            letter-spacing: 0.02em;
        }
        .dcrs-pricing-table td {
            padding: 0.55rem 0.45rem;
            font-size: 0.75rem;
            line-height: 1.35;
        }
        .dcrs-table-service {
            font-size: 0.76rem;
        }
        .dcrs-table-price {
            font-size: 0.74rem;
            word-break: normal;
        overflow-wrap: break-word;
        }
        .dcrs-table-duration {
            font-size: 0.72rem;
        }
        .dcrs-pricing-disclaimer {
            font-size: 0.75rem;
        }
    }
    /* marker: dcrs-pricing-table-mobile-text */


    /* Protection against flex/grid item blowout on mobile viewports */
    .dcrs-engine-item,
    .dcrs-warning-item,
    .dcrs-process-step,
    .dcrs-engines-block,
    .dcrs-pricing-block,
    .dcrs-warnings-block,
    .dcrs-process-block,
    .dcrs-col-block,
    .dcrs-intro-content,
    .dcrs-intro-media {
        min-width: 0;
        max-width: 100%;
        box-sizing: border-box;
    }
    .dcrs-engine-item > div,
    .dcrs-warning-item > div,
    .dcrs-process-step > div {
        min-width: 0;
        flex: 1;
    }
    @media (max-width: 480px) {
        .dcrs-heading__title {
            font-size: clamp(1.35rem, 5.5vw, 1.65rem);
            line-height: 1.25;
        }
        .dcrs-engine-item {
            padding: 0.75rem 0.85rem;
            gap: 0.65rem;
        }
        .dcrs-engine-item__name {
            font-size: 0.88rem;
        }
        .dcrs-engine-item__desc {
            font-size: 0.78rem;
            line-height: 1.4;
        }
        .dcrs-table-price,
        .dcrs-table__price,
        .dcrs-price-cell,
        .dcrs-price-tag {
            white-space: normal !important;
            word-break: normal !important;
            overflow-wrap: break-word !important;
        }
    }
    /* marker: .dcrs-flex-overflow-fix */
    .dcrs-cta-inline-link {
        color: var(--brass, #D48E33);
        font-weight: 600;
        text-decoration: underline;
        text-underline-offset: 3px;
    }
    .dcrs-cta-inline-link:hover { opacity: 0.85; }


    /* Missing / Enhanced styles for Steps, Fails Grid, and 3-Col Pricing Table */
    .dcrs-steps-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.25rem;
    }
    @media (min-width: 640px) {
        .dcrs-steps-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    @media (min-width: 1024px) {
        .dcrs-steps-grid {
            grid-template-columns: repeat(4, 1fr);
        }
    }
    .dcrs-step-card {
        background: var(--white);
        border: 1px solid var(--rule-on-paper);
        border-radius: 8px;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
    }
    .dcrs-step-card__num {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        background: var(--brass);
        color: var(--ink);
        border-radius: 50%;
        font-family: var(--font-mono, monospace);
        font-weight: 700;
        font-size: 0.95rem;
        flex-shrink: 0;
    }
    .dcrs-step-card__title {
        font-family: var(--font-display, serif);
        font-size: 1.12rem;
        color: var(--ink);
        margin: 0;
    }
    .dcrs-step-card__desc {
        color: var(--steel);
        font-size: 0.88rem;
        line-height: 1.6;
        margin: 0;
    }

    .dcrs-fails-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.25rem;
    }
    @media (min-width: 640px) {
        .dcrs-fails-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    @media (min-width: 1024px) {
        .dcrs-fails-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }
    .dcrs-fail-card {
        background: var(--white);
        border: 1px solid var(--rule-on-paper);
        border-radius: 8px;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
