// ---------------------------------------------------------------------------
// Section Data
// ---------------------------------------------------------------------------
const warningSigns = [
    {
        icon: "car",
        title: "Sluggish Engine Cranking",
        desc: "The starter motor turns over slowly or labours before starting. This indicates the battery is struggling to deliver sufficient starting power under load."
    },
    {
        icon: "lightbulb",
        title: "Battery Warning Light",
        desc: "An illuminated battery symbol on your dashboard indicates a charging system or voltage issue, which may be caused by an alternator problem, loose wiring, or battery degradation."
    },
    {
        icon: "plug",
        title: "Repeated Jump Starts",
        desc: "If your car requires multiple jump starts within a short period, the battery may not be holding a charge, though charging-system faults should also be tested."
    },
    {
        icon: "power",
        title: "Flickering Electrical Accessories",
        desc: "Dimming headlights at idle, slow power windows, or resetting dashboard displays can point to unstable electrical voltage from a weak battery or struggling alternator."
    },
    {
        icon: "drop",
        title: "Case Swelling or Acid Residue",
        desc: "A bloated battery casing or white powdery corrosion around terminal clamps indicates internal heat stress or venting, which warrants professional inspection."
    },
    {
        icon: "calendar",
        title: "Battery Over 2 Years in Service",
        desc: "In Dubai's warm climate, battery performance can degrade faster than in cooler regions. Testing is recommended once a battery reaches two years of service, rather than automatic replacement."
    },
    {
        icon: "alert",
        title: "Pungent Sulphur Odour",
        desc: "A rotten egg smell near the battery can indicate venting gases from an overcharging condition or internal cell damage, requiring immediate inspection."
    },
    {
        icon: "moon",
        title: "No-Start After Parking Overnight",
        desc: "If your car fails to start after sitting parked overnight, the battery may lack reserve capacity, or the vehicle could have an active electrical drain while parked."
    }
];

const batteryBrands = [
    { name: "Bosch", note: "Engineered to international standards for European and Asian models." },
    { name: "Exide", note: "Reinforced plate construction suitable for high ambient temperatures." },
    { name: "Varta", note: "AGM and EFB options suited for modern start-stop vehicles." },
    { name: "Amaron", note: "Heat-tolerant alloy formulation designed for warm climates." },
    { name: "ACDelco", note: "Factory-fit replacements for American and global vehicle platforms." }
];

const batteryTypes = [
    {
        type: "Standard Flooded (SLI)",
        desc: "Conventional lead-acid design for vehicles with standard electrical systems and no start-stop feature. A reliable and cost-effective choice for standard daily driving."
    },
    {
        type: "EFB - Enhanced Flooded",
        desc: "Features reinforced internal plates and improved cyclic endurance, suited for vehicles with basic start-stop systems or higher electrical loads."
    },
    {
        type: "AGM - Absorbent Glass Mat",
        desc: "Electrolyte is absorbed in glass-mat separators, delivering high electrical capacity and vibration resistance, required for advanced start-stop and high-demand electronic systems."
    }
];

const processSteps = [
    { num: "1", title: "Consultation & Specification Check", desc: "You contact our team with your vehicle make, model, year, and location in Dubai so we can identify the recommended battery size and check technician availability." },
    { num: "2", title: "Workshop Visit or Mobile Dispatch", desc: "Drive into our workshop at 222 Al Satwa Road, or request mobile technician attendance at your home, office, or roadside location, subject to availability." },
    { num: "3", title: "Battery & Charging System Test", desc: "Our technician connects a digital tester to check your battery's voltage and starting power, and tests the alternator output to verify charging performance." },
    { num: "4", title: "Clear Quote Approval", desc: "If replacement is needed, we explain the test results and confirm the total price, including battery and standard installation, before proceeding." },
    { num: "5", title: "Clean Installation & Terminal Securing", desc: "The technician disconnects the old unit, cleans any terminal corrosion, applies protective terminal grease, and fits the replacement securely." },
    { num: "6", title: "Final Check & Battery Registration", desc: "We test charging voltage under load, perform battery registration on equipped modern vehicles when required by factory specifications, and verify a clean start." }
];

const pricingRows = [
    { type: "Standard Flooded (SLI)", price: "AED 150 – 250", warranty: "Warranty available" },
    { type: "EFB (Enhanced Flooded)", price: "AED 250 – 380", warranty: "Warranty available" },
    { type: "AGM (Premium)", price: "AED 380 – 650", warranty: "Warranty available" },
    { type: "Battery Health & System Test", price: "AED 30 – 50", warranty: "N/A" }
];

const makes = [
    'Toyota', 'Nissan', 'Honda', 'Mitsubishi',
    'Lexus', 'BMW', 'Mercedes-Benz', 'Audi',
    'Volkswagen', 'Kia', 'Hyundai', 'Ford',
    'Chevrolet', 'Jeep', 'Land Rover', 'Porsche'
];

const reasons = [
    { icon: "mapPin", title: "Central Al Satwa Workshop", desc: "Located at 222 Al Satwa Road, Al Satwa, minutes from Sheikh Zayed Road, Jumeirah, and Downtown Dubai." },
    { icon: "award", title: "Established in 2012", desc: "Serving Dubai drivers since 2012 with 8 experienced mechanics and more than 8,500 vehicles serviced across makes and models." },
    { icon: "star", title: "4.8-Star Customer Rating", desc: "Built on honest diagnostic assessments, reliable service, and transparent customer feedback across private and commercial drivers." },
    { icon: "shield", title: "Diagnostic-First Approach", desc: "We test your battery and charging system before recommending replacement, confirming whether the issue is the battery, alternator, or wiring." },
    { icon: "receipt", title: "Clear, Upfront Pricing", desc: "Transparent quotes starting from AED 150 with standard installation included. You approve the price before any replacement begins." },
    { icon: "cog", title: "Vehicle Specification Matching", desc: "We verify the correct battery type, capacity, and terminal layout, and perform battery registration on modern vehicles where required." }
];

const faqs = [
    {
        q: "How long does a car battery last in Dubai?",
        a: "In Dubai's warm climate, most car batteries last between two and three years. High ambient temperatures accelerate chemical reactions and fluid loss within the battery. Having your battery tested during regular service once it reaches two years helps you catch deterioration before an unexpected starting failure."
    },
    {
        q: "Can you replace my car battery at my home or office in Dubai?",
        a: "Yes, we offer mobile battery replacement across Dubai, subject to technician availability and location. A technician can come to your home, office parking, or roadside to test your existing battery and install a replacement on-site."
    },
    {
        q: "How do I know if my battery needs replacing or just recharging?",
        a: "A digital battery test measures voltage, internal resistance, and cranking power under load. If the test shows that internal cells are damaged or the battery cannot hold sufficient charge, replacement is necessary. If the battery is healthy and was only discharged (for example, by leaving lights on), recharging it may be sufficient."
    },
    {
        q: "What battery brands do you supply in Dubai?",
        a: "Subject to vehicle specifications and supplier availability, common brands include Bosch, Exide, Varta, Amaron, and ACDelco. Our technicians recommend a battery that matches your car manufacturer's technical requirements."
    },
    {
        q: "Does my car require an AGM battery?",
        a: "Vehicles with automatic stop-start technology, regenerative braking, or heavy electrical equipment generally require an AGM or EFB battery. Fitting a standard flooded battery to an AGM-specified vehicle can cause rapid battery wear and electrical faults. We check your vehicle's factory specifications before installing a replacement."
    },
    {
        q: "What factors determine car battery replacement costs in Dubai?",
        a: "Battery replacement cost depends primarily on battery type (standard flooded, EFB, or AGM), capacity (Ah rating), physical size, and brand. Standard installation and basic charging testing are included, while specialized computer registration for certain vehicles is confirmed upfront."
    },
    {
        q: "Could my starting problem be caused by something other than the battery?",
        a: "Yes. A worn starter motor, a failing alternator, loose or corroded battery cables, or a parasitic electrical drain can cause similar symptoms to a dead battery. Our technicians test the charging and starting system to confirm the true cause before replacing any parts."
    }
];

const relatedServices = [
    { icon: "bolt", name: "Mobile Car Repair Dubai", desc: "On-site battery testing, diagnostics, and mechanical assistance at your location", href: "/mobile-car-repair-dubai" },
    { icon: "alert", name: "Roadside Assistance Dubai", desc: "Emergency jump starts, breakdown assistance, and flat tyre support across Dubai", href: "/roadside-assistance-dubai" },
    { icon: "car", name: "Car Inspection Dubai", desc: "Comprehensive electrical, battery, charging system, and vehicle safety checks", href: "/car-inspection-dubai" },
    { icon: "cog", name: "Car Engine Service Dubai", desc: "Alternator repairs, starter motor diagnosis, and engine electrical servicing", href: "/car-engine-service-dubai" }
];

