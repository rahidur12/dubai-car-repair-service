<BaseLayout
    title={pageTitle}
    description={pageDescription}
>
    <!-- Structured JSON-LD Schema Graph -->
    <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

    <main class="dcrs-service-page">

        <!-- 1. HERO BANNER --------------------------------------------------->
        <header class="dcrs-hero-banner">
            <div class="dcrs-hero-banner__scrim"></div>
            <div class="dcrs-container dcrs-hero-banner__inner">
                <nav class="dcrs-breadcrumb" aria-label="Breadcrumb">
                    <ol>
                        <li><a href="/">Home</a></li>
                        <li><a href="/#service">Services</a></li>
                        <li aria-current="page">Car Battery Replacement Dubai</li>
                    </ol>
                </nav>
                <span class="dcrs-badge">Al Satwa, Dubai · Same-Day Service · All Makes &amp; Models</span>
                <h1 class="dcrs-hero-banner__title">
                    Car Battery Replacement Dubai - Mobile &amp; Workshop Fitting
                </h1>
                <p class="dcrs-hero-banner__lead">
                    Car won't start? Get fast car battery replacement in Dubai from our Al Satwa workshop or via mobile service delivered right to your home, office, or roadside. We test your charging system and install genuine, heat-resistant batteries with warranty. From AED 180.
                </p>
                <div class="dcrs-hero-banner__actions">
                    <a href={phoneHref} class="dcrs-btn dcrs-btn--solid">
                        <Fragment set:html={icons.phone} /> Call {phoneDisplay}
                    </a>
                    <a href={waHref} target="_blank" rel="noopener noreferrer" class="dcrs-btn dcrs-btn--wa">
                        <Fragment set:html={icons.chat} /> WhatsApp Us
                    </a>
                </div>
            </div>
        </header>

        <!-- 2. INTRO SECTION ------------------------------------------------->
        <section class="dcrs-section dcrs-section--paper" id="service-overview">
            <div class="dcrs-container">
                <div class="dcrs-grid-2col dcrs-grid-2col--align-center">
                    
                    <div class="dcrs-intro-content">
                        <div class="dcrs-kicker">Service Overview</div>
                        <h2 class="dcrs-heading__title">
                            Car Battery Replacement Dubai - On-Site Diagnostics &amp; Installation
                        </h2>
                        <p class="dcrs-lead-text">
                            Dubai's extreme summer heat is the leading cause of premature battery failure. When your vehicle refuses to crank, calling <a href="/" class="dcrs-inline-link">Dubai Car Repair Service</a> gets an experienced technician to your vehicle with genuine battery stock. If you need immediate emergency dispatch, you can <a href="/contact" class="dcrs-inline-link">contact us</a> directly.
                        </p>
                        <p class="dcrs-body-text">
                            Before recommending a new battery, our technicians test the entire charging circuit using digital conductance analyzers. If you are stuck at home or the office, our <a href="/mobile-car-repair-dubai" class="dcrs-inline-link">mobile car mechanic in Dubai</a> delivers on-site fitting with zero hassle. Stranded on the road? We provide rapid <a href="/roadside-assistance-dubai" class="dcrs-inline-link">roadside assistance near me</a> to get you started safely.
                        </p>
                        <p class="dcrs-body-text">
                            We provide fast service across the emirate. For customers in the local neighborhood, our <a href="/car-repair-al-satwa" class="dcrs-inline-link">car battery replacement in Satwa</a> service ensures arrival within 20–30 minutes. If you encounter a sudden <a href="/car-repair-sheikh-zayed-road" class="dcrs-inline-link">car breakdown on Sheikh Zayed Road</a>, our highway response team is dispatched immediately. To confirm your starter motor and alternator health, we can also conduct a <a href="/car-inspection-dubai" class="dcrs-inline-link">full car check up</a>.
                        </p>

                        <div class="dcrs-action-row">
                            <a href={phoneHref} class="dcrs-btn dcrs-btn--solid">
                                <Fragment set:html={icons.phone} /> Call Mechanic
                            </a>
                            <a href="/contact" class="dcrs-btn dcrs-btn--outline-ink">
                                Book Battery Replacement <Fragment set:html={icons.arrowRight} />
                            </a>
                        </div>
                    </div>

                    <div class="dcrs-intro-media">
                        <div class="dcrs-intro-media__frame">
                            <img
                                src={service5Image.src}
                                alt="Technician performing car battery replacement in Dubai with digital conductance tester at Al Satwa workshop"
                                loading="eager"
                                width="600"
                                height="400"
                            />
                            <div class="dcrs-plate dcrs-price-badge" aria-hidden="true">
