// Section Data
// ---------------------------------------------------------------------------
const warningSigns = [
    {
        icon: "car",
        title: "Sluggish Engine Cranking",
        desc: "The starter motor turns over slowly or labours before starting. This indicates the battery cannot supply sufficient cold cranking amps under initial load."
    },
    {
        icon: "lightbulb",
        title: "Battery Warning Light",
        desc: "An illuminated battery or charging symbol on your dashboard indicates a voltage irregularity, often linked to an alternator fault or failing internal cells."
    },
    {
        icon: "plug",
        title: "Repeated Jump Starts",
        desc: "If your car requires multiple jump starts within a short period, the battery plates have degraded and can no longer hold a resting charge."
    },
    {
        icon: "power",
        title: "Flickering Electrical Accessories",
        desc: "Dimming headlights at idle, slow power windows, or resetting audio screens point to unstable voltage output across the vehicle's electrical system."
    },
    {
        icon: "drop",
        title: "Case Swelling or Acid Residue",
        desc: "A bloated battery casing or white powdery corrosion around terminal clamps indicates internal heat stress, overcharging, or venting issues."
    },
    {
        icon: "calendar",
        title: "Battery Over 2 Years in Service",
        desc: "Because Dubai's climate accelerates chemical breakdown, batteries older than 24 months should be load-tested during regular vehicle maintenance."
    },
    {
        icon: "alert",
        title: "Pungent Sulphur Odour",
