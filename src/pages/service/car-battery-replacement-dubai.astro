const faqs = [
    {
        q: "How long does a car battery last in Dubai?",
        a: "Most car batteries in Dubai last between two and three years. Sustained summer ambient temperatures exceeding 40°C accelerate electrolyte evaporation and internal plate corrosion. We recommend having your battery load-tested at every scheduled service once it passes 18 months of use."
    },
    {
        q: "Can you replace my car battery at my home or office in Dubai?",
        a: "Yes. Our mobile technicians can test and replace your battery at your home, office parking garage, or roadside location without requiring a tow truck [CONFIRM: mobile battery replacement coverage and call-out charges]."
    },
    {
        q: "How do I know if my battery needs replacing or just recharging?",
        a: "A professional digital load test measures cold cranking amps (CCA) and internal plate resistance. If a battery tests below 70% of its rated capacity or has shorted cells, recharging will only provide a temporary start before failing again, and replacement is required."
    },
