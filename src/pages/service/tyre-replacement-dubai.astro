// ---------------------------------------------------------------------------
// 8 Signs to Replace Tyres
// ---------------------------------------------------------------------------
const signs = [
    {
        num: "1",
        icon: "ruler",
        urgency: "Safety Recommendation",
        title: "Tread Depth Approaching Wear Limits",
        desc: "The UAE legal minimum tread depth is 1.6 mm across the central three-quarters of the tread. However, for highway driving in Dubai, automotive safety experts recommend considering replacement at 2.5 mm–3.0 mm, as shallower tread reduces dry road grip and significantly increases braking distances.",
        action: "Have your tread depth measured with a calibrated gauge and plan tyre replacement before reaching the legal limit."
    },
    {
        num: "2",
        icon: "calendar",
        urgency: "Age Advisory",
        title: "Tyre Age Reaching Five Years",
        desc: "Check the 4-digit DOT date stamped on the sidewall (e.g., 2621 indicates week 26 of 2021). Under UAE vehicle inspection standards, tyres older than 5 years generally fail annual RTA roadworthiness tests because rubber compounds harden and oxidize in warm climates regardless of remaining tread.",
        action: "Check your tyre DOT codes; if any tyre is approaching 5 years of age, schedule a replacement inspection."
    },
    {
        num: "3",
        icon: "alert",
        urgency: "Inspection Required",
        title: "Sidewall Surface Cracking & Weathering",
        desc: "Fine cracks, crazing, or fissures along the sidewall or between tread grooves indicate rubber drying, ozone degradation, and thermal exposure. Surface weathering can weaken the tyre's outer protective compound over time.",
        action: "Have an experienced technician evaluate the depth of the cracks to confirm whether casing integrity is compromised."
    },
    {
        num: "4",
        icon: "arrowsHorizontal",
        urgency: "Immediate Hazard",
        title: "Sidewall Bulges, Blisters or Hernias",
        desc: "A visible bulge or bubble on the sidewall indicates that the internal structural cords have ruptured, typically from pothole impacts, speed bumps, or kerb strikes. This poses an immediate blowout risk; the vehicle should not continue to be driven if unsafe.",
        action: "Install your spare wheel or arrange recovery; do not drive on a tyre with a visible sidewall bulge."
    },
    {
        num: "5",
        icon: "arrowsVertical",
        urgency: "Alignment & Inflation Check",
        title: "Irregular or Uneven Tread Wear",
        desc: "Wear concentrated on the inner or outer shoulder often points to suspension geometry faults (camber or toe misalignment) or worn suspension bushings. In contrast, centre tread wear suggests chronic over-inflation, while wear on both outer edges indicates under-inflation.",
        action: "Book a wheel alignment check and inspect tyre cold pressures and suspension components for wear."
    },
    {
        num: "6",
        icon: "steering",
        urgency: "Diagnostic Check",
        title: "Steering Wheel or High-Speed Vibration",
        desc: "Vibration felt through the steering wheel or seat between 80 and 120 km/h can stem from wheel imbalance, tyre runout, a bent rim, or worn suspension components. Dynamic wheel balancing resolves weight imbalances, but underlying mechanical faults should also be checked.",
        action: "Have wheels dynamically balanced and have technician inspect rims and suspension for mechanical play."
    },
    {
        num: "7",
        icon: "volumeUp",
        urgency: "Mechanical Inspection",
        title: "Rhythmic Road Roar or Tread Cupping",
        desc: "A rhythmic drone, humming, or thumping sound that increases with vehicle speed often signals tread cupping (scalloping) caused by worn shock absorbers, loose wheel bearings, or prolonged lack of tyre rotation.",
        action: "Have tyres checked for scalloped wear and have shock absorbers and wheel bearings inspected."
    },
    {
        num: "8",
        icon: "gauge",
        urgency: "Leak Assessment",
        title: "Persistent Air Pressure Loss",
        desc: "Repeatedly losing air pressure without an obvious nail puncture suggests a deteriorating valve stem, rim bead corrosion, or a small hidden puncture. Driving on low pressure causes rapid heat build-up and tyre damage.",
        action: "Have the tyre demounted, the valve stem checked, and the wheel rim bead inspected for proper sealing."
    }
];

