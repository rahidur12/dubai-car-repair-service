<script>
    // FAQ Accordion Toggle Interaction
    document.addEventListener('DOMContentLoaded', () => {
        const faqItems = document.querySelectorAll<HTMLElement>('.dcrs-faq-item');
        faqItems.forEach((item) => {
            const trigger = item.querySelector<HTMLButtonElement>('.dcrs-faq-trigger');
            const panel = item.querySelector<HTMLElement>('.dcrs-faq-panel');
            if (!trigger || !panel) return;

            trigger.addEventListener('click', () => {
                const isOpen = item.getAttribute('data-state') === 'open';

                // Close all others
                faqItems.forEach((other) => {
                    other.setAttribute('data-state', 'closed');
                    const otherTrig = other.querySelector<HTMLButtonElement>('.dcrs-faq-trigger');
                    const otherPan = other.querySelector<HTMLElement>('.dcrs-faq-panel');
                    if (otherTrig) otherTrig.setAttribute('aria-expanded', 'false');
                    if (otherPan) otherPan.style.display = 'none';
                });

                // Toggle selected
                if (!isOpen) {
                    item.setAttribute('data-state', 'open');
                    trigger.setAttribute('aria-expanded', 'true');
                    panel.style.display = 'block';
                }
            });
        });
    });
</script>

