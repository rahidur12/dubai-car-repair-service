// ---------------------------------------------------------------------------
// 8 Signs to Replace Tyres
// ---------------------------------------------------------------------------
const signs = [
    {
        icon: "ruler",
        title: "Tread Depth Below Safe Thresholds",
        desc: "The UAE legal minimum is 1.6mm across the central three-quarters of the tread. For high-speed highway driving in Dubai, replacement is strongly recommended at 2.5mm–3mm, as shallow tread drastically increases braking distances and reduces dry-heat traction."
    },
    {
        icon: "calendar",
        title: "Manufacturing Age Exceeding 5 Years",
        desc: "Check the 4-digit DOT code on the tyre sidewall (e.g., 2421 indicates week 24 of 2021). Per UAE ESMA/GSO standards, tyres older than 5 years must be replaced regardless of remaining tread depth because rubber compounds harden and oxidize internally."
    },
    {
        icon: "alert",
        title: "Sidewall Surface Cracking & Weathering",
        desc: "Fine hairline fissures on the sidewall or between tread blocks indicate ozone damage and thermal fatigue from Dubai's sustained summer asphalt heat. Degraded rubber increases the risk of carcass failure under load."
    },
    {
        icon: "arrowsHorizontal",
        title: "Sidewall Bulges, Blisters or Hernias",
        desc: "A visible bulge indicates ruptured internal carcass cords, typically caused by sharp pothole impacts, speed bumps, or kerb strikes. This represents severe structural damage and requires immediate replacement to avoid a blowout."
    },
    {
        icon: "arrowsVertical",
        title: "Uneven Shoulder or Centre Tread Wear",
        desc: "Excessive inner or outer edge wear indicates wheel alignment faults (toe/camber errors), while centre wear signals chronic over-inflation. Irregular wear shortens tyre lifespan and compromises vehicle handling."
    },
    {
        icon: "steering",
        title: "Steering Wheel Shimmy & High-Speed Vibration",
        desc: "Vibrations felt through the steering wheel or seat at 80–120 km/h point to wheel assembly unbalance, radial runout, or internal belt separation. If dynamic wheel balancing does not resolve the issue, structural replacement is needed."
    },
    {
        icon: "volumeUp",
        title: "Rhythmic Road Roar or Tread Cupping",
        desc: "An unexpected drone, hum, or rhythmic thumping sound indicates tread cupping (scalloping) caused by worn suspension dampers or loose wheel bearings, creating high-spot tyre wear."
    },
    {
        icon: "gauge",
        title: "Persistent Air Pressure Loss",
        desc: "Losing pressure repeatedly without an obvious nail puncture suggests rim bead corrosion, a failing valve stem, or microscopic tread fissures. Tyres operating under-inflated overheat rapidly on UAE motorways."
    }
];

// ---------------------------------------------------------------------------
// Tyre Brands
// ---------------------------------------------------------------------------
const brands = [
    { name: "Bridgestone", desc: "Japanese engineering known for high thermal resistance. Popular OEM fitment across Toyota, Lexus, and Nissan SUVs operating in the Gulf." },
    { name: "Michelin", desc: "French premium brand featuring advanced silica compounds, high-speed stability, and low rolling resistance for European and luxury models." },
    { name: "Continental", desc: "German precision with outstanding wet and dry braking safety. Common original equipment fitment for Mercedes-Benz, Audi, and Volkswagen." },
    { name: "Pirelli", desc: "Italian high-performance tyres designed for high lateral grip, precise steering response, and stability on sports cars and performance saloons." },
    { name: "Yokohama", desc: "Japanese tyre manufacturer offering dependable durability, heat endurance, and balanced comfort for Japanese and Korean vehicles." },
    { name: "Hankook", desc: "Korean performance manufacturer providing strong thermal resilience, quiet ride comfort, and exceptional value for daily commuters." },
