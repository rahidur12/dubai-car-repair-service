// ---------------------------------------------------------------------------
// FAQ Items
// ---------------------------------------------------------------------------
const faqs = [
    {
        q: "How long do car tyres typically last in Dubai?",
        a: "In Dubai's climate, passenger car tyres typically last 30,000–50,000 km, while heavier SUVs often see 25,000–40,000 km depending on driving habits and road conditions. However, age is as critical as mileage: under UAE regulations, tyres older than 5 years from their DOT production date cannot pass official RTA roadworthiness tests and should be replaced regardless of tread depth because thermal cycles harden and degrade the rubber internally."
    },
    {
        q: "What tyre pressure should I maintain during the Dubai summer?",
        a: "Always inflate your tyres to the vehicle manufacturer's recommended cold pressure, found on the placard inside the driver's door jamb or in the owner's manual. High ambient temperatures elevate tyre pressure by approximately 1 PSI for every 5.5°C rise. Check pressure when tyres are cold (parked for at least three hours) and never bleed air from hot tyres after driving."
    },
    {
        q: "Can a punctured tyre be repaired, or does it need replacement?",
        a: "A puncture can be safely repaired if the puncture is located within the central three-quarters of the tread crown, the damage diameter is 6mm or smaller, and the tyre was not driven flat. Safe repair requires removing the tyre from the wheel rim and installing a combined internal plug-patch. Punctures in the sidewall or shoulder cannot be repaired and require tyre replacement."
    },
    {
        q: "How do I read my car tyre size and specifications?",
        a: "Tyre sizes are moulded onto the sidewall in a standardized code, such as 225/55 R17 97W. In this example, 225 is the section width in millimetres, 55 is the aspect ratio (sidewall height as a percentage of width), R indicates radial casing, 17 is the wheel rim diameter in inches, 97 is the load index (730 kg per tyre), and W is the speed rating (up to 270 km/h). Replacement tyres must match or exceed original equipment load and speed ratings."
    },
    {
        q: "How often should wheel alignment and balancing be performed?",
        a: "We recommend checking wheel alignment every 15,000–20,000 km, whenever new tyres are fitted, or immediately if you notice the car pulling to one side or uneven tread wear. Dynamic wheel balancing should be done whenever tyres are mounted, rotated, or if you feel a steering wheel shimmy between 80 and 120 km/h."
    },
    {
        q: "Are budget tyres safe for driving in the UAE?",
        a: "Budget tyres are safe provided they carry official GSO/ESMA conformity marking with high temperature ratings (Temperature A) suitable for tarmac temperatures exceeding 60°C. However, premium and mid-range brands generally offer superior braking distances, quieter highway ride, and longer tread life. Never install tyres with lower load or speed ratings than specified by your vehicle manufacturer."
    }
];

// ---------------------------------------------------------------------------
// Related Services
// ---------------------------------------------------------------------------
const relatedServices = [
    { icon: "search", name: "Car Inspection in Dubai", desc: "50-point check including tyre, brake & suspension", href: "/car-inspection-dubai" },
