    }

    .dcrs-workshop-box__lead {
        font-size: 0.92rem;
        line-height: 1.7;
        color: #555;
        margin: 0 0 1.25rem;
    }

    .dcrs-workshop-list {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.6rem;
    }

    @media (min-width: 640px) {
        .dcrs-workshop-list {
            grid-template-columns: repeat(2, 1fr);
        }
    }

