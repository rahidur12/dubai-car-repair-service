        desc: "On-site battery health check and charging circuit test. When replacement is required, the price includes the supply, professional fitting, and testing of a new battery matched to your vehicle's specifications.",
        price: "AED 180 – 680",
        mobileScope: "yes"
    },
    {
        icon: "laptop",
        title: "OBD-II Multi-System Diagnostic Scan",
        desc: "Connecting a diagnostic scanner to read active and stored fault codes across engine, transmission, ABS, and body modules to identify electronic or sensor faults before initiating repairs.",
        price: "AED 80 – 130",
        mobileScope: "yes"
    },
    {
        icon: "bolt",
        title: "Regulated Jump Start & Alternator Check",
        desc: "Safe jump start assistance using a commercial booster pack to protect vehicle electronics, followed by an alternator voltage check to confirm the charging system is functioning properly.",
