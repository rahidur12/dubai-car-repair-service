    .dcrs-hero-banner__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.85rem;
        width: 100%;
        box-sizing: border-box;
    }

    @media (max-width: 480px) {
        .dcrs-hero-banner__actions {
            flex-direction: column;
            align-items: stretch;
        }
        .dcrs-hero-banner__actions .dcrs-btn {
            width: 100%;
        }
    }

    /* 2. Grid Layouts */
    .dcrs-grid-2col {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 2.5rem;
        width: 100%;
    }

    .dcrs-grid-2col > * {
        min-width: 0;
        max-width: 100%;
    }

    @media (min-width: 992px) {
        .dcrs-grid-2col {
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
            gap: 3.5rem;
        }
        .dcrs-grid-2col--align-center {
            align-items: center;
        }
    }

    .dcrs-photo-card {
        position: relative;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(16, 32, 31, 0.12);
        background: #000;
