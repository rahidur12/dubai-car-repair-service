        price: "AED 55 – 80",
        mobileScope: "yes"
    },
    {
        icon: "brake",
        title: "Brake System Inspection & Fluid Top-Up",
        desc: "Visual examination of brake pad thickness, disc rotor condition, and fluid levels. Brake pad and disc rotor replacement require workshop hydraulic hoists for safety and proper torque installation.",
