<script>
    // FAQ Accordion interaction
    document.addEventListener('DOMContentLoaded', () => {
        const accordion = document.querySelector('[data-accordion]');
        if (!accordion) return;

        const questions = accordion.querySelectorAll('.dcrs-faq-question');
        questions.forEach((btn) => {
            btn.addEventListener('click', () => {
                const item = btn.closest('.dcrs-faq-item');
                const answer = item?.querySelector('.dcrs-faq-answer') as HTMLElement | null;
                const isCurrentlyOpen = item?.classList.contains('is-open');

                // Close other items
                accordion.querySelectorAll('.dcrs-faq-item').forEach((otherItem) => {
                    otherItem.classList.remove('is-open');
                    const otherBtn = otherItem.querySelector('.dcrs-faq-question');
                    const otherAnswer = otherItem.querySelector('.dcrs-faq-answer') as HTMLElement | null;
                    if (otherBtn) otherBtn.setAttribute('aria-expanded', 'false');
                    if (otherAnswer) otherAnswer.style.display = 'none';
                });

                // Toggle selected item
                if (!isCurrentlyOpen && item && answer) {
                    item.classList.add('is-open');
                    btn.setAttribute('aria-expanded', 'true');
                    answer.style.display = 'block';
                }
            });
        });
    });
</script>

