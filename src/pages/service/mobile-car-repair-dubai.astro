    "Automatic and manual transmission servicing, torque converter, and gearbox repairs",
    "Suspension control arm, hydraulic bushing press-fit, and shock absorber replacement"
];

const steps = [
    {
        num: "1",
        icon: "phone",
        title: "Call or Share Location via WhatsApp",
        desc: "Contact us via phone at +971 56 612 1423 or WhatsApp. Provide your vehicle make, model, year, parking location, and a description of the symptoms, no-start condition, or dashboard warnings."
