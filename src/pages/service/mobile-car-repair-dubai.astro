// ---------------------------------------------------------------------------
// Page Data
// ---------------------------------------------------------------------------
const onsiteServices = [
    {
        icon: "battery",
        title: "Car Battery Testing & Replacement",
        desc: "On-site digital conductance and load testing to confirm battery health, reserve capacity, and starting draw. When replacement is necessary, we supply and fit OEM-specification AGM, EFB, or flooded batteries matched to your vehicle's DIN dimensions and cold cranking amps (CCA). Includes alternator charging circuit test and terminal anti-corrosion treatment.",
        price: "AED 180–680 [CONFIRM: mobile battery replacement package pricing range]",
        mobileScope: "yes"
    },
    {
        icon: "laptop",
        title: "OBD-II Multi-System Diagnostics",
        desc: "On-site electronic interrogation across powertrain (PCM), transmission (TCM), ABS/stability, and body control modules (BCM). We scan active and pending diagnostic trouble codes (DTCs), evaluate live sensor parameters, and determine whether the issue is a failed sensor or a mechanical fault requiring workshop intervention.",
        price: "AED 80–130 [CONFIRM: mobile diagnostic scan pricing]",
        mobileScope: "yes"
    },
    {
        icon: "bolt",
        title: "Regulated Jump Start & Alternator Check",
        desc: "Safe jump-start assistance using commercial voltage-regulated booster packs, protecting sensitive ECU circuits against load-dump voltage spikes. We immediately verify alternator output voltage (13.8V–14.4V under load) and diode ripple before leaving to ensure your vehicle does not stall in traffic.",
        price: "AED 60–100 [CONFIRM: jump start service fee]",
        mobileScope: "yes"
    },
    {
        icon: "oil",
        title: "Mobile Engine Oil & Filter Change",
        desc: "Routine lube servicing performed cleanly at your residential or commercial parking bay using sealed spill-containment equipment. We drain degraded oil, install an OEM-grade filter with a fresh sump crush washer, and refill with manufacturer-approved synthetic oil matching required viscosity and API/ACEA specifications. Waste oil is collected for certified recycling.",
        price: "AED 119–410 [CONFIRM: mobile oil change pricing range]",
        mobileScope: "yes"
    },
    {
        icon: "snowflake",
        title: "AC Pressure Diagnostic & Refrigerant Top-Up",
        desc: "On-site manifold gauge pressure diagnostics across high and low service ports for systems blowing warm. If the compressor clutch engages and the sealed refrigerant circuit holds pressure, we top up R134a or R1234yf refrigerant to factory weight. Systems with severe pressure leaks or compressor failure are referred to our workshop.",
        price: "AED 130–380 [CONFIRM: mobile AC top-up pricing range]",
        mobileScope: "yes"
    },
    {
        icon: "tyre",
        title: "On-Site Tyre Puncture Plug-Patch Repair",
        desc: "Tread-centre puncture inspection and permanent vulcanising plug-patch repair where tyre structure and puncture angle permit. Includes pneumatic pressure equalization and TPMS sensor verification. Sidewall cuts, shoulder punctures, or severely aged rubber requiring mounting machinery are referred to our workshop tyre bay.",
        price: "AED 55–80 [CONFIRM: tyre puncture repair price]",
        mobileScope: "yes"
    },
    {
        icon: "brake",
        title: "Brake System Inspection & Fluid Top-Up",
        desc: "Wheel-off visual inspection of brake pad friction material thickness, rotor disc scoring, and hydraulic caliper slider condition. We test brake fluid boiling point and top up reservoirs on-site. Complete disc rotor skimming or pad replacements require our Al Satwa workshop hydraulic ramps for safety and calibrated torque compliance.",
        price: "From AED 80 [CONFIRM: mobile brake inspection fee]",
        mobileScope: "partial"
    },
    {
        icon: "filter",
        title: "Engine Air & Cabin Microfilter Replacement",
        desc: "Rapid on-site replacement of dust-saturated engine intake air filters and activated carbon cabin filters. In Dubai's arid climate, airborne particulate accumulation chokes engine induction and creates musty air conditioning odour; regular replacement restores airflow and HVAC efficiency.",
        price: "AED 50–150 [CONFIRM: filter replacement pricing range]",
        mobileScope: "yes"
    },
    {
        icon: "coolant",
        title: "Cooling System Inspection & Fluid Top-Up",
        desc: "Thermal inspection of radiator hoses, expansion tank pressure cap, and visible engine hose couplings for heat degradation or crusting. We top up cooling circuits with premixed manufacturer-grade OAT or HOAT coolant. Active radiator leaks, failed water pumps, or thermostat housing cracks require workshop towing to prevent severe engine overheating.",
        price: "AED 70–160 [CONFIRM: coolant inspection and top-up price]",
        mobileScope: "yes"
    }
];

const workshopRepairs = [
    "AC compressor replacement, evaporator core teardown, and nitrogen decay leak testing",
    "Brake pad and disc rotor replacement (requires hydraulic lift and precision caliper torquing)",
