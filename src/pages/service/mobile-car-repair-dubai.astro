const whyChooseUs = [
    {
        icon: "userCheck",
        title: "Permanent Workshop Technicians",
        desc: "Every mobile mechanic dispatched is a permanent technician from our Al Satwa repair facility-not a freelance gig worker. You receive genuine workshop-grade technical expertise and trade accountability."
    },
    {
        icon: "search",
        title: "Accurate Diagnostic Equipment",
        desc: "We bring multi-system OBD-II scanners and digital electrical testing instruments on every mobile dispatch. We identify the root mechanical or electrical cause rather than swapping components speculatively."
    },
    {
        icon: "award",
