    },
    {
        q: "Can you carry out repairs inside covered residential or basement parking?",
        a: "Yes, provided the building or community management permits on-site maintenance and there is adequate ceiling clearance and lighting. Services like battery replacement, electronic scanning, and minor inspections are well-suited for parking spaces. Complex repairs, major fluid draining, or tasks creating noise or fumes are restricted in enclosed basements for environmental and safety reasons."
    }
];

const relatedServices = [
    { icon: "battery", name: "Mobile Battery Service Dubai", desc: "On-site battery testing, supply & installation across Dubai", href: "/car-battery-replacement-dubai" },
    { icon: "alert", name: "Roadside Assistance Dubai", desc: "Emergency assistance for breakdowns, punctures & jump starts", href: "/roadside-assistance-dubai" },
    { icon: "oil", name: "Oil Change Service Dubai", desc: "Lube service with OEM filter & certified fluid disposal", href: "/engine-oil-change-dubai" },
