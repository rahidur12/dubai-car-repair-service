        mobileScope: "partial"
    },
    {
        icon: "filter",
        title: "Engine Air & Cabin Filter Replacement",
        desc: "On-site replacement of dust-saturated engine intake air filters and cabin filters to restore clean airflow and HVAC performance in dusty driving conditions.",
