        mobileScope: "yes"
    },
    {
        icon: "coolant",
        title: "Cooling System Inspection & Fluid Top-Up",
        desc: "Visual check of radiator hoses, expansion tank cap, and coolant level, with top-up using appropriate coolant. Severe leaks, water pump failures, or radiator cracks require workshop towing.",
        price: "AED 70 – 160",
        mobileScope: "yes"
    }
];

const workshopRepairs = [
    "AC compressor replacement, evaporator core teardown, and nitrogen decay leak testing",
    "Brake pad and disc rotor replacement (requires hydraulic hoist and calibrated torque wrench)",
    "Timing belt, timing chain, and mechanical water pump replacements",
    "Cylinder head gasket replacement and internal engine rebuilding or overhauling",
    "Four-wheel laser alignment and dynamic high-speed wheel balancing",
