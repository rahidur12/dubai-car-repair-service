// ---------------------------------------------------------------------------
// Section Data
// ---------------------------------------------------------------------------
const oils = [
    {
        icon: "award",
        badgeColor: "dcrs-oil-icon--primary",
        title: "Fully Synthetic Engine Oil",
        price: "From AED 220 [CONFIRM: fully synthetic package starting price]",
        desc: "Formulated with chemically engineered Group IV/V synthetic base stocks for maximum thermal stability in UAE summer heat (ambient temperatures exceeding 45°C). Retains viscosity without thinning, prevents high-temperature oxidation, and provides instant lubrication to turbochargers and variable valve timing (VVT) actuators.",
        vehicles: "Modern Japanese, European, and American petrol, hybrid, and turbocharged engines (e.g., Toyota 0W-20, BMW Longlife-01/04, Mercedes MB 229.5, Porsche, and Volvo VCC RBS0-2AE)."
    },
    {
        icon: "flask",
        badgeColor: "dcrs-oil-icon--secondary",
        title: "Semi-Synthetic (Synthetic Blend) Oil",
        price: "From AED 140 [CONFIRM: semi-synthetic package starting price]",
        desc: "A balanced blend of synthetic base oil and refined mineral stock, offering improved shear stability and sludge resistance compared to standard mineral lubricants. An economical option for naturally aspirated older models and moderate-mileage commuter vehicles.",
        vehicles: "Naturally aspirated commuter sedans, older Japanese and Korean platforms (e.g., pre-2016 Nissan Sunny, Mitsubishi Lancer, Hyundai Accent, and older Toyota models specifying 10W-40)."
    },
    {
        icon: "oilCan",
        badgeColor: "dcrs-oil-icon--warning",
        title: "Conventional Mineral Oil",
        price: "From AED 89 [CONFIRM: mineral oil package starting price]",
        desc: "Refined petroleum-based lubricant suited for older engine designs with wider bearing clearances that do not feature complex variable valve timing systems. Degrades and shears faster under thermal stress, requiring disciplined short drain intervals.",
        vehicles: "Vintage platforms, older utility vehicles, and select older non-turbo diesel engines specifying thicker viscosity grades (e.g., 20W-50 or 15W-40)."
    }
];

const grades = [
    { grade: "0W-20", examples: "Toyota Corolla/Camry (2018+), Lexus, Honda Civic, Volvo (VCC spec)", type: "Fully Synthetic", interval: "7,500 – 10,000 km" },
    { grade: "5W-30", examples: "BMW, Mercedes-Benz, Audi, Nissan Patrol VQ56, Ford EcoBoost", type: "Fully Synthetic", interval: "8,000 – 10,000 km" },
    { grade: "5W-40", examples: "Volkswagen/Audi (VW 502/505), Porsche, turbo European engines", type: "Fully Synthetic", interval: "8,000 – 10,000 km" },
    { grade: "0W-40", examples: "Mercedes-AMG, BMW M-models, high-output sports cars", type: "Fully Synthetic", interval: "7,500 – 8,500 km" },
    { grade: "10W-40", examples: "Nissan Sunny, Mitsubishi Lancer, older commuter vehicles", type: "Semi-Synthetic", interval: "5,000 – 7,000 km" },
    { grade: "15W-40 / 20W-50", examples: "High-mileage utility 4x4s, older Land Cruiser, classic engines", type: "Mineral / Blend", interval: "5,000 km" }
];

const steps = [
    { num: "1", title: "Specification & Capacity Lookup", desc: "We cross-reference your vehicle's engine code against manufacturer technical data to confirm exact viscosity grade, volume capacity, and OEM approval certifications (e.g., MB 229.5, BMW LL-04, VW 504/507, Dexos 1 Gen 3, Volvo RBS0-2AE)." },
    { num: "2", title: "Gravity Drain & Temperature Check", desc: "With the vehicle on a hydraulic lift, engine oil is drained via the sump plug at operating temperature, allowing contaminants, metallic wear particulates, and suspended sludge to evacuate fully." },
    { num: "3", title: "Drained Fluid & Sump Inspection", desc: "Technicians examine the evacuated oil for telltale signs of internal engine distress: fuel dilution, milky coolant emulsification (head gasket breach), or abnormal metallic glitter indicating bearing wear." },
    { num: "4", title: "New OEM-Spec Filter & O-Ring Fitting", desc: "The old oil filter is replaced with an OEM-standard spin-on canister or pleated cartridge element. New rubber sealing rings are pre-lubricated with clean oil and torqued to specified limits." },
    { num: "5", title: "Crush Washer Replacement & Drain Plug Torquing", desc: "A fresh copper or aluminium crush washer is fitted to prevent slow sump seepage. The drain plug is carefully torqued to prevent stripped threads in aluminium oil pans." },
    { num: "6", title: "Precision Filling & Dipstick Verification", desc: "The exact measured volume of fresh engine oil is added. The engine is run to pressurize the system, followed by a settling period to confirm optimal dipstick or digital cluster oil level readings." }
];

const pricingTable = [
    { service: "Mineral Oil Change Package", price: "From AED 89 [CONFIRM: mineral package price]", includes: "Up to 4L oil + standard filter + labour" },
    { service: "Semi-Synthetic Oil Change Package", price: "From AED 140 [CONFIRM: semi-synthetic package price]", includes: "Up to 4L oil + OEM-spec filter + labour" },
    { service: "Fully Synthetic Oil Change Package", price: "From AED 220 [CONFIRM: synthetic package price]", includes: "Up to 4L oil + OEM-spec filter + labour" },
    { service: "Engine Oil Sump Washer", price: "AED 10 – 20 [CONFIRM: washer replacement fee]", includes: "New crush washer + installation" },
    { service: "Cabin AC Filter Replacement", price: "AED 50 – 120 [CONFIRM: cabin filter price range]", includes: "Filter element + fitting" },
    { service: "Engine Air Filter Replacement", price: "AED 40 – 90 [CONFIRM: engine air filter price range]", includes: "Filter element + housing clean" },
    { service: "Mobile Oil Service Call-Out", price: "From AED 50 [CONFIRM: mobile oil change call-out fee]", includes: "Technician travel to client location" }
];

const intervals = [
    { oil: "Conventional Mineral Oil", interval: "Every 5,000 km or 3 months" },
    { oil: "Semi-Synthetic (Synthetic Blend)", interval: "Every 6,000 – 7,500 km or 4–6 months" },
    { oil: "Fully Synthetic (Standard Use)", interval: "Every 8,000 – 10,000 km or 6 months" },
    { oil: "Turbocharged & High-Performance Engines", interval: "Every 6,000 – 8,000 km under UAE summer driving" },
    { oil: "High-Mileage / Severe Stop-and-Go Usage", interval: "Every 5,000 – 7,000 km with filter renewal" }
];

const reasons = [
    {
        icon: "award",
        title: "Exact Manufacturer Oil Approvals",
        desc: "We verify factory specifications before filling: BMW Longlife, Mercedes-Benz 229.5, Porsche A40, VW 504/507, GM Dexos, or Japanese ILSAC GF-6. We never pour generic bulk oil into engines requiring specialized additive packs."
    },
    {
        icon: "filter",
        title: "Quality OEM-Spec Oil Filters",
        desc: "A degraded filter compromises fresh engine oil. We install OEM-grade pleated media filters with high burst-strength steel casings and reliable anti-drainback valves to protect against dry cold starts."
    },
    {
        icon: "search",
        title: "Physical Fluid & Undercarriage Inspection",
        desc: "Unlike drive-through suction bays, our lift-based gravity drain includes a visual underbody check for oil pan leaks, steering rack seepage, coolant hose cracking, and brake pad wear."
    },
    {
        icon: "receipt",
        title: "Itemised, Upfront Quotation",
        desc: "You receive an exact price based on your engine's oil sump capacity and required oil grade before work begins. No hidden disposal fees or unexplained surcharges at invoice."
    },
    {
        icon: "car",
        title: "Workshop & Mobile Roadside Availability",
        desc: "Visit our dedicated Al Satwa workshop on 222 Al Satwa Road, or request on-site mobile maintenance for routine servicing at your home or office in central Dubai. [CONFIRM: mobile oil change service area and van equipment]"
    },
    {
        icon: "clock",
        title: "Prompt Turnaround & Reset Service",
        desc: "Our workshop completes standard oil and filter servicing efficiently while carrying out manufacturer service interval resets on your dashboard computer."
    }
];

const faqs = [
    {
        q: "How often should engine oil be changed in Dubai?",
        a: "Due to high ambient temperatures exceeding 45°C, frequent traffic idling, and airborne dust, automotive engineers recommend adhering to the 'severe driving' service schedule outlined in your owner's manual. For fully synthetic oil, an interval of 8,000 to 10,000 km (or 6 months) is typical in Dubai, while semi-synthetic oils should generally be changed every 6,000 to 7,500 km, and conventional mineral oils every 5,000 km."
    },
    {
        q: "What is the best engine oil for driving in Dubai's heat?",
        a: "The best oil is the viscosity and specification mandated by your vehicle manufacturer. For modern Japanese, Korean, and American passenger cars, 0W-20 or 5W-30 full synthetic oils meeting API SP and ILSAC GF-6 standards provide optimal flow and thermal protection. European models (such as BMW, Mercedes-Benz, Audi, and Volvo) require specific manufacturer approvals (e.g., MB 229.5, BMW LL-04, VW 504/507, or Volvo VCC RBS0-2AE) with robust high-temperature high-shear (HTHS) ratings."
    },
    {
        q: "Can Dubai Car Repair Service perform an oil change at my home or office?",
        a: "Yes, our mobile servicing team can perform oil and filter replacements at your residential or commercial location across central Dubai, subject to parking access and safety clearance. The mobile service includes fresh oil, compatible filter, waste oil collection, and level verification. [CONFIRM: mobile oil change call-out fee and booking notice required]"
    },
    {
        q: "How does independent garage servicing compare to fuel-station lube bays (like ENOC or ADNOC)?",
        a: "Fuel-station lube bays typically use top-side vacuum suction through the dipstick tube to evacuate oil quickly. At our Al Satwa workshop, vehicles are raised on two-post hydraulic hoists for gravity drainage through the sump plug, allowing heavier metallic particles and sediment to escape. In addition, our mechanics perform visual underbody checks for oil leaks, axle boot tears, suspension slack, and brake condition during the service."
    },
    {
        q: "What happens if the wrong oil viscosity or specification is used?",
        a: "Using oil that is too thick (such as pouring 20W-50 into an engine requiring 0W-20) starves tight variable valve timing (VVT) solenoids and hydraulic lash adjusters of oil upon start-up, increasing friction and fuel consumption. Conversely, using oil that lacks required thermal shear resistance in a high-output turbocharged engine can cause the oil film to break down at high temperatures, leading to accelerated bearing wear and oil vaporization."
    },
    {
        q: "Why does my engine consume oil between scheduled service intervals?",
        a: "In the UAE, high operating temperatures can cause volatile fractions of lower-grade oils to evaporate. Modern high-compression engines may normally consume up to 0.5 litres of oil per 1,500–2,000 km. However, rapid consumption often points to hardened valve stem seals, stuck piston oil control rings, a malfunctioning PCV valve, or external gasket seepage (such as at the valve cover or oil pan), all of which we can diagnose during your service visit."
    }
];

const relatedServices = [
    { icon: "cog", title: "Car Engine Service Dubai", desc: "Engine diagnostics, repairs &amp; overhauls", href: "/car-engine-service-dubai" },
    { icon: "tools", title: "Car Servicing Dubai", desc: "Scheduled minor &amp; major vehicle service", href: "/car-maintenance-dubai" },
    { icon: "search", title: "Full Car Check Up", desc: "Comprehensive 50-point vehicle inspection", href: "/car-inspection-dubai" },
    { icon: "car", title: "Mobile Car Mechanic Dubai", desc: "Oil change &amp; maintenance at your location", href: "/mobile-car-repair-dubai" }
];

