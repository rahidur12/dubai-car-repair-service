        box-sizing: border-box;
    }

    @media (max-width: 480px) {
        .dcrs-hero-banner__actions {
            flex-direction: column;
            align-items: stretch;
        }
        .dcrs-hero-banner__actions .dcrs-btn {
            width: 100%;
        }
