                            </div>
                            <p class="dcrs-oil-card__desc">{o.desc}</p>
                            <div class="dcrs-oil-card__vehicles">
                                <strong class="dcrs-oil-card__vehicles-label">Common Vehicles:</strong>
                                <span class="dcrs-oil-card__vehicles-text">{o.vehicles}</span>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
