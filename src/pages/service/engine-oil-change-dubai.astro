                                            <td data-label="Vehicle Examples" class="dcrs-grade-examples">
                                                {g.examples}
                                            </td>
                                            <td data-label="Type">
                                                <span class="dcrs-pill-badge">{g.type}</span>
                                            </td>
                                            <td data-label="UAE Interval" class="dcrs-grade-interval">
                                                {g.interval}
                                            </td>
                                        </tr>
                                    ))}
                                </tbody>
                            </table>
                        </div>

                        <div class="dcrs-table-note">
                            <Fragment set:html={icons.infoCircle} />
                            <span>Recommended service intervals align with manufacturer severe-duty driving schedules to account for high ambient heat, idle time, and dust exposure.</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 5. PROCESS + PRICING --------------------------------------------->
        <section class="dcrs-section dcrs-section--tint" id="process-and-pricing">
            <div class="dcrs-container">
                <div class="dcrs-two-col">
                    <!-- Left: Process Steps -->
                    <div class="dcrs-two-col__col">
                        <div class="dcrs-kicker">Our Process</div>
                        <h2 class="dcrs-heading__title">How We Perform an Engine Oil Change in Dubai</h2>

