                            {steps.map((s) => (
                                <div class="dcrs-oil-step">
                                    <div class="dcrs-oil-step__num">{s.num}</div>
                                    <div class="dcrs-oil-step__body">
                                        <h4 class="dcrs-oil-step__title">{s.title}</h4>
                                        <p class="dcrs-oil-step__desc">{s.desc}</p>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>

                    <!-- Right: Pricing & UAE Interval Guide -->
                    <div class="dcrs-two-col__col">
                        <div class="dcrs-kicker">Pricing Guide</div>
                        <h2 class="dcrs-heading__title">Engine Oil Change Prices in Dubai</h2>

                        <div class="dcrs-price-table-wrap">
                            <table class="dcrs-price-table">
                                <thead>
                                    <tr>
                                        <th>Service</th>
                                        <th>Price (AED)</th>
                                        <th>Includes</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {pricingTable.map((p) => (
                                        <tr>
                                            <td><strong>{p.service}</strong></td>
                                            <td class="dcrs-price-cell">{p.price}</td>
                                            <td class="dcrs-include-cell">{p.includes}</td>
                                        </tr>
                                    ))}
                                </tbody>
                            </table>
                        </div>

                        <!-- Interval Box -->
                        <div class="dcrs-interval-box">
