                            <span class="dcrs-table-card__icon">
                                <Fragment set:html={icons.table} />
                            </span>
                            <h3 class="dcrs-table-card__title">
                                Oil Grade Quick Reference - Common Dubai Vehicles
                            </h3>
                        </div>

                        <div class="dcrs-table-wrap">
                            <table class="dcrs-responsive-table">
                                <thead>
                                    <tr>
                                        <th style="width: 15%;">Oil Grade</th>
                                        <th style="width: 50%;">Vehicle Examples</th>
                                        <th style="width: 15%;">Type</th>
                                        <th style="width: 20%; text-align: center;">UAE Interval</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {grades.map((g) => (
                                        <tr>
                                            <td data-label="Oil Grade">
                                                <strong class="dcrs-grade-highlight">{g.grade}</strong>
