                            <div class="dcrs-interval-box__rows">
                                {intervals.map((iv) => (
                                    <div class="dcrs-interval-row">
                                        <span class="dcrs-interval-row__name">{iv.oil}</span>
                                        <span class="dcrs-interval-row__val">{iv.interval}</span>
                                    </div>
                                ))}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 6. WHY CHOOSE US ------------------------------------------------->
        <section class="dcrs-section" id="why-choose-us">
            <div class="dcrs-container">
                <div class="dcrs-heading dcrs-heading--center">
                    <div class="dcrs-kicker">Why Choose Us</div>
                    <h2 class="dcrs-heading__title">Why Dubai Drivers Choose Us for an Oil Change Service in Dubai</h2>
                </div>

                <div class="dcrs-reasons-grid">
                    {reasons.map((r) => (
                        <div class="dcrs-reason-card">
                            <div class="dcrs-reason-card__icon">
                                <Fragment set:html={icons[r.icon]} />
                            </div>
                            <div class="dcrs-reason-card__body">
                                <h3 class="dcrs-reason-card__title">{r.title}</h3>
                                <p class="dcrs-reason-card__desc">{r.desc}</p>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- 7. FREQUENTLY ASKED QUESTIONS ------------------------------------>
        <section class="dcrs-section dcrs-section--tint" id="faq">
            <div class="dcrs-container">
                <div class="dcrs-heading dcrs-heading--center">
                    <div class="dcrs-kicker">FAQ</div>
                    <h2 class="dcrs-heading__title">Engine Oil Change Dubai - Questions Answered</h2>
                </div>

                <div class="dcrs-faq-wrap">
                    <div class="dcrs-accordion">
                        {faqs.map((faq, i) => (
                            <div class={`dcrs-accordion__item ${i === 0 ? 'is-open' : ''}`}>
                                <button
                                    type="button"
                                    class="dcrs-accordion__header"
                                    aria-expanded={i === 0 ? "true" : "false"}
                                    data-faq-toggle
                                >
                                    <span class="dcrs-accordion__title">{faq.q}</span>
                                    <span class="dcrs-accordion__arrow">
                                        <Fragment set:html={icons.chevronDown} />
                                    </span>
                                </button>
                                <div class="dcrs-accordion__panel" style={i === 0 ? "max-height: 500px;" : "max-height: 0;"}>
                                    <div class="dcrs-accordion__content">
                                        <p>{faq.a}</p>
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </section>

        <!-- 8. RELATED SERVICES ---------------------------------------------->
        <section class="dcrs-section" id="related-services">
            <div class="dcrs-container">
                <div class="dcrs-heading dcrs-heading--center">
                    <h2 class="dcrs-heading__title">Related Services</h2>
                </div>

                <div class="dcrs-related-grid">
                    {relatedServices.map((r) => (
                        <a href={r.href} class="dcrs-related-card">
                            <span class="dcrs-related-card__icon">
                                <Fragment set:html={icons[r.icon]} />
                            </span>
                            <h3 class="dcrs-related-card__title" set:html={r.title} />
                            <p class="dcrs-related-card__desc" set:html={r.desc} />
                        </a>
                    ))}
                </div>
            </div>
        </section>

        <!-- 9. CTA BANNER ---------------------------------------------------->
        <section class="dcrs-cta-banner">
            <div class="dcrs-container">
                <div class="dcrs-cta-banner__inner">
                    <div class="dcrs-cta-banner__copy">
                        <h2 class="dcrs-cta-banner__title">
                            Book Your Car Oil Change in Dubai Today
                        </h2>
                        <p class="dcrs-cta-banner__sub">
                            Open 7AM–10PM daily &bull; 222 Al Satwa Rd &bull; Workshop service &amp; mobile oil change available across Dubai. <a href="/contact" class="dcrs-cta-inline-link">Contact us</a> for a free quote.
                        </p>
                    </div>
                    <div class="dcrs-cta-banner__actions">
                        <a href={phoneHref} class="dcrs-btn dcrs-btn--solid">
                            <Fragment set:html={icons.phone} /> Call {phoneDisplay}
                        </a>
                        <a href={waHref} target="_blank" rel="noopener noreferrer" class="dcrs-btn dcrs-btn--wa">
                            <Fragment set:html={icons.chat} /> WhatsApp
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- 10. BOTTOM STICKY MOBILE BAR ------------------------------------->
        <div class="dcrs-stickybar">
            <a href={phoneHref} class="dcrs-btn dcrs-btn--solid dcrs-stickybar__btn">
                <Fragment set:html={icons.phone} /> Call Now
            </a>
            <a href={waHref} target="_blank" rel="noopener noreferrer" class="dcrs-btn dcrs-btn--solid dcrs-stickybar__btn dcrs-stickybar__btn--wa">
                <Fragment set:html={icons.chat} /> WhatsApp
            </a>
        </div>

    </main>
</BaseLayout>

<style>
    /* Scoped styling preserving template design tokens */
    :root {
        --ink: #10201F;
        --ink-soft: #1B302E;
        --paper: #E8E4D8;
        --paper-alt: #DFDACB;
        --white: #FBF9F4;
        --brass: #C1802E;
        --brass-deep: #9C6423;
        --steel: #57706E;
    }

    .dcrs-service-page {
        padding-bottom: 0;
        width: 100%;
        max-width: 100%;
        overflow-x: clip;
        box-sizing: border-box;
    }

    @media (min-width: 768px) {
        .dcrs-service-page {
            padding-bottom: 0;
        }
    }

    /* Hide floating WhatsApp button on mobile to prevent overlapping bottom sticky bar */
    @media (max-width: 767.98px) {
        :global(.float) {
            display: none !important;
        }
    }

    .dcrs-container {
        width: 100%;
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 1.25rem;
        box-sizing: border-box;
    }

    @media (max-width: 480px) {
        .dcrs-container {
            padding: 0 0.85rem;
        }
    }

    /* 1. HERO BANNER */
    .dcrs-hero-banner {
        position: relative;
        background-color: var(--ink, #10201F);
        color: var(--white, #FBF9F4);
        padding: clamp(3.5rem, 8vw, 5.5rem) 0;
        overflow: hidden;
        min-height: 500px;
        display: flex;
        align-items: center;
        box-sizing: border-box;
    }

    @media (max-width: 767.98px) {
        .dcrs-hero-banner {
            min-height: auto;
            padding: clamp(3rem, 7vw, 4rem) 0;
        }
    }

    .dcrs-hero-banner .dcrs-container {
        width: 100%;
    }

    .dcrs-hero-banner__scrim {
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 80% 20%, rgba(193, 128, 46, 0.15), transparent 50%);
        pointer-events: none;
    }

    .dcrs-hero-banner__inner {
        position: relative;
        z-index: 1;
        max-width: 820px;
    }

    .dcrs-breadcrumb ol {
        list-style: none;
        padding: 0;
        margin: 0 0 1rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        font-family: var(--font-mono, monospace);
        font-size: 0.82rem;
        color: rgba(251, 249, 244, 0.65);
    }

    .dcrs-breadcrumb li + li::before {
        content: "/";
        margin-right: 0.5rem;
        color: rgba(251, 249, 244, 0.4);
    }

    .dcrs-breadcrumb a {
        color: rgba(251, 249, 244, 0.75);
        text-decoration: none;
    }

    .dcrs-breadcrumb a:hover {
        color: var(--brass, #C1802E);
    }

    .dcrs-badge {
        display: inline-block;
        font-family: var(--font-mono, monospace);
        font-size: 0.78rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--brass, #C1802E);
        font-weight: 600;
        margin-bottom: 0.6rem;
    }

    .dcrs-hero-banner__title {
        font-family: var(--font-display, serif);
        font-size: clamp(1.5rem, 5.5vw, 2.9rem);
        line-height: 1.2;
        letter-spacing: -0.01em;
        margin: 0 0 1rem;
        color: var(--white, #FBF9F4);
        word-break: break-word;
        overflow-wrap: break-word;
    }

    .dcrs-hero-banner__lead {
        font-size: clamp(0.92rem, 2.6vw, 1.15rem);
        line-height: 1.65;
        color: rgba(251, 249, 244, 0.85);
