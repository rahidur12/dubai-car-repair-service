// ---------------------------------------------------------------------------
// Section Data
// ---------------------------------------------------------------------------
const packages = [
    {
        title: "Basic Service",
        price: "From AED 200 [CONFIRM: basic service package starting price and range]",
        freq: "Every 5,000–8,000 km or 4–6 months",
        badge: "Essential Care",
        desc: "Targeted lubrication and preventive inspection to protect internal engine components between major services. Essential for high ambient temperatures and stop-and-go driving across Dubai.",
        items: [
            "Engine oil drain via gravity and refill with correct OEM-spec viscosity",
            "OEM-quality oil filter replacement with fresh sump plug crush washer",
            "Drained oil visual inspection for coolant contamination, sludge, or particulate wear",
            "Engine air intake filter inspection and housing clearance",
            "Cold tyre pressure adjustment across all four wheels and spare",
            "Essential fluid top-up check -brake fluid, coolant, steering fluid, and washer reservoir",
            "12V battery open-circuit voltage and terminal corrosion inspection",
            "Exterior and safety lighting operation check (headlights, brake, hazard)",
            "Underbody visual check for active fluid weeping or exhaust hanger damage"
        ]
    },
    {
        title: "Full Service",
        price: "From AED 450 [CONFIRM: full service package starting price and range]",
        freq: "Every 15,000 km or 6–9 months",
        badge: "Recommended",
        desc: "Comprehensive mid-tier service covering all basic maintenance items plus multi-system inspection and secondary filtration replacement accelerated by UAE heat and desert dust.",
        items: [
            "Everything included in the Basic Service package",
            "Engine air filter element replacement",
            "Cabin pollen and AC microfilter replacement to restore HVAC ventilation",
            "Brake pad friction lining measurement across all four corners",
            "Brake rotor disc surface inspection, lip measurement, and caliper slider check",
            "Brake fluid boiling point and moisture contamination test",
            "Coolant concentration, glycol ratio, and freeze/boil point testing",
            "Digital conductance battery health test (CCA vs rated capacity)",
            "OBD-II diagnostic scan across powertrain, ABS, and body control modules",
            "Tyre tread depth measurement, uneven wear analysis, and DOT age audit",
            "Drive belt serpentine rib inspection for glazing, cracks, and tension",
            "Chassis suspension inspection -ball joints, control arm bushes, and damper seals",
            "Full underbody ramp inspection with itemised condition report"
        ]
    },
    {
        title: "Major Service",
        price: "From AED 900 [CONFIRM: major service package starting price and range]",
        freq: "Every 30,000–40,000 km or 12–18 months",
        badge: "Complete Reset",
        desc: "The complete vehicle reset covering critical scheduled wear items, multi-system fluid flushes, filtration overhaul, and full chassis safety diagnostics. Recommended annually for high-demand Dubai driving.",
        items: [
            "Everything included in the Full Service package",
            "Spark plug replacement with manufacturer-specified platinum or iridium plugs",
            "Fuel filtration system inspection and external filter replacement where applicable",
            "Transmission fluid and differential gear oil condition assessment and top-up",
            "Brake fluid full system pressure flush and bleed (DOT 4 or DOT 5.1)",
            "Engine cooling system drain, chemical flush, and refill with fresh premixed coolant",
