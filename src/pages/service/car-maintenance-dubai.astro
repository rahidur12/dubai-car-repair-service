        <!-- 7. WHY CHOOSE DUBAI CAR REPAIR SERVICE? -------------------------->
        <section class="dcrs-section dcrs-section--tint" id="why-choose-us">
            <div class="dcrs-container">
                <div class="dcrs-heading dcrs-heading--center">
                    <div class="dcrs-kicker">Why Choose Us</div>
                    <h2 class="dcrs-heading__title">Why Dubai Drivers Trust Us for Vehicle Maintenance</h2>
                    <p class="dcrs-heading__sub">Independent mechanical care, factory-specification parts, and transparent servicing since 2012.</p>
                </div>

                <div class="dcrs-reasons-grid">
                    {reasons.map((r) => (
                        <div class="dcrs-reason-card">
                            <span class="dcrs-reason-card__icon">
                                <Fragment set:html={icons[r.icon]} />
                            </span>
                            <div>
                                <h3 class="dcrs-reason-card__title">{r.title}</h3>
                                <p class="dcrs-reason-card__text">{r.desc}</p>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- 8. FREQUENTLY ASKED QUESTIONS (FAQ) ----------------------------->
        <section class="dcrs-section dcrs-section--paper" id="faq">
            <div class="dcrs-container">
                <div class="dcrs-heading dcrs-heading--center">
                    <div class="dcrs-kicker">FAQ</div>
                    <h2 class="dcrs-heading__title">Car Maintenance Dubai - Frequently Asked Questions</h2>
                </div>

                <div class="dcrs-faq-accordion">
                    {faqs.map((faq, i) => (
                        <details class="dcrs-faq-item" open={i === 0}>
                            <summary class="dcrs-faq-item__question">
                                <span>{faq.q}</span>
                                <span class="dcrs-faq-item__toggle">
                                    <Fragment set:html={icons.chevronDown} />
                                </span>
                            </summary>
                            <div class="dcrs-faq-item__answer">
                                <p>{faq.a}</p>
                            </div>
                        </details>
                    ))}
