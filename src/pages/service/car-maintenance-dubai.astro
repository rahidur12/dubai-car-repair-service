</BaseLayout>

<style>
    /* Scoped styling preserving template design tokens */
    :root {
        --ink: #10201F;
        --ink-soft: #1B302E;
        --paper: #E8E4D8;
        --paper-alt: #DFDACB;
        --white: #FBF9F4;
        --brass: #D48E33;
        --brass-deep: #9C6423;
        --steel: #354D4B;
        --rule-on-paper: rgba(16, 32, 31, 0.15);
        --rule-on-ink: rgba(251, 249, 244, 0.16);
    }

    .dcrs-service-page {
        padding-bottom: 0;
        width: 100%;
        max-width: 100%;
        overflow-x: hidden;
        box-sizing: border-box;
    }

    @media (min-width: 768px) {
        .dcrs-service-page {
            padding-bottom: 0;
        }
    }

    /* Hide floating WhatsApp button on mobile when sticky bar is active */
    @media (max-width: 767.98px) {
        :global(.float) {
            display: none !important;
        }
    }

    .dcrs-container {
        width: 100%;
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 1.25rem;
        box-sizing: border-box;
    }

    @media (max-width: 480px) {
        .dcrs-container {
            padding: 0 0.85rem;
        }
    }

    /* Kicker & Typography */
    .dcrs-kicker {
        display: inline-block;
        font-family: var(--font-mono, monospace);
        font-size: 0.76rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--brass-deep);
        font-weight: 600;
        margin-bottom: 0.5rem;
        max-width: 100%;
        white-space: normal;
        word-break: break-word;
        box-sizing: border-box;
    }

    .dcrs-heading {
        margin-bottom: 2.5rem;
    }

    .dcrs-heading--center {
        text-align: center;
        max-width: 680px;
        margin-left: auto;
        margin-right: auto;
    }

    .dcrs-heading__title {
        font-family: var(--font-display, serif);
        font-size: clamp(1.65rem, 4.2vw, 2.35rem);
        line-height: 1.2;
        color: var(--ink);
        margin: 0 0 0.6rem;
    }

    .dcrs-heading__sub {
        color: var(--steel);
        font-size: 0.98rem;
        line-height: 1.6;
        margin: 0;
    }

    .dcrs-lead-text {
        font-size: 1.05rem;
        line-height: 1.7;
        color: var(--ink);
        margin: 0 0 1.2rem;
    }

    .dcrs-body-text {
        font-size: 0.96rem;
        line-height: 1.75;
        color: var(--steel);
        margin: 0 0 1.2rem;
    }

    .dcrs-inline-link {
        color: var(--brass-deep);
        font-weight: 600;
        text-decoration: underline;
        text-underline-offset: 3px;
    }

    /* Section Wrappers */
    .dcrs-section {
        padding: clamp(3rem, 6.5vw, 5rem) 0;
    }
    .dcrs-section--paper { background: var(--paper); }
    .dcrs-section--tint { background: var(--paper-alt); }

    /* Buttons */
    .dcrs-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        font-family: var(--font-body, sans-serif);
        font-weight: 600;
        font-size: 0.95rem;
        padding: 0.85rem 1.4rem;
        border-radius: 4px;
        border: 1px solid transparent;
        text-decoration: none;
        line-height: 1;
        cursor: pointer;
        transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
        min-height: 48px;
    }

    .dcrs-btn :global(svg) {
        width: 18px;
        height: 18px;
        flex-shrink: 0;
    }

    .dcrs-btn--solid {
        background: var(--brass);
        color: var(--ink);
    }
    .dcrs-btn--solid:hover {
        background: var(--brass-deep);
        color: #fff;
    }

    .dcrs-btn--outline-ink {
        background: transparent;
        color: var(--ink);
        border-color: var(--ink);
    }
    .dcrs-btn--outline-ink:hover {
        background: var(--ink);
        color: var(--white);
    }

    .dcrs-btn--wa {
        background: #25d366;
        color: #fff;
    }
    .dcrs-btn--wa:hover {
        background: #1ebc59;
    }

    .dcrs-action-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.85rem;
        margin-top: 1.75rem;
    }

    /* 1. Hero Banner */
    .dcrs-hero-banner {
        position: relative;
        background-color: var(--ink);
        color: var(--white);
        padding: clamp(3.5rem, 8vw, 5.5rem) 0;
        overflow: hidden;
        min-height: 500px;
        display: flex;
        align-items: center;
        box-sizing: border-box;
    }

    @media (max-width: 767.98px) {
        .dcrs-hero-banner {
            min-height: auto;
            padding: clamp(3rem, 7vw, 4rem) 0;
        }
    }

    .dcrs-hero-banner .dcrs-container {
        width: 100%;
    }

    .dcrs-hero-banner__scrim {
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 80% 20%, rgba(193, 128, 46, 0.15), transparent 50%);
        pointer-events: none;
    }

    .dcrs-hero-banner__inner {
        position: relative;
        z-index: 1;
        max-width: 820px;
    }

    .dcrs-breadcrumb ol {
        list-style: none;
        padding: 0;
        margin: 0 0 1rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        font-family: var(--font-mono, monospace);
        font-size: 0.82rem;
        color: rgba(251, 249, 244, 0.65);
    }

    .dcrs-breadcrumb li + li::before {
        content: "/";
        margin-right: 0.5rem;
        color: rgba(251, 249, 244, 0.4);
    }

    .dcrs-breadcrumb a {
        color: rgba(251, 249, 244, 0.75);
        text-decoration: none;
    }

    .dcrs-breadcrumb a:hover {
        color: var(--brass);
    }

    .dcrs-badge {
        display: inline-block;
        font-family: var(--font-mono, monospace);
        font-size: 0.78rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--brass);
        font-weight: 600;
        margin-bottom: 0.6rem;
    }

    .dcrs-hero-banner__title {
        font-family: var(--font-display, serif);
        font-size: clamp(1.5rem, 5.5vw, 2.9rem);
        line-height: 1.2;
        letter-spacing: -0.01em;
        margin: 0 0 1rem;
        color: var(--white);
        word-break: break-word;
        overflow-wrap: break-word;
    }

    .dcrs-hero-banner__lead {
        font-size: clamp(0.92rem, 2.6vw, 1.15rem);
        line-height: 1.65;
        color: rgba(251, 249, 244, 0.85);
        word-break: break-word;
        overflow-wrap: break-word;
        margin: 0 0 2rem;
    }

    .dcrs-hero-banner__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.85rem;
        width: 100%;
        box-sizing: border-box;
    }

    @media (max-width: 480px) {
        .dcrs-hero-banner__actions {
            flex-direction: column;
            align-items: stretch;
        }
        .dcrs-hero-banner__actions .dcrs-btn {
            width: 100%;
        }
    }

    /* 2. Grid Layouts */
    .dcrs-grid-2col {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 2.5rem;
        width: 100%;
    }

    .dcrs-grid-2col > * {
        min-width: 0;
        max-width: 100%;
    }

    @media (min-width: 992px) {
        .dcrs-grid-2col {
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
            gap: 3.5rem;
        }
    }

    .dcrs-grid-2col--align-center {
        align-items: center;
    }

    /* Media Frame & Price Badge */
    .dcrs-intro-media__frame {
        position: relative;
