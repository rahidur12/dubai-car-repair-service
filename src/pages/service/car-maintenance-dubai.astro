];

const climateImpacts = [
    { icon: "oilCan", title: "Engine Oil", desc: "Thermal oxidation and shear degradation accelerate in sustained 40°C+ ambient heat. Viscosity breaks down faster, requiring shorter drain intervals." },
    { icon: "battery", title: "12V Battery", desc: "Extreme under-hood engine bay temperatures accelerate positive plate grid corrosion and electrolyte evaporation, reducing typical battery lifespan to 2–3 years." },
    { icon: "drop", title: "Brake Fluid", desc: "Hygroscopic brake fluid absorbs atmospheric moisture in coastal Dubai humidity. Moisture depresses the boiling point, increasing vapour-lock fade risk under hard braking." },
    { icon: "snowflake", title: "AC System", desc: "Automotive HVAC compressors operate near maximum duty cycle for 6+ continuous months, placing extreme thermal stress on shaft seals, condensers, and expansion valves." },
    { icon: "filter", title: "Cabin Air Filter", desc: "Fine desert sand and airborne dust rapidly restrict pleated filter media, choking airflow and fostering musty bacterial odours in the cabin HVAC system." },
    { icon: "thermometer", title: "Engine Coolant", desc: "Extended high-temperature operation depletes corrosion inhibitor packages and acidifies coolant pH, risking radiator core scaling and head gasket erosion." },
    { icon: "disc", title: "Tyres", desc: "Road asphalt temperatures exceeding 65°C accelerate vulcanised rubber hardening, dry rotting, and tread oxidation. UAE traffic regulations strictly enforce a 5-year maximum tyre age." },
    { icon: "tools", title: "Rubber Hoses & Belts", desc: "Thermal cycling hardens EPDM auxiliary drive belts and radiator hoses, causing micro-cracking, tension loss, and sudden coolant hose blowouts." }
];

const intervals = [
    { item: "Engine Oil (Synthetic)", mfr: "Every 10,000–15,000 km", uae: "Every 7,500–10,000 km / 6 months [CONFIRM: severe interval recommendation]" },
    { item: "Engine Oil (Semi-Synthetic/Mineral)", mfr: "Every 5,000–7,500 km", uae: "Every 4,000–5,000 km / 3–4 months [CONFIRM: mineral interval]" },
    { item: "Engine Air Filter", mfr: "Every 20,000–30,000 km", uae: "Every 10,000–15,000 km (inspect every 5k)" },
    { item: "Cabin Air Filter", mfr: "Every 20,000 km / 12 months", uae: "Every 10,000 km / 6 months" },
    { item: "Spark Plugs (Iridium/Platinum)", mfr: "Every 80,000–100,000 km", uae: "Every 50,000–60,000 km" },
    { item: "Brake Fluid Flush", mfr: "Every 24 months / 40,000 km", uae: "Every 12–18 months / 30,000 km" },
    { item: "Cooling System Flush", mfr: "Every 4–5 years / 100,000 km", uae: "Every 2 years / 40,000–50,000 km" },
    { item: "12V Battery Conductance Test", mfr: "Every 24 months", uae: "Every 6 months (after 18 months)" },
    { item: "Tyre Safety & Age Audit", mfr: "5–6 year replacement limit", uae: "Annual check; strict 5-year UAE RTA limit" }
];

const reasons = [
    { icon: "thermometer", title: "UAE Severe-Duty Service Schedules", desc: "We tailor maintenance protocols to actual Gulf operating realities: high ambient heat, extended idle hours with maximum AC load, and airborne dust that degrade lubricants and filters faster than standard factory baselines." },
    { icon: "award", title: "Verified OEM-Specification Parts & Fluids", desc: "We never use unbranded lubricants or grey-market filtration elements. Every oil, fluid, and replacement filter installed at our Al Satwa workshop matches or exceeds manufacturer viscosity grades and engineering certifications." },
    { icon: "fileText", title: "Complete Itemised Service Records", desc: "Following every scheduled maintenance, you receive an itemised invoice and service record detailing all fluids, filter part numbers, and diagnostic tests performed. This documented history preserves your vehicle's resale value and warranty traceability." },
    { icon: "search", title: "Multi-Point Preventive Condition Reports", desc: "Our technicians inspect safety and wear items beyond the routine checklist. You receive a transparent breakdown of brake pad thickness, tyre tread depth, and belt condition so you can plan future maintenance without unexpected surprises." },
    { icon: "car", title: "Multi-Brand Workshop Expertise", desc: "Located at 222 Al Satwa Road, our facility is equipped with multi-system scan tools, hydraulic vehicle lifts, and calibrated fluid-exchange machinery suited for Japanese, European, American, and Korean vehicles." },
    { icon: "receipt", title: "No Unnecessary Service Upselling", desc: "We recommend only what your vehicle legitimately requires based on elapsed time, recorded mileage, and verified physical inspection. If a component is in sound working order, we leave it alone." }
];

const faqs = [
    {
        q: "How often should I service my car in Dubai?",
        a: "Due to sustained summer ambient temperatures exceeding 40°C, stop-and-go highway traffic, and continuous AC compressor load, vehicle manufacturers classify Dubai driving as 'severe service.' Under these conditions, engine oil and filters should be replaced every 7,500–10,000 km (for fully synthetic oils) or every 5,000 km (for semi-synthetic oils). A full service should be performed every 15,000 km or 6 months, and a major service every 30,000–40,000 km or 12 months. [CONFIRM: severe interval recommendations]"
    },
    {
        q: "What is the difference between a Full Service and a Major Service?",
        a: "A Full Service focuses on essential fluid replacements (oil and filter), engine and cabin air filters, brake lining inspection, battery load testing, and underbody safety checks. A Major Service is a comprehensive vehicle reset: it includes everything in a full service plus spark plug replacement, complete brake fluid flush, engine coolant exchange, gearbox and differential fluid condition checks, throttle body cleaning, and four-wheel alignment checks."
    },
    {
        q: "Does servicing my car at an independent garage void my warranty in Dubai?",
        a: "No. Under UAE Consumer Protection regulations, having your vehicle serviced at an independent automotive workshop does not invalidate your manufacturer or dealer warranty, provided the service follows the manufacturer's specified service schedule, uses OEM-approved parts and fluids, and is supported by a stamped, itemised service invoice. We provide complete documentation specifying parts, oil viscosities, and labour performed."
    },
    {
        q: "How long does a scheduled car maintenance service take?",
        a: "Service turnaround depends on the package selected and workshop scheduling. A basic oil and filter service typically takes 45 to 60 minutes. A full scheduled service with multi-point inspections takes approximately 2 to 3 hours. A major service requiring complete fluid flushes, spark plug replacement, and alignment takes 4 to 6 hours. We provide a confirmed completion estimate when you drop off your vehicle at our Al Satwa workshop. [CONFIRM: workshop turnaround times]"
    },
    {
        q: "What is the difference between routine maintenance and mechanical repairs?",
        a: "Scheduled maintenance is preventive: it replaces fluids, filters, and predictable wear items before they fail, ensuring optimum lubrication and preventing component wear. Mechanical repair is corrective: it addresses components that have already malfunctioned, worn beyond tolerance, or broken (such as a seized AC compressor, worn alternator, or blown radiator hose). Regular maintenance minimizes the risk of costly corrective repairs."
    },
    {
        q: "Can you service my vehicle if I do not have its past service history?",
        a: "Yes. When customers bring in recently purchased pre-owned vehicles with missing records, our technicians conduct a comprehensive baseline health assessment. We test brake fluid boiling point, check coolant pH and specific gravity, inspect spark plug electrode gap, perform a battery conductance test, check tyre DOT manufacture dates, and scan all onboard ECUs for stored diagnostic trouble codes. This gives you an accurate snapshot of the vehicle's true mechanical health."
    }
];

const relatedServices = [
    { icon: "oilCan", name: "Engine Oil Change Dubai", desc: "Premium synthetic oil & OEM filter replacement", href: "/engine-oil-change-dubai" },
    { icon: "search", name: "Full Car Check Up", desc: "50-point pre-RTA, electrical & mechanical inspection", href: "/car-inspection-dubai" },
    { icon: "cog", name: "Car Engine Service Dubai", desc: "Precision engine diagnostics & cooling repairs", href: "/car-engine-service-dubai" },
    { icon: "circle", name: "Mobile Car Service Dubai", desc: "On-site scheduled maintenance & minor repairs", href: "/mobile-car-repair-dubai" }
];

