                <div class="dcrs-heading dcrs-heading--center">
                    <div class="dcrs-kicker">Warning Signs</div>
                    <h2 class="dcrs-heading__title">Signs Your Car Needs Immediate Maintenance</h2>
                    <p class="dcrs-heading__sub">
                        Watch for these indicators that your vehicle requires prompt fluid renewal, filter replacement, or professional inspection.
                    </p>
                </div>

                <div class="dcrs-steps-grid--6col">
                    {warningSigns.map((w) => (
                        <div class="dcrs-step-card">
                            <span class="dcrs-step-card__num">{w.num}</span>
                            <h3 class="dcrs-step-card__title">{w.title}</h3>
                            <p class="dcrs-step-card__desc">{w.desc}</p>
                            <div class="dcrs-step-card__action">
                                <strong>Recommended Action:</strong> {w.action}
                            </div>
                        </div>
                    ))}
