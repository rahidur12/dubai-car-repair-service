                            <h3 class="dcrs-climate-card__title">{c.title}</h3>
                            <p class="dcrs-climate-card__desc">{c.desc}</p>
                            <div class="dcrs-climate-card__impact">
                                <strong>Maintenance Focus:</strong> {c.impact}
                            </div>
                        </div>
                    ))}
                </div>

                <div class="dcrs-intervals-wrap">
                    <h3 class="dcrs-subheading">Recommended Service Intervals in Dubai</h3>
                    <p class="dcrs-subheading-lead">
                        Service intervals vary by manufacturer guidelines, engine design, vehicle age, mileage, oil type, and operating environment. The table below outlines standard manufacturer baselines alongside general severe-driving recommendations for vehicles operating in Dubai conditions.
                    </p>
                    <div class="dcrs-table-wrapper">
                        <table class="dcrs-pricing-table">
                            <thead>
                                <tr>
                                    <th>Maintenance Item</th>
                                    <th>Standard Manufacturer Baseline</th>
                                    <th>Dubai / Severe Driving Guidance</th>
                                </tr>
                            </thead>
                            <tbody>
                                {intervals.map((iv) => (
                                    <tr>
                                        <td class="dcrs-table-service">{iv.item}</td>
                                        <td class="dcrs-table-mfr">{iv.mfr}</td>
                                        <td class="dcrs-table-uae">{iv.uae}</td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </div>
                    <p class="dcrs-pricing-disclaimer">
                        <Fragment set:html={icons.info} /> Always consult your vehicle's owner manual for official service requirements, warranty conditions, and fluid specifications.
                    </p>
                </div>
            </div>
        </section>

        <!-- 6. SIGNS YOU NEED THIS SERVICE ----------------------------------->
