const relatedServices = [
    { icon: "snowflake", name: "Car AC Repair Dubai", desc: "Compressor servicing, gas recharge & leak tests", href: "/car-ac-repair-dubai" },
    { icon: "battery", name: "Car Battery Replacement Dubai", desc: "Workshop & on-site fitting with warranty", href: "/car-battery-replacement-dubai" },
    { icon: "disc", name: "Tyre Replacement Dubai", desc: "Tyre supply, electronic balancing & puncture fixes", href: "/tyre-replacement-dubai" },
