// ---------------------------------------------------------------------------
const pageTitle = "Car Repair Satwa | Auto Garage & Mechanic Workshop";
const pageDescription = "Car repair satwa at 222 Al Satwa Rd. Full auto garage & mechanic services: diagnostics, AC, battery & tyre replacement. Open daily. Call now!";

const phoneDisplay = "+971 56 612 1423";
