---

<BaseLayout
    title={pageTitle}
    description={pageDescription}
>
    <!-- Structured JSON-LD Schema Graph -->
    <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

    <main class="dcrs-location-page">

        <!-- 1. HERO BANNER --------------------------------------------------->
        <header class="dcrs-hero-banner">
            <div class="dcrs-hero-banner__scrim"></div>
            <div class="dcrs-container dcrs-hero-banner__inner">
                <nav class="dcrs-breadcrumb" aria-label="Breadcrumb">
                    <ol>
                        <li><a href="/">Home</a></li>
                        <li><a href="/#service">Locations</a></li>
                        <li aria-current="page">Car Repair Al Satwa</li>
                    </ol>
                </nav>
                <span class="dcrs-badge">Physical Auto Workshop · 222 Al Satwa Rd · Open Daily 7:00 AM – 10:00 PM</span>
                <h1 class="dcrs-hero-banner__title">
                    Car Repair Satwa — Auto Garage &amp; Expert Mechanic Workshop
                </h1>
                <p class="dcrs-hero-banner__lead">
                    Looking for dependable <strong>car repair satwa</strong> drivers trust? Based at <strong>222 Al Satwa Road</strong>, our certified auto garage provides complete mechanical servicing, computer diagnostics, AC repairs, battery testing, and rapid local call-out assistance across central Dubai.
                </p>
                <div class="dcrs-hero-banner__actions">
                    <a href={phoneHref} class="dcrs-btn dcrs-btn--solid">
                        <Fragment set:html={icons.phone} /> Call {phoneDisplay}
                    </a>
                    <a href={waHref} target="_blank" rel="noopener noreferrer" class="dcrs-btn dcrs-btn--wa">
                        <Fragment set:html={icons.chat} /> WhatsApp Us
                    </a>
                </div>
            </div>
        </header>

        <!-- 2. TRUST / HIGHLIGHT STRIP --------------------------------------->
        <section class="dcrs-strip" aria-label="Workshop Highlights">
            <div class="dcrs-container">
                <div class="dcrs-strip__grid">
                    <div class="dcrs-strip__item">
                        <span class="dcrs-strip__icon"><Fragment set:html={icons.mapPin} /></span>
                        <div>
                            <strong>222 Al Satwa Rd</strong>
                            <span>Physical Workshop Base</span>
                        </div>
                    </div>
                    <div class="dcrs-strip__item">
                        <span class="dcrs-strip__icon"><Fragment set:html={icons.award} /></span>
                        <div>
                            <strong>12+ Years in Satwa</strong>
                            <span>8,500+ Vehicles Repaired</span>
                        </div>
                    </div>
                    <div class="dcrs-strip__item">
                        <span class="dcrs-strip__icon"><Fragment set:html={icons.tools} /></span>
                        <div>
                            <strong>8 Master Mechanics</strong>
                            <span>Multi-Brand Certified</span>
                        </div>
                    </div>
                    <div class="dcrs-strip__item">
                        <span class="dcrs-strip__icon"><Fragment set:html={icons.clock} /></span>
                        <div>
                            <strong>15-Min Call-Out</strong>
                            <span>Local Mobile Assistance</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 3. INTRO SECTION / PHYSICAL WORKSHOP BASE ------------------------>
        <section class="dcrs-section dcrs-section--paper" id="satwa-overview">
            <div class="dcrs-container">
                <div class="dcrs-grid-2col dcrs-grid-2col--align-center">
                    
                    <div class="dcrs-intro-content">
                        <div class="dcrs-kicker">Authentic Neighborhood Workshop</div>
                        <h2 class="dcrs-heading__title">
                            Expert Car Repair Satwa Drivers Trust — Real Workshop &amp; Local Mechanics
                        </h2>
                        <p class="dcrs-lead-text">
                            When searching for dependable <strong>car repair satwa</strong>, you want an established auto garage with certified mechanics on-site rather than distant call centers that tow your vehicle to industrial yards in Al Quoz.
                        </p>
                        <p class="dcrs-body-text">
                            At <a href="/" class="dcrs-inline-link">dubai car repair service</a>, Al Satwa is our permanent home base. Located at <strong>222 Al Satwa Road</strong>—just moments from 2nd December Street (Al Diyafah), Satwa Roundabout, and the Iranian Hospital—our garage features dedicated hydraulic lift bays, computerized OBD-II scanning equipment, and an extensive genuine parts inventory.
                        </p>
                        <p class="dcrs-body-text">
                            Whether you need complete <strong>car repair al satwa</strong> services in our workshop bays or need an experienced <strong>car mechanic satwa</strong> dispatched to your driveway because your engine won't crank, our team delivers dealership-standard workmanship at fair, upfront prices.
                        </p>

                        <div class="dcrs-features-inline">
                            <div class="dcrs-feature-check">
                                <span class="dcrs-check-icon"><Fragment set:html={icons.check} /></span>
                                <span>Drive straight into our workshop at 222 Al Satwa Road — no middleman towing</span>
                            </div>
                            <div class="dcrs-feature-check">
                                <span class="dcrs-check-icon"><Fragment set:html={icons.check} /></span>
                                <span>Serving drivers across Al Satwa, Al Wasl, Al Bada'a, Jumeirah 1, and Downtown</span>
                            </div>
                            <div class="dcrs-feature-check">
                                <span class="dcrs-check-icon"><Fragment set:html={icons.check} /></span>
                                <span>Direct highway connection via our nearby <a href="/car-repair-sheikh-zayed-road" class="dcrs-inline-link">car repair sheikh zayed road</a> response network</span>
                            </div>
                        </div>

                        <div class="dcrs-action-row">
                            <a href={phoneHref} class="dcrs-btn dcrs-btn--solid">
                                <Fragment set:html={icons.phone} /> Call Workshop
                            </a>
                            <a href="/contact" class="dcrs-btn dcrs-btn--outline-ink">
                                Book Repair Appointment <Fragment set:html={icons.arrowRight} />
                            </a>
                        </div>
                    </div>

                    <div class="dcrs-intro-media">
                        <div class="dcrs-intro-media__frame">
                            <img
                                src={diagnosticImage.src}
                                alt="Mechanic providing car repair satwa diagnostics at 222 Al Satwa Rd workshop"
                                loading="eager"
                                width="600"
                                height="420"
                            />
                            <div class="dcrs-plate dcrs-price-badge" aria-hidden="true">
                                <div class="dcrs-plate__tab">AL SATWA</div>
                                <div class="dcrs-plate__body">
                                    <span class="dcrs-plate__row dcrs-plate__row--big">#222</span>
                                    <span class="dcrs-plate__row">AL SATWA RD</span>
                                    <span class="dcrs-plate__row">OPEN DAILY 7AM–10PM</span>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- 4. CORE SERVICES GRID (AC, TYRE, BATTERY & MECHANIC) ------------->
        <section class="dcrs-section dcrs-section--white" id="satwa-services">
            <div class="dcrs-container">
                <div class="dcrs-heading dcrs-heading--center">
                    <span class="dcrs-kicker">Complete Automotive Solutions</span>
                    <h2 class="dcrs-heading__title">
                        Full-Service Auto Care in Al Satwa, Dubai
                    </h2>
                    <p class="dcrs-heading__desc">
                        Our garage handles all mechanical, cooling, and electrical repairs under one roof, backed by modern diagnostic tools and factory-certified parts.
                    </p>
                </div>

                <div class="dcrs-services-grid">
                    {satwaServices.map((item) => (
                        <div class="dcrs-service-card">
                            <div class="dcrs-service-card__head">
                                <span class="dcrs-service-card__icon">
                                    <Fragment set:html={icons[item.icon] || icons.tools} />
                                </span>
                                <span class="dcrs-service-card__badge">{item.badge}</span>
                            </div>
                            <h3 class="dcrs-service-card__title">{item.title}</h3>
                            <p class="dcrs-service-card__desc">{item.desc}</p>
                            <a href={item.link} class="dcrs-service-card__link">
                                Explore Service <Fragment set:html={icons.arrowRight} />
                            </a>
                        </div>
                    ))}
                </div>
            </div>
