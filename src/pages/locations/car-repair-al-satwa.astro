---
import BaseLayout from '../../layouts/BaseLayout.astro';
import diagnosticImage from '../../assets/images/loc1.webp';

// ---------------------------------------------------------------------------
// Page Metadata & Settings (Strict SEO Requirements)
// Title <= 60 chars | Description <= 155 chars | Primary: "car repair in al satwa"
// ---------------------------------------------------------------------------
const pageTitle = "Car Repair in Al Satwa | Auto Garage & Workshop Dubai";
const pageDescription = "Car repair in Al Satwa at 222 Al Satwa Road. Full auto garage services: diagnostics, AC, battery & tyre replacement. Open daily 7 AM–10 PM. Call now!";

const phoneDisplay = "+971 56 612 1423";
const phoneHref = "tel:+971566121423";
const waHref = "https://api.whatsapp.com/send?phone=971566121423";

// ---------------------------------------------------------------------------
// SVG Icons
// ---------------------------------------------------------------------------
const icons: Record<string, string> = {
    phone: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5.5 3.5h3l1.5 4-2 1.5a12 12 0 0 0 6.5 6.5l1.5-2 4 1.5v3a1.5 1.5 0 0 1-1.6 1.5A17 17 0 0 1 4 5.1a1.5 1.5 0 0 1 1.5-1.6Z"/></svg>`,
    chat: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12a8 8 0 1 1 3.3 6.4L4 20l1.4-3.6A7.9 7.9 0 0 1 4 12Z"/><path d="M9 11.5c.3 2 2 3.7 4 4"/></svg>`,
    chevronDown: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>`,
    search: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>`,
    mapPin: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21.5s7-6.6 7-12A7 7 0 0 0 5 9.5c0 5.4 7 12 7 12Z"/><circle cx="12" cy="9.5" r="2.4"/></svg>`,
    clock: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg>`,
    tools: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`,
    wrench: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2a5 5 0 0 0-4.5 7.2L3 15.7a2.1 2.1 0 0 0 3 3l6.5-6.5A5 5 0 0 0 20 7.7V4l-3.5 1.5L14 2Z"/></svg>`,
    award: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>`,
    shield: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/></svg>`,
    car: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9C2.1 11.2 2 11.6 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/></svg>`,
    bolt: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`,
    battery: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="16" height="10" rx="2"/><line x1="22" y1="11" x2="22" y2="13"/></svg>`,
    snowflake: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="2" x2="12" y2="22"/><line x1="20" y1="12" x2="4" y2="12"/><line x1="17.6" y1="6.4" x2="6.4" y2="17.6"/><line x1="17.6" y1="17.6" x2="6.4" y2="6.4"/></svg>`,
    disc: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/></svg>`,
    oilCan: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14v4a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2Z"/><path d="M5 10l3-5h8l3 5"/><line x1="12" y1="2" x2="12" y2="5"/></svg>`,
    check: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`,
    arrowRight: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>`
};

// ---------------------------------------------------------------------------
// Structured Schema Markup (Physical Auto Garage in Al Satwa + FAQPage)
// ---------------------------------------------------------------------------
const pageSchema = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": ["AutoRepair", "LocalBusiness"],
            "@id": "https://dubaicarrepairservice.com/car-repair-al-satwa#localbusiness",
            "name": "Dubai Car Repair Service - Al Satwa Workshop",
            "url": "https://dubaicarrepairservice.com/car-repair-al-satwa",
            "telephone": "+971566121423",
            "image": "https://dubaicarrepairservice.com/img/logo.webp",
            "priceRange": "AED 80 - AED 2,500",
            "currenciesAccepted": "AED",
            "paymentAccepted": ["Cash", "Credit Card", "Debit Card"],
            "address": {
                "@type": "PostalAddress",
                "streetAddress": "222 Al Satwa Rd - Al Satwa",
                "addressLocality": "Dubai",
                "addressRegion": "Dubai",
                "postalCode": "00000",
                "addressCountry": "AE"
            },
            "geo": {
                "@type": "GeoCoordinates",
                "latitude": 25.23121,
                "longitude": 55.27718
            },
            "openingHoursSpecification": [{
                "@type": "OpeningHoursSpecification",
                "dayOfWeek": ["Saturday", "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
                "opens": "07:00",
                "closes": "22:00"
            }],
            "areaServed": [
                { "@type": "AdministrativeArea", "name": "Al Satwa" },
                { "@type": "AdministrativeArea", "name": "Jumeirah" },
                { "@type": "AdministrativeArea", "name": "Al Wasl" },
                { "@type": "AdministrativeArea", "name": "Al Bada'a" },
                { "@type": "AdministrativeArea", "name": "Trade Centre" },
                { "@type": "AdministrativeArea", "name": "Downtown Dubai" },
                { "@type": "City", "name": "Dubai" }
            ],
            "description": "Professional car repair workshop located at 222 Al Satwa Road, Dubai. Drive-in auto garage offering computer diagnostics, car AC servicing, battery testing, tyres, and mobile mechanic call-out assistance across central Dubai."
        },
        {
            "@type": "BreadcrumbList",
            "@id": "https://dubaicarrepairservice.com/car-repair-al-satwa#breadcrumb",
            "itemListElement": [
                {
                    "@type": "ListItem",
                    "position": 1,
                    "name": "Home",
                    "item": "https://dubaicarrepairservice.com/"
                },
                {
                    "@type": "ListItem",
                    "position": 2,
                    "name": "Locations",
                    "item": "https://dubaicarrepairservice.com/#service"
                },
                {
                    "@type": "ListItem",
                    "position": 3,
                    "name": "Car Repair Al Satwa",
                    "item": "https://dubaicarrepairservice.com/car-repair-al-satwa"
                }
            ]
        },
        {
            "@type": "FAQPage",
            "@id": "https://dubaicarrepairservice.com/car-repair-al-satwa#faq",
            "mainEntity": [
                {
                    "@type": "Question",
                    "name": "Where exactly is your car repair garage located in Al Satwa?",
                    "acceptedAnswer": {
                        "@type": "Answer",
                        "text": "Our physical auto workshop is located at 222 Al Satwa Rd, Al Satwa, Dubai. We are conveniently situated near 2nd December Street (Al Diyafah), Satwa Roundabout, and the Iranian Hospital, providing easy drive-in access from Sheikh Zayed Road, Jumeirah 1, Al Bada'a, and Downtown Dubai."
                    }
                },
                {
                    "@type": "Question",
                    "name": "Do I need an appointment or can I drive straight into your Al Satwa workshop?",
                    "acceptedAnswer": {
                        "@type": "Answer",
                        "text": "Drive-ins and walk-ins are welcome daily from 7:00 AM to 10:00 PM. Whether you are dealing with a warning light, unusual engine sound, or an air conditioner blowing warm air, you can drive directly to our workshop bays. Calling ahead is recommended during peak hours if you wish to confirm lift bay availability."
                    }
                },
                {
                    "@type": "Question",
                    "name": "Can a mechanic come to my location in Al Satwa if my car won't start?",
                    "acceptedAnswer": {
                        "@type": "Answer",
                        "text": "Yes. For vehicles that cannot be driven safely, our mechanics provide mobile call-out assistance in Al Satwa and nearby central Dubai areas. We can perform on-site jump starts, battery testing and replacement, puncture repairs, and basic diagnostic checks. Problems requiring major mechanical work or lifting equipment will need workshop attention at our Al Satwa facility."
                    }
                },
                {
                    "@type": "Question",
                    "name": "How do your repair prices compare to Dubai dealership service centers?",
                    "acceptedAnswer": {
                        "@type": "Answer",
                        "text": "As an independent garage, our labor and repair rates are generally more economical than franchised dealership service centers. We provide transparent, itemized written estimates with clear parts options before any work commences, helping you make informed decisions without unexpected costs."
                    }
                },
                {
                    "@type": "Question",
                    "name": "What car brands do your mechanics in Al Satwa specialize in?",
                    "acceptedAnswer": {
                        "@type": "Answer",
                        "text": "Our experienced mechanics service a broad spectrum of passenger cars, SUVs, and commercial vehicles commonly driven in Dubai, including Japanese (Toyota, Nissan, Lexus, Honda, Mitsubishi), European (Mercedes-Benz, BMW, Audi, Volkswagen, Porsche, Land Rover), American (Ford, Chevrolet, GMC, Jeep), and Korean (Hyundai, Kia) brands."
                    }
                }
            ]
        }
    ]
};

// ---------------------------------------------------------------------------
// Al Satwa Workshop & Mobile Services Data
// ---------------------------------------------------------------------------
const satwaServices = [
    {
        icon: "snowflake",
        title: "Car AC Repair in Al Satwa",
        badge: "Diagnostics & Refill",
        desc: "Automotive AC diagnostics, leak testing, compressor checks, and precision refrigerant recharging (R134a and R1234yf) in our dedicated workshop bays.",
        link: "/car-ac-repair-dubai"
    },
    {
        icon: "disc",
        title: "Tyre Services in Al Satwa",
        badge: "Fitting & Balancing",
        desc: "Tyre mounting, electronic wheel balancing, wheel alignment, puncture repairs, and new tyre supply right inside our Al Satwa workshop.",
        link: "/tyre-replacement-dubai"
    },
    {
        icon: "battery",
        title: "Car Battery Replacement in Al Satwa",
        badge: "Workshop & Mobile",
        desc: "Digital battery load and charging system testing, terminal cleaning, and fitting of reputable battery brands (such as Bosch, Varta, and Amaron) with manufacturer warranty.",
        link: "/car-battery-replacement-dubai"
    },
    {
        icon: "wrench",
        title: "Local Mechanic Call-Out",
        badge: "On-Site Support",
        desc: "Unable to drive to 222 Al Satwa Road? Our mobile mechanic van assists with battery testing, jump starts, puncture repairs, and diagnostics at your location.",
        link: "/mobile-car-repair-dubai"
    }
];

// ---------------------------------------------------------------------------
// Pricing Data
// ---------------------------------------------------------------------------
const priceList = [
    { service: "Computerized OBD-II Diagnostic Scan", price: "AED 80 – 150", time: "20–30 mins" },
    { service: "Car AC Gas Top-Up & Cooling Leak Test", price: "AED 130 – 350", time: "30–45 mins" },
    { service: "Car Battery Replacement (Inc. Workshop Fitting)", price: "AED 180 – 680", time: "20–30 mins" },
    { service: "Tyre Fitting & Wheel Balancing (Per Pair)", price: "AED 120 – 250", time: "30–45 mins" },
    { service: "Full Synthetic Engine Oil & Filter Change", price: "AED 150 – 380", time: "30–45 mins" },
    { service: "Brake Pad Replacement (Front or Rear Axle)", price: "AED 180 – 450", time: "45–60 mins" },
    { service: "Local Mechanic Call-Out (Satwa & Nearby)", price: "AED 120 – 180", time: "Subject to location" }
