// ---------------------------------------------------------------------------
// Why Choose Us
// ---------------------------------------------------------------------------
const reasons = [
    {
        title: "Permanent Workshop at 222 Al Satwa Rd",
        desc: "Our workshop is permanently based at 222 Al Satwa Road with dedicated hydraulic lift bays, diagnostic tools, and in-house mechanics ready to inspect your car."
    },
    {
        title: "12+ Years Serving Central Dubai",
        desc: "Established in 2012, our eight experienced mechanics have serviced more than 8,500 vehicles across Al Satwa, Jumeirah, and surrounding neighborhoods with a 4.8-star Google rating."
    },
    {
        title: "Drive-In Bays & Mobile Call-Outs",
        desc: "Drive straight into our service bays on Al Satwa Road, or request local mobile mechanic assistance for battery, starting, or puncture issues at your parking location."
    },
    {
        title: "Transparent, Upfront Estimates",
        desc: "We inspect your vehicle first and provide an itemized written quotation detailing parts and labor before commencing any repair work, so you stay fully informed."
    }
];

// ---------------------------------------------------------------------------
// FAQs
// ---------------------------------------------------------------------------
const faqs = [
    {
        q: "Where exactly is your car repair garage located in Al Satwa?",
        a: "Our physical auto workshop is located at 222 Al Satwa Rd, Al Satwa, Dubai. We are conveniently situated near 2nd December Street (Al Diyafah), Satwa Roundabout, and the Iranian Hospital, providing easy drive-in access from Sheikh Zayed Road, Jumeirah 1, Al Bada'a, and Downtown Dubai."
    },
    {
        q: "Do I need an appointment or can I drive straight into your Al Satwa workshop?",
        a: "Drive-ins and walk-ins are welcome daily from 7:00 AM to 10:00 PM. Whether you are dealing with a warning light, unusual engine sound, or an air conditioner blowing warm air, you can drive directly to our workshop bays. Calling ahead is recommended during peak hours if you wish to confirm lift bay availability."
    },
    {
        q: "Can a mechanic come to my location in Al Satwa if my car won't start?",
        a: "Yes. For vehicles that cannot be driven safely, our mechanics provide mobile call-out assistance in Al Satwa and nearby central Dubai areas. We can perform on-site jump starts, battery testing and replacement, puncture repairs, and basic diagnostic checks. Problems requiring major mechanical work or lifting equipment will need workshop attention at our Al Satwa facility."
    },
    {
        q: "How do your repair prices compare to Dubai dealership service centers?",
        a: "As an independent garage, our labor and repair rates are generally more economical than franchised dealership service centers. We provide transparent, itemized written estimates with clear parts options before any work commences, helping you make informed decisions without unexpected costs."
    },
    {
        q: "What car brands do your mechanics in Al Satwa specialize in?",
        a: "Our experienced mechanics service a broad spectrum of passenger cars, SUVs, and commercial vehicles commonly driven in Dubai, including Japanese (Toyota, Nissan, Lexus, Honda, Mitsubishi), European (Mercedes-Benz, BMW, Audi, Volkswagen, Porsche, Land Rover), American (Ford, Chevrolet, GMC, Jeep), and Korean (Hyundai, Kia) brands."
