---

<BaseLayout
    title={pageTitle}
    description={pageDescription}
>
    <!-- Structured JSON-LD Schema Graph -->
    <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

    <main class="dcrs-location-page">

        <!-- 1. HERO BANNER --------------------------------------------------->
        <header class="dcrs-hero-banner">
            <div class="dcrs-hero-banner__scrim"></div>
            <div class="dcrs-container dcrs-hero-banner__inner">
                <nav class="dcrs-breadcrumb" aria-label="Breadcrumb">
                    <ol>
                        <li><a href="/">Home</a></li>
                        <li><a href="/#service">Locations</a></li>
                        <li aria-current="page">Car Repair Sheikh Zayed Road</li>
                    </ol>
                </nav>
                <span class="dcrs-badge">Rapid Highway Response · Sheikh Zayed Road Corridor · 24/7 Mobile Dispatch</span>
                <h1 class="dcrs-hero-banner__title">
                    Car Repair Sheikh Zayed Road - Fast Emergency Breakdown &amp; Mobile Mechanic
                </h1>
                <p class="dcrs-hero-banner__lead">
                    Encountered a sudden breakdown, blown tyre, dead battery, or engine fault on the E11 highway? Our certified mobile mechanics reach your location along Sheikh Zayed Road within 15 to 20 minutes for complete on-site automotive repairs.
