---
import BaseLayout from '../../layouts/BaseLayout.astro';
import diagnosticImage from '../../assets/images/loc2.webp';

// ---------------------------------------------------------------------------
// Page Metadata & Settings (Strict SEO Requirements)
// Title <= 60 chars | Description <= 155 chars | Primary: "car repair sheikh zayed road"
// ---------------------------------------------------------------------------
const pageTitle = "Car Repair Sheikh Zayed Road | Mobile Mechanic Dubai";
const pageDescription = "Need car repair on Sheikh Zayed Road? Our mobile mechanics provide on-site diagnostics, battery jump & tyre help across SZR. Workshop in Al Satwa. Call now!";

const phoneDisplay = "+971 56 612 1423";
const phoneHref = "tel:+971566121423";
const waHref = "https://api.whatsapp.com/send?phone=971566121423";

// ---------------------------------------------------------------------------
// SVG Icons
// ---------------------------------------------------------------------------
const icons: Record<string, string> = {
    phone: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5.5 3.5h3l1.5 4-2 1.5a12 12 0 0 0 6.5 6.5l1.5-2 4 1.5v3a1.5 1.5 0 0 1-1.6 1.5A17 17 0 0 1 4 5.1a1.5 1.5 0 0 1 1.5-1.6Z"/></svg>`,
    chat: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12a8 8 0 1 1 3.3 6.4L4 20l1.4-3.6A7.9 7.9 0 0 1 4 12Z"/><path d="M9 11.5c.3 2 2 3.7 4 4"/></svg>`,
    chevronDown: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>`,
    search: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>`,
    mapPin: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21.5s7-6.6 7-12A7 7 0 0 0 5 9.5c0 5.4 7 12 7 12Z"/><circle cx="12" cy="9.5" r="2.4"/></svg>`,
    clock: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg>`,
    tools: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`,
    wrench: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2a5 5 0 0 0-4.5 7.2L3 15.7a2.1 2.1 0 0 0 3 3l6.5-6.5A5 5 0 0 0 20 7.7V4l-3.5 1.5L14 2Z"/></svg>`,
    award: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>`,
    shield: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/></svg>`,
    car: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9C2.1 11.2 2 11.6 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/></svg>`,
    bolt: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`,
    battery: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="16" height="10" rx="2"/><line x1="22" y1="11" x2="22" y2="13"/></svg>`,
    snowflake: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="2" x2="12" y2="22"/><line x1="20" y1="12" x2="4" y2="12"/><line x1="17.6" y1="6.4" x2="6.4" y2="17.6"/><line x1="17.6" y1="17.6" x2="6.4" y2="6.4"/></svg>`,
    disc: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/></svg>`,
    oilCan: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14v4a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2Z"/><path d="M5 10l3-5h8l3 5"/><line x1="12" y1="2" x2="12" y2="5"/></svg>`,
    check: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`,
    arrowRight: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>`
};

// ---------------------------------------------------------------------------
// FAQs (Defined early for 1:1 Schema alignment)
// ---------------------------------------------------------------------------
const faqs = [
    {
        q: "What should I do if my car breaks down while driving on Sheikh Zayed Road?",
        a: "Safely guide your vehicle into the nearest emergency shoulder, exit slipway, or service station forecourt if possible. Turn on your hazard lights, place a warning triangle behind the vehicle if it is safe to do so, and wait in a safe area behind highway barriers. Then call +971 56 612 1423 or WhatsApp our team with your location. We will confirm mobile mechanic availability and dispatch assistance."
    },
    {
        q: "Can your mobile mechanic assist in office basement parking along SZR?",
        a: "Yes. Our mobile technicians regularly assist drivers in multi-level underground parking and hotel decks across DIFC, Downtown, Business Bay, and Sheikh Zayed Road office towers. We use portable diagnostic scanners, compact battery boosters, and hand tools designed to operate in low-clearance garages."
    },
    {
        q: "What types of on-site car breakdowns can you repair along SZR?",
        a: "We handle flat batteries, emergency jump starts, alternator and starter issues, flat tyres, wheel changes, emergency coolant hose and belt repairs, AC gas top-ups, and computer diagnostic scans on-site. If an issue requires heavy dismantling or specialized workshop machinery, we advise you honestly and can coordinate repair at our Al Satwa workshop."
    },
    {
        q: "How fast can emergency roadside assistance reach me on SZR?",
        a: "We prioritize roadside emergencies along the Sheikh Zayed Road corridor. Typical arrival times range from 20 to 35 minutes depending on traffic density, your exact highway exit or parking location, and technician availability. Our dispatcher provides an estimated arrival time when you call."
    },
    {
        q: "What are your mobile repair charges for Sheikh Zayed Road call-outs?",
        a: "On-site diagnostic checks and battery jump starts start from AED 120. Battery replacements with warranty range from AED 250 to AED 680 depending on vehicle specifications, and flat tyre services begin from AED 120. All charges and parts costs are quoted transparently before work begins."
    }
];

// ---------------------------------------------------------------------------
// Structured Schema Markup (LocalBusiness with Service Area - Aligned with Al Satwa Base)
// ---------------------------------------------------------------------------
const pageSchema = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": ["AutoRepair", "LocalBusiness"],
            "@id": "https://dubaicarrepairservice.com/car-repair-sheikh-zayed-road#localbusiness",
            "name": "Dubai Car Repair Service - Sheikh Zayed Road Mobile Mechanic",
            "url": "https://dubaicarrepairservice.com/car-repair-sheikh-zayed-road",
            "telephone": "+971566121423",
            "image": "https://dubaicarrepairservice.com/img/logo.webp",
            "priceRange": "AED 120 - AED 1,200",
            "currenciesAccepted": "AED",
            "paymentAccepted": ["Cash", "Credit Card", "Debit Card"],
            "openingHoursSpecification": [{
                "@type": "OpeningHoursSpecification",
                "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
                "opens": "07:00",
                "closes": "22:00"
            }],
            "areaServed": [
                { "@type": "AdministrativeArea", "name": "Sheikh Zayed Road" },
                { "@type": "AdministrativeArea", "name": "DIFC" },
                { "@type": "AdministrativeArea", "name": "Trade Centre" },
                { "@type": "AdministrativeArea", "name": "Business Bay" },
                { "@type": "AdministrativeArea", "name": "Downtown Dubai" },
                { "@type": "AdministrativeArea", "name": "Al Quoz" },
                { "@type": "AdministrativeArea", "name": "Dubai Marina" },
                { "@type": "AdministrativeArea", "name": "JLT" },
                { "@type": "City", "name": "Dubai" }
            ],
            "description": "Professional mobile car repair and roadside assistance along Sheikh Zayed Road (SZR), Dubai. On-site vehicle diagnostics, battery replacement, tyre changes, and breakdown support, backed by our Al Satwa workshop."
        },
        {
            "@type": "BreadcrumbList",
            "@id": "https://dubaicarrepairservice.com/car-repair-sheikh-zayed-road#breadcrumb",
            "itemListElement": [
                {
                    "@type": "ListItem",
                    "position": 1,
                    "name": "Home",
                    "item": "https://dubaicarrepairservice.com/"
                },
                {
                    "@type": "ListItem",
                    "position": 2,
                    "name": "Locations",
                    "item": "https://dubaicarrepairservice.com/#service"
                },
                {
                    "@type": "ListItem",
                    "position": 3,
                    "name": "Car Repair Sheikh Zayed Road",
                    "item": "https://dubaicarrepairservice.com/car-repair-sheikh-zayed-road"
                }
            ]
        },
        {
            "@type": "FAQPage",
            "@id": "https://dubaicarrepairservice.com/car-repair-sheikh-zayed-road#faq",
            "mainEntity": faqs.map((faq) => ({
                "@type": "Question",
                "name": faq.q,
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": faq.a
                }
            }))
        }
    ]
};

// ---------------------------------------------------------------------------
// Sheikh Zayed Road High-Demand Mobile Services Data
// ---------------------------------------------------------------------------
const szrServices = [
    {
        icon: "tools",
        title: "Emergency Roadside Assistance",
        badge: "Roadside Support",
        desc: "Immediate support for unexpected highway breakdowns, engine overheating, sudden stalls, and safety hazards along the SZR corridor.",
        link: "/roadside-assistance-dubai"
    },
    {
        icon: "car",
        title: "Mobile Mechanic SZR",
        badge: "On-Site Assistance",
        desc: "Mechanics attend your office parking, residential tower, or accessible roadside spot with OBD-II diagnostic tools and parts to assess and resolve issues.",
        link: "/mobile-car-repair-dubai"
    },
    {
        icon: "battery",
        title: "Battery Jump & Replacement",
        badge: "Testing & Fitment",
        desc: "Emergency 12V battery jump starts, digital charging-system tests, and on-site delivery and installation of genuine warranty-backed batteries.",
        link: "/car-battery-replacement-dubai"
    },
    {
        icon: "disc",
        title: "Emergency Tyre Replacement",
        badge: "Puncture & Fitment",
        desc: "Rapid assistance for punctures, flat tyres, wheel changes using your spare, and replacement tyre fitting at safe roadside or parking locations.",
        link: "/tyre-replacement-dubai"
    }
];

// ---------------------------------------------------------------------------
// Pricing Data
// ---------------------------------------------------------------------------
const priceList = [
    { service: "Emergency Roadside Diagnostic Check", price: "AED 120 – 180", time: "Approx. 20–30 mins" },
    { service: "Car Battery Replacement (Delivered & Installed)", price: "AED 250 – 680", time: "Approx. 20–35 mins" },
    { service: "Mobile Flat Tyre Replacement / Wheel Swap", price: "AED 120 – 250", time: "Approx. 20–35 mins" },
    { service: "Emergency Battery Boost & Alternator Test", price: "AED 120 – 150", time: "Approx. 15–25 mins" },
    { service: "Engine Cooling System Emergency Check", price: "AED 150 – 350", time: "Approx. 30–45 mins" },
    { service: "Mobile AC Leak Check & Fast Gas Refill", price: "AED 150 – 350", time: "Approx. 30–45 mins" },
    { service: "Emergency Belt & Hose Roadside Fix", price: "AED 180 – 420", time: "Approx. 30–50 mins" }
];

// ---------------------------------------------------------------------------
// Why SZR Commuters Choose Us Data
// ---------------------------------------------------------------------------
const reasons = [
    {
        title: "Fast Mobile Response",
        desc: "Mobile response units deployed near central SZR interchanges enable prompt dispatch to highway exits, service roads, and commercial clusters."
    },
    {
        title: "On-Site Repairs When Feasible",
        desc: "Avoid inconvenient towing delays and costs. We inspect and repair starting, electrical, battery, and tyre issues directly where your vehicle is parked."
    },
    {
        title: "Office Basement & Tower Access",
        desc: "Our mobile mechanics carry portable diagnostic tools, compact battery testers, and low-clearance equipment designed for multi-level underground parking."
    },
    {
        title: "Transparent Upfront Pricing",
        desc: "Clear itemized rates with zero surprise fees. You receive a verified quote before work begins, with genuine parts and workshop backup at our nearby Al Satwa facility."
    }
];

const relatedServices = [
    { icon: "tools", name: "Roadside Assistance Dubai", desc: "Emergency breakdown & towing support across Dubai", href: "/roadside-assistance-dubai" },
    { icon: "car", name: "Mobile Car Repair Dubai", desc: "On-site mechanical diagnostics & doorstep repairs", href: "/mobile-car-repair-dubai" },
    { icon: "battery", name: "Car Battery Replacement Dubai", desc: "Delivered & installed on-site with warranty", href: "/car-battery-replacement-dubai" },
    { icon: "disc", name: "Tyre Replacement Dubai", desc: "Mobile puncture repair, wheel swaps & tyre fitting", href: "/tyre-replacement-dubai" }
];
---

<BaseLayout
    title={pageTitle}
    description={pageDescription}
>
    <!-- Structured JSON-LD Schema Graph -->
    <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

    <main class="dcrs-location-page">

        <!-- 1. HERO BANNER --------------------------------------------------->
        <header class="dcrs-hero-banner">
            <div class="dcrs-hero-banner__scrim"></div>
            <div class="dcrs-container dcrs-hero-banner__inner">
                <nav class="dcrs-breadcrumb" aria-label="Breadcrumb">
                    <ol>
                        <li><a href="/">Home</a></li>
                        <li><a href="/#service">Locations</a></li>
                        <li aria-current="page">Car Repair Sheikh Zayed Road</li>
                    </ol>
                </nav>
                <span class="dcrs-badge">Rapid Mobile Dispatch · Sheikh Zayed Road Corridor · On-Site Repairs &amp; Al Satwa Workshop</span>
                <h1 class="dcrs-hero-banner__title">
                    Car Repair Sheikh Zayed Road – Mobile Mechanic &amp; Roadside Assistance
                </h1>
                <p class="dcrs-hero-banner__lead">
                    Need a mobile mechanic on Sheikh Zayed Road? Dubai Car Repair Service provides professional on-site car repair and roadside assistance for drivers across Dubai. Whether you're dealing with a dead battery, flat tyre, engine warning light, starting problem or unexpected breakdown, our mobile mechanics can come to your location to assess the issue and carry out supported repairs. We also operate a fully equipped workshop in Al Satwa for more extensive mechanical work. Contact us for fast and affordable mobile car repair in Dubai.
                </p>
                <div class="dcrs-hero-banner__actions">
                    <a href={phoneHref} class="dcrs-btn dcrs-btn--solid">
                        <Fragment set:html={icons.phone} /> Call {phoneDisplay}
                    </a>
                    <a href={waHref} target="_blank" rel="noopener noreferrer" class="dcrs-btn dcrs-btn--wa">
                        <Fragment set:html={icons.chat} /> WhatsApp Us
                    </a>
                </div>
            </div>
        </header>

        <!-- 2. TRUST / HIGHLIGHT STRIP --------------------------------------->
        <section class="dcrs-strip" aria-label="Highway Highlights">
            <div class="dcrs-container">
                <div class="dcrs-strip__grid">
                    <div class="dcrs-strip__item">
                        <span class="dcrs-strip__icon"><Fragment set:html={icons.clock} /></span>
                        <div>
                            <strong>Fast Mobile Response</strong>
                            <span>SZR Highway &amp; Towers</span>
                        </div>
                    </div>
                    <div class="dcrs-strip__item">
                        <span class="dcrs-strip__icon"><Fragment set:html={icons.car} /></span>
                        <div>
                            <strong>Mobile Car Repair</strong>
                            <span>Battery, Tyre &amp; Mechanical</span>
                        </div>
                    </div>
                    <div class="dcrs-strip__item">
                        <span class="dcrs-strip__icon"><Fragment set:html={icons.shield} /></span>
                        <div>
                            <strong>Upfront Quotations</strong>
                            <span>Transparent AED Rates</span>
                        </div>
                    </div>
                    <div class="dcrs-strip__item">
                        <span class="dcrs-strip__icon"><Fragment set:html={icons.wrench} /></span>
                        <div>
                            <strong>Workshop in Al Satwa</strong>
                            <span>222 Al Satwa Road Base</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 3. INTRO SECTION ------------------------------------------------->
        <section class="dcrs-section dcrs-section--paper" id="szr-overview">
            <div class="dcrs-container">
                <div class="dcrs-grid-2col dcrs-grid-2col--align-center">
                    
                    <div class="dcrs-intro-content">
                        <div class="dcrs-kicker">On-Site Automotive Assistance</div>
                        <h2 class="dcrs-heading__title">
                            Professional Mobile Mechanic &amp; On-Site Car Repair on Sheikh Zayed Road
                        </h2>
                        <p class="dcrs-lead-text">
                            Sheikh Zayed Road is Dubai's busiest transit corridor, connecting major commercial and residential districts. When your vehicle suffers a sudden breakdown, puncture, starting fault, or warning alert, waiting for a tow truck or searching for a distant garage causes unwanted delays and stress.
                        </p>
                        <p class="dcrs-body-text">
                            At <a href="/" class="dcrs-inline-link">Dubai Car Repair Service</a>, our core focus along Sheikh Zayed Road is providing reliable <a href="/mobile-car-repair-dubai" class="dcrs-inline-link">mobile car repair</a> and <a href="/roadside-assistance-dubai" class="dcrs-inline-link">emergency roadside assistance</a> directly at your location. Whether you are parked in an office basement tower in DIFC or Business Bay, stopped at a residential parking bay in Downtown, or safely positioned on an accessible service road, our mobile mechanics travel to you equipped with computerized diagnostic tools, jump-start packs, battery testers, and emergency repair equipment.
                        </p>
                        <p class="dcrs-body-text">
                            Many common roadside problems—such as dead batteries, flat tyres, faulty starter relays, split radiator hoses, or minor electrical errors—can be diagnosed and repaired on the spot. For vehicles experiencing complex engine failures, transmission problems, or requiring hydraulic hoist access, our physical <a href="/car-engine-service-dubai" class="dcrs-inline-link">auto repair workshop</a> at <a href="/car-repair-al-satwa" class="dcrs-inline-link">222 Al Satwa Road</a> provides full workshop servicing with comprehensive mechanical capabilities.
                        </p>

                        <div class="dcrs-features-inline">
                            <div class="dcrs-feature-check">
                                <span class="dcrs-check-icon"><Fragment set:html={icons.check} /></span>
                                <span>Mobile mechanic assistance at office towers, residential parking, and accessible roadside areas</span>
                            </div>
                            <div class="dcrs-feature-check">
                                <span class="dcrs-check-icon"><Fragment set:html={icons.check} /></span>
                                <span>On-the-spot support for dead batteries, punctures, starting troubles, and coolant hose issues</span>
                            </div>
                            <div class="dcrs-feature-check">
                                <span class="dcrs-check-icon"><Fragment set:html={icons.check} /></span>
                                <span>Clear upfront quotes with genuine parts and workshop backup at our nearby Al Satwa facility</span>
                            </div>
                        </div>

                        <div class="dcrs-action-row">
                            <a href={phoneHref} class="dcrs-btn dcrs-btn--solid">
                                <Fragment set:html={icons.phone} /> Call Dispatch
                            </a>
                            <a href={waHref} target="_blank" rel="noopener noreferrer" class="dcrs-btn dcrs-btn--outline-ink">
                                WhatsApp Location <Fragment set:html={icons.arrowRight} />
                            </a>
                        </div>
                    </div>

                    <div class="dcrs-intro-media">
                        <div class="dcrs-intro-media__frame">
                            <img
                                src={diagnosticImage.src}
                                alt="Mobile mechanic providing on-site car repair and roadside assistance along Sheikh Zayed Road"
                                loading="eager"
                                width="600"
                                height="420"
                            />
                            <div class="dcrs-plate dcrs-price-badge" aria-hidden="true">
                                <div class="dcrs-plate__tab">SZR ROAD</div>
                                <div class="dcrs-plate__body">
                                    <span class="dcrs-plate__row dcrs-plate__row--big">MOBILE</span>
                                    <span class="dcrs-plate__row">MECHANIC DISPATCH</span>
                                    <span class="dcrs-plate__row">ON-SITE REPAIRS</span>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- 4. CORE SERVICES GRID (BREAKDOWNS, ROADSIDE & MOBILE) -------------->
        <section class="dcrs-section dcrs-section--white" id="szr-services">
            <div class="dcrs-container">
                <div class="dcrs-heading dcrs-heading--center">
                    <span class="dcrs-kicker">Emergency Highway Capabilities</span>
                    <h2 class="dcrs-heading__title">
                        Complete Mobile Assistance Along the SZR Corridor
                    </h2>
                    <p class="dcrs-heading__desc">
                        From sudden electrical blackouts to highway tyre punctures, our mobile mechanics deliver prompt, dependable on-site solutions. For complex jobs requiring specialized workshop machinery, our Al Satwa workshop provides complete backup.
                    </p>
                </div>

                <div class="dcrs-services-grid">
                    {szrServices.map((item) => (
                        <div class="dcrs-service-card">
                            <div class="dcrs-service-card__head">
                                <span class="dcrs-service-card__icon">
                                    <Fragment set:html={icons[item.icon] || icons.tools} />
                                </span>
                                <span class="dcrs-service-card__badge">{item.badge}</span>
                            </div>
                            <h3 class="dcrs-service-card__title">{item.title}</h3>
                            <p class="dcrs-service-card__desc">{item.desc}</p>
                            <a href={item.link} class="dcrs-service-card__link">
                                Explore Service <Fragment set:html={icons.arrowRight} />
                            </a>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- 5. DETAILED COMMUTER BREAKDOWN FOCUS ------------------------------>
        <section class="dcrs-section dcrs-section--paper" id="deep-dive">
            <div class="dcrs-container">
                <div class="dcrs-heading">
                    <span class="dcrs-kicker">Breakdown Solutions</span>
                    <h2 class="dcrs-heading__title">
                        Practical Solutions for Sheikh Zayed Road Breakdowns
                    </h2>
                    <p class="dcrs-heading__desc">
                        Highway traffic and Dubai's elevated temperatures place regular demands on vehicle cooling, electrical, and tyre systems. Here is how our mobile mechanics help drivers resolve common roadside issues:
                    </p>
                </div>

                <div class="dcrs-grid-2col">
                    <div>
                        <h3 class="dcrs-heading__title" style="font-size: 1.45rem;">
                            Car Breakdown Sheikh Zayed Road
                        </h3>
                        <p class="dcrs-body-text">
                            Experiencing an unexpected vehicle breakdown along Sheikh Zayed Road is stressful. If your vehicle suddenly stalls, enters limp mode, or triggers an urgent dashboard warning, our mobile technicians travel to your location to carry out an immediate diagnostic assessment. Using handheld OBD-II scanners, we can read sensor codes, isolate electrical faults, and identify fuel or ignition issues. Supported mechanical faults can be repaired on-site, with full <a href="/roadside-assistance-dubai" class="dcrs-inline-link">roadside assistance in Dubai</a> available when immediate intervention is needed.
                        </p>
                        
                        <h3 class="dcrs-heading__title" style="font-size: 1.45rem; margin-top: 1.75rem;">
                            Roadside Assistance Sheikh Zayed Road – Battery &amp; Alternator
                        </h3>
                        <p class="dcrs-body-text">
