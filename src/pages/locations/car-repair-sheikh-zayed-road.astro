                        </div>
                    </div>
                    <div class="dcrs-strip__item">
                        <span class="dcrs-strip__icon"><Fragment set:html={icons.shield} /></span>
                        <div>
                            <strong>Transparent AED Rates</strong>
                            <span>Upfront Quotes</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 3. INTRO SECTION ------------------------------------------------->
