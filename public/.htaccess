# ----------------------------------------------------------------------
# Dubai Car Repair Service - Apache / LiteSpeed Production Server Config
# ----------------------------------------------------------------------

RewriteEngine On

# 1. Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Force non-WWW
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# 3. 301 Redirect old Laravel URLs to canonical root URLs
Redirect 301 /car-repair-dubai /
Redirect 301 /service/car-ac-repair-dubai /car-ac-repair-dubai
Redirect 301 /service/car-battery-replacement-dubai /car-battery-replacement-dubai
Redirect 301 /service/car-engine-service-dubai /car-engine-service-dubai
Redirect 301 /service/car-inspection-dubai /car-inspection-dubai
Redirect 301 /service/car-maintenance-dubai /car-maintenance-dubai
Redirect 301 /service/engine-oil-change-dubai /engine-oil-change-dubai
Redirect 301 /service/mobile-car-repair-dubai /mobile-car-repair-dubai
Redirect 301 /service/roadside-assistance-dubai /roadside-assistance-dubai
Redirect 301 /service/tyre-replacement-dubai /tyre-replacement-dubai
Redirect 301 /locations/car-repair-al-satwa /car-repair-al-satwa
Redirect 301 /locations/car-repair-sheikh-zayed-road /car-repair-sheikh-zayed-road
Redirect 301 /resources /resource

# 4. Remove trailing slashes from all URLs (e.g. /about/ -> /about)
RewriteCond %{REQUEST_URI} ^(.+)/$
RewriteRule ^(.+)/$ https://%{HTTP_HOST}/$1 [R=301,L]

# 5. Clean URLs: internally serve filename.html without .html in the URL
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.*)$ $1.html [L]

# 6. Custom 404 Error Page
ErrorDocument 404 /404.html

# 7. Default index file
DirectoryIndex index.html
