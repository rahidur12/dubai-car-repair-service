# ----------------------------------------------------------------------
# Dubai Car Repair Service - Apache / LiteSpeed Production Server Config
# ----------------------------------------------------------------------

RewriteEngine On

# 1. Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Force non-WWW
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# 3. 301 Redirect old Laravel URLs to canonical root URLs
Redirect 301 /car-repair-dubai /
Redirect 301 /service/car-ac-repair-dubai /car-ac-repair-dubai
Redirect 301 /service/car-battery-replacement-dubai /car-battery-replacement-dubai
Redirect 301 /service/car-engine-service-dubai /car-engine-service-dubai
Redirect 301 /service/car-inspection-dubai /car-inspection-dubai
Redirect 301 /service/car-maintenance-dubai /car-maintenance-dubai
Redirect 301 /service/engine-oil-change-dubai /engine-oil-change-dubai
Redirect 301 /service/mobile-car-repair-dubai /mobile-car-repair-dubai
Redirect 301 /service/roadside-assistance-dubai /roadside-assistance-dubai
Redirect 301 /service/tyre-replacement-dubai /tyre-replacement-dubai
Redirect 301 /locations/car-repair-al-satwa /car-repair-al-satwa
Redirect 301 /locations/car-repair-sheikh-zayed-road /car-repair-sheikh-zayed-road
Redirect 301 /resources /resource

# 4. Redirect any direct request for /filename.html to clean URL /filename
RewriteCond %{THE_REQUEST} /([^.]+)\.html [NC]
RewriteRule ^ /%1 [NC,L,R=301]

# 5. Remove trailing slashes from URLs (e.g. /about/ -> /about)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^(.+)/+$
RewriteRule ^(.+)/+$ https://%{HTTP_HOST}/$1 [R=301,L]

# 6. Serve clean URLs internally from .html files (e.g. /about -> about.html)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L,QSA]

# 7. Custom 404 Error Page
ErrorDocument 404 /404.html

# 8. Default index file
DirectoryIndex index.html

# 9. Gzip / Deflate Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# 10. Browser Caching (1 Year for static assets)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
</IfModule>

# 11. Cache-Control Headers
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|webp|png|jpg|jpeg|svg|woff2|woff|ico)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>
    <FilesMatch "\.(html)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
